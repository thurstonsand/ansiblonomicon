#!/usr/bin/env python3
"""Drive pod153 from a FileVault pre-boot screen to a logged-in desktop.

Run it under fnox so POD153_LOGIN_PASSWORD is set:
  fnox-host exec --secret POD153_LOGIN_PASSWORD -- pod153-wake {status,wake,login,watch}
"""

import argparse
from datetime import datetime
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time

HOST = "pod153"
USER = "thurstonsand"
PASSWORD = "POD153_LOGIN_PASSWORD"
ASKPASS = "POD153_WAKE_ASKPASS"
PROBE = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", HOST]
CAPTURES = Path.home() / ".local/state/pod153-wake"


class ScreenSharingError(Exception):
    pass


def state() -> str:
    """Return down, unverified, denied, preboot, login-window, or desktop."""
    result = subprocess.run(
        [*PROBE, "stat", "-f", "%Su", "/dev/console"],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        return (
            "desktop" if result.stdout.strip() not in ("", "root") else "login-window"
        )
    # Pre-boot sshd cannot read the data volume: it presents its own host key and
    # offers only password logins, while the booted sshd takes keys alone.
    if "REMOTE HOST IDENTIFICATION HAS CHANGED" in result.stderr:
        return "preboot"
    denied = re.search(r"Permission denied \(([^)]*)\)", result.stderr)
    if denied:
        return (
            "preboot" if re.search(r"password|keyboard", denied.group(1)) else "denied"
        )
    if "Host key verification failed" in result.stderr:
        return "unverified"
    return "down"


def unlock() -> None:
    """Send the FileVault password; pre-boot sshd drops the session once it unlocks."""
    subprocess.run(
        [
            "ssh",
            "-o",
            "PubkeyAuthentication=no",
            "-o",
            "PreferredAuthentications=keyboard-interactive,password",
            "-o",
            "NumberOfPasswordPrompts=1",
            "-o",
            "ConnectTimeout=10",
            "-o",
            "HostKeyAlias=pod153-preboot",
            "-o",
            "StrictHostKeyChecking=accept-new",
            HOST,
            "true",
        ],
        stdin=subprocess.DEVNULL,
        env={
            **os.environ,
            "SSH_ASKPASS": os.path.abspath(__file__),
            "SSH_ASKPASS_REQUIRE": "force",
            ASKPASS: "1",
        },
        check=False,
    )


def login() -> None:
    """Type the password into the login window over Screen Sharing.

    Neither an SSH unlock nor fdesetup authrestart logs anyone in. The captures
    show what the login window looked like before and after; a black one means
    Screen Sharing lacks the grant to see or drive the login window.
    """
    CAPTURES.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
    before = CAPTURES / f"{stamp}-before.png"
    after = CAPTURES / f"{stamp}-after.png"
    password = os.environ[PASSWORD]
    commands = (
        f"key shift pause 2 capture {before} "
        f"type {shlex.quote(password)} key enter pause 5 capture {after}"
    )
    server = f"{HOST}::5900"
    result = subprocess.run(
        [
            "vncdo",
            "--force-caps",
            "-s",
            server,
            "-u",
            USER,
            "-p",
            password,
            "-t",
            "60",
            "-",
        ],
        input=commands,
        text=True,
        check=False,
    )
    # CalledProcessError would print the argv, password included.
    if result.returncode:
        raise ScreenSharingError(f"vncdo exited {result.returncode}")
    log(f"typed the password at the login window; captured {before} and {after}")


def wake(timeout: float) -> str:
    """Unlock and log in at most once each, then wait for the desktop; return the final state."""
    deadline = time.monotonic() + timeout
    unlocked = logged_in = False
    current = state()
    while current != "desktop" and time.monotonic() < deadline:
        if current == "preboot" and not unlocked:
            log("pre-boot reached; sending the FileVault password")
            unlock()
            unlocked = True
        elif current == "login-window" and not logged_in:
            log("login window reached; logging in over Screen Sharing")
            login()
            logged_in = True
        time.sleep(10)
        current = state()
    return current


def log(message: str) -> None:
    print(message, flush=True)


def main() -> None:
    if os.environ.get(ASKPASS):
        print(os.environ[PASSWORD])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status", help="print pod153's state")
    wake_command = commands.add_parser(
        "wake", help="unlock, log in, and wait for the desktop"
    )
    wake_command.add_argument("--timeout", type=float, default=900)
    commands.add_parser("login", help="log in at the login window once")
    commands.add_parser(
        "watch", help="unlock and log in whenever pod153 waits at pre-boot or login"
    )
    args = parser.parse_args()
    if args.command != "status" and not os.environ.get(PASSWORD):
        parser.error(f"{PASSWORD} is required; run under fnox-host exec")

    if args.command == "status":
        log(state())
    elif args.command == "wake":
        final = wake(args.timeout)
        log(final)
        sys.exit(0 if final == "desktop" else 1)
    elif args.command == "login":
        current = state()
        if current != "login-window":
            sys.exit(f"pod153 is {current}, not at the login window")
        final = wake(120)
        log(final)
        sys.exit(0 if final == "desktop" else 1)
    else:
        previous = None
        while True:
            current = state()
            if current != previous:
                log(f"pod153 is {current}")
                previous = current
            if current in ("preboot", "login-window"):
                try:
                    final = wake(900)
                except ScreenSharingError as error:
                    final = f"still at the login window: {error}"
                log(f"pod153 is {final}")
                previous = final
                if final != "desktop":
                    # A wrong password must not turn into a stream of failed attempts.
                    log(
                        "pod153 did not reach the desktop; waiting an hour before retrying"
                    )
                    time.sleep(3600)
            time.sleep(30)


if __name__ == "__main__":
    main()
