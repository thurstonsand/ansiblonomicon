{{- $mode := "dark" -}}
{{- $background := joinPath .chezmoi.homeDir ".terminal-bg" -}}
{{- if stat $background -}}
{{-   $mode = include $background | trim -}}
{{- end -}}
{{- $theme := output "python3" (joinPath .chezmoi.sourceDir "../ansible/roles/terminal_theme/files/hunk_gruvbox_theme.py") $mode -}}
{{ include (joinPath .chezmoi.sourceDir "../ansible/roles/terminal_theme/templates/hunk/config.toml.j2") | replace "{{ terminal_theme_hunk_custom_theme }}" $theme }}
