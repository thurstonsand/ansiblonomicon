{{- if eq .chezmoi.hostname "clawdbot" -}}
[Service]
Environment="PATH={{ .chezmoi.homeDir }}/go/bin:{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/.npm-global/bin:{{ .chezmoi.homeDir }}/.bun/bin:{{ .chezmoi.homeDir }}/.local/share/pnpm:{{ .chezmoi.homeDir }}/clawd/bin:/usr/local/bin:/usr/bin:/bin"
Environment="CLI_PROXY_API_KEY={{ template "llm-api-key" . }}"
Environment="GIPHY_API_KEY={{ template "giphy-api-key" . }}"
Environment="GOG_KEYRING_PASSWORD={{ template "gog-keyring-password" . }}"
Environment="ELEVENLABS_API_KEY={{ template "elevenlabs-api-key" . }}"
# Environment="CLAWDBOT_GATEWAY_PASSWORD={{ template "clawdbot-gateway-password" . }}"
Environment="KAGI_API_KEY={{ template "kagi-api-key" . }}"
Environment="PARALLEL_API_KEY={{ template "parallel-api-key" . }}"
Environment="VENICE_API_KEY={{ template "venice-api-key" . }}"
Environment="TWITTER_AUTH_TOKEN={{ template "twitter-auth-token" . }}"
Environment="TWITTER_CT0={{ template "twitter-ct0" . }}"
{{- end -}}
