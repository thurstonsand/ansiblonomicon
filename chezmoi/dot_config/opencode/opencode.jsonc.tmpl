  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": ["uv", "run", "basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "ruff": {
      "command": ["uv", "run", "ruff", "server"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "settings": {
          "logLevel": "info",
          "lint": {
            "run": "onSave"
          },
          "format": {
            "preview": false
          }
        }
      }
    }
  }
