{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-openai-codex-auth@4.3.0", "opencode-gemini-auth@1.3.6"],
  "tools": {
    "read": true
  },
  "permission": {
    "bash": {
      "tree*": "allow",
      "find*": "allow",
      "awk*": "allow",
      "sed*": "allow",
      "grep*": "allow",
      "jq*": "allow",
      "mkdir*": "allow",
      "rg*": "allow",
      "git status*": "allow",
      "git add*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "gh pr view*": "allow",
      "gh run view*": "allow",
      "uv run basedpyright*": "allow",
      "uv run ruff*": "allow",
      "uv run pre-commit*": "allow",
      "uv run yt-dlp*": "allow"
    },
    "webfetch": "allow"
  },
  "keybinds": {},
  "mcp": {
    "parallel": {
      "enabled": true,
      "type": "remote",
      "url": "https://search-mcp.parallel.ai/mcp",
      "headers": {
        "Authorization": "Bearer {{ template "parallel-search-key" . }}"
      }
    }
  },
  "model": "openai/gpt-5.2-codex",
  "provider": {
    "anthropic": {
      "blacklist": [
