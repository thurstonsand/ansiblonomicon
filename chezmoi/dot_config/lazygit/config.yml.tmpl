os:
{{- if eq .chezmoi.hostname "clawdbot" }}
  editPreset: "vim"
{{- else }}
  editPreset: "vscode"
{{- end }}

gui:
  nerdFontsVersion: "3"
  showFileTree: true
  expandFocusedSidePanel: true
  filterMode: fuzzy

git:
  log:
    order: "topo-order"
    showGraph: always
  pagers:
    - pager: delta --paging=never --$(cat ~/.terminal-bg 2>/dev/null || echo dark)
      colorArg: always
  autoFetch: false
  overrideGpg: true

promptToReturnFromSubprocess: false
{{- if .bitbucketDomain }}

services:
  '{{ .bitbucketDomain }}': 'bitbucketServer:{{ .bitbucketDomain }}'
{{- end }}
