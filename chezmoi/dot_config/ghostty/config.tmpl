font-family = {{ .fonts.mono }}
# also change the window title at the top
window-title-font-family = {{ .fonts.mono }} Bold
font-size = {{ .fonts.size }}

# if not inheriting from a previous window
working-directory = {{ .chezmoi.homeDir }}/{{ .developDir }}
# may cause kernel panics with some external displays
window-vsync = false
window-save-state = always

confirm-close-surface = false

quick-terminal-position = bottom
quick-terminal-animation-duration = 0.08

shell-integration-features = true

macos-option-as-alt = true
macos-non-native-fullscreen = visible-menu
# background-blur = macos-glass-regular # still in tip

auto-update = download
auto-update-channel = stable

theme = dark:Gruvbox Dark Hard,light:Gruvbox Light Hard

keybind = global:control+option+.=toggle_quick_terminal
keybind = cmd+enter=ignore
keybind = shift+enter=unbind
keybind = cmd+shift+p=toggle_command_palette
