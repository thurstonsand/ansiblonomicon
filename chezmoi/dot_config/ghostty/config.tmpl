font-family = {{ .fonts.mono }}
# also change the window title at the top
window-title-font-family = {{ .fonts.mono }} Bold
font-size = {{ .fonts.size }}

# if not inheriting from a previous window
working-directory = {{ .chezmoi.homeDir }}/{{ .developDir }}
# may cause kernel panics with some external displays
window-vsync = false
window-save-state = always

confirm-close-surface = false
clipboard-paste-protection = false

quick-terminal-position = bottom
quick-terminal-animation-duration = 0.08

shell-integration-features = true
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
split-preserve-zoom = navigation

macos-option-as-alt = true
macos-non-native-fullscreen = visible-menu
# background-blur = macos-glass-regular # still in tip

auto-update = download
auto-update-channel = stable

theme = dark:Gruvbox Dark Hard,light:Gruvbox Light Hard

keybind = global:control+option+.=toggle_quick_terminal
keybind = cmd+enter=ignore
keybind = shift+enter=unbind
keybind = cmd+shift+p=toggle_command_palette

# ctrl-k is claimed by goto_split:up, so route kill-to-end-of-line through cmd+fn+delete
keybind = cmd+delete=text:\x0b

# ctrl-hjkl navigates Ghostty splits unless this surface is in the nvim key table
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right
keybind = nvim/
keybind = nvim/ctrl+h=text:\x08
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c
keybind = nvim/cmd+shift+a>n=deactivate_key_table
keybind = cmd+shift+a>n=activate_key_table:nvim

# prefix-style pane actions (keeps top-level cmd bindings uncluttered)
keybind = cmd+shift+a>z=toggle_split_zoom
keybind = cmd+shift+a>h=new_split:left
keybind = cmd+shift+a>j=new_split:down
keybind = cmd+shift+a>k=new_split:up
keybind = cmd+shift+a>l=new_split:right
keybind = cmd+shift+a>m=toggle_mouse_reporting
keybind = nvim/cmd+shift+a>z=toggle_split_zoom
keybind = nvim/cmd+shift+a>h=new_split:left
keybind = nvim/cmd+shift+a>j=new_split:down
keybind = nvim/cmd+shift+a>k=new_split:up
keybind = nvim/cmd+shift+a>l=new_split:right
keybind = nvim/cmd+shift+a>m=toggle_mouse_reporting
