// IDE layout: editor and agent as separate fullscreen tabs
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="editor" focus=true {
        pane command="zsh" {
            args "-c" "nvim .; exec zsh"
        }
    }
    tab name="agent" {
        pane
    }
}
