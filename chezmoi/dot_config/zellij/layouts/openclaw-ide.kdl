// OpenClaw workspace: two projects, each with editor + agent panes
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="ansiblonomicon" focus=true cwd="/home/thurstonsand/code/ansiblonomicon" {
        pane stacked=true {
            pane name="editor" command="zsh" focus=true {
                args "-c" "nvim .; exec zsh"
            }
            pane name="agent"
        }
    }
    tab name="openclaw" cwd="/home/thurstonsand/code/external/openclaw" {
        pane stacked=true {
            pane name="editor" command="zsh" {
                args "-c" "nvim .; exec zsh"
            }
            pane name="agent"
        }
    }
}
