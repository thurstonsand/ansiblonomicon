// OpenClaw workspace: two projects, each with editor + agent panes
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="ansiblonomicon" focus=true cwd="/home/thurstonsand/code/ansiblonomicon" {
        pane stacked=true {
            pane name="editor" edit="." focus=true
            pane name="agent"
        }
    }
    tab name="home" cwd="/home/thurstonsand" {
        pane stacked=true {
            pane name="editor" edit="."
            pane name="agent"
        }
    }
}
