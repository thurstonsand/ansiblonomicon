{{- /* Maintainer note: this file is host-agnostic. All SCM-specific data lives
       in the gitignored .chezmoidata/local.toml [[scm]] table under optional
       gitbrowse.remote / gitbrowse.url, so nothing internal lands in git. */ -}}
{{- $remotes := list -}}
{{- range .scm }}{{ $r := dig "gitbrowse" "remote" dict . }}{{ if $r }}{{ $remotes = append $remotes $r }}{{ end }}{{ end -}}
-- Snacks.gitbrowse URL patterns for on-prem SCM hosts (<leader>gB open / <leader>gY copy).
-- Generated by chezmoi from .chezmoidata/local.toml [[scm]] (gitbrowse.remote / gitbrowse.url).
return {
  "folke/snacks.nvim",
  opts = {
    gitbrowse = {
{{- if $remotes }}
      -- remote_patterns is a list, so this replaces the defaults wholesale.
      -- Copied from snacks defaults, plus per-host rewrites (e.g. reshaping a
      -- Bitbucket Server base into its /projects/<key>/repos/<repo> layout).
      remote_patterns = {
        { "^(https?://.*)%.git$", "%1" },
        { "^git@(.+):(.+)%.git$", "https://%1/%2" },
        { "^git@(.+):(.+)$", "https://%1/%2" },
        { "^git@(.+)/(.+)$", "https://%1/%2" },
        { "^org%-%d+@(.+):(.+)%.git$", "https://%1/%2" },
        { "^ssh://git@(.*)$", "https://%1" },
        { "^ssh://([^:/]+)(:%d+)/(.*)$", "https://%1/%3" },
        { "^ssh://([^/]+)/(.*)$", "https://%1/%2" },
        { "ssh%.dev%.azure%.com/v3/(.*)/(.*)$", "dev.azure.com/%1/_git/%2" },
        { "^https://%w*@(.*)", "https://%1" },
        { "^git@(.*)", "https://%1" },
        { ":%d+", "" },
        { "%.git$", "" },
{{- range $remotes }}
        { "{{ .match }}", "{{ .replace }}" },
{{- end }}
      },
{{- end }}
      url_patterns = {
{{- range $entry := .scm }}
{{- $url := dig "gitbrowse" "url" dict $entry }}
{{- if $url }}
        ["{{ $entry.host | replace "." "%." }}"] = {
{{- range $key, $pattern := $url }}
          {{ $key }} = "{{ $pattern }}",
{{- end }}
        },
{{- end }}
{{- end }}
      },
    },
  },
}
