local function ansible_root_dir(bufnr, on_dir)
  -- Diffview buffers are synthetic; ansible-language-server tries to lint them and reports missing tools.
  for _, win in ipairs(vim.fn.win_findbuf(bufnr)) do
    if vim.wo[win].diff then
      return
    end
  end

  local root = vim.fs.root(bufnr, { "ansible.cfg", ".ansible-lint" })
  if root then
    on_dir(root)
  end
end

{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
return {
  {
    "mason-org/mason.nvim",
    opts = { ensure_installed = {} },
  },
  {
    "neovim/nvim-lspconfig",
    opts = {
      servers = {
        ansiblels = { mason = false, root_dir = ansible_root_dir },
        basedpyright = { mason = false },
        biome = { mason = false },
        gopls = {
          mason = false,
          settings = {
            gopls = {
              -- Re-enable once gopls/Mason ships a gopls that advertises a matching
