# .zshenv - Loaded for ALL shells (login, interactive, scripts)
# Keep this minimal - avoid side effects that could break scripts

# =============================================================================
# SECTION 1: Runs at EVERY shell level (functions don't inherit)
# =============================================================================

# Cache directory for evalcache
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# Evalcache function - caches slow shell init commands
# Used by .zprofile and .zshrc for lazy initialization
_evalcache() {
  local cmd=$1
  shift
  local cache_file="$ZSH_CACHE_DIR/${cmd##*/}_init.zsh"
  local binary=$(command -v "$cmd" 2>/dev/null)

  if [[ ! -f "$cache_file" ]] || \
     [[ -n "$binary" && "$binary" -nt "$cache_file" ]] || \
     [[ "$cmd $*" != "$(head -1 "$cache_file" 2>/dev/null | sed 's/^# //')" ]]; then
    mkdir -p "$ZSH_CACHE_DIR"
    echo "# $cmd $*" > "$cache_file"
    "$cmd" "$@" >> "$cache_file" 2>/dev/null
    zcompile "$cache_file" 2>/dev/null || true
  fi
  source "$cache_file"
}

# =============================================================================
# SECTION 2: Runs ONCE per shell tree (env vars inherit to children)
# =============================================================================

[[ -n "$__ZSHENV_ENV_CONFIGURED" ]] && return
export __ZSHENV_ENV_CONFIGURED=1

# Environment variables
export XDG_CONFIG_HOME="$HOME/.config"
{{- if eq .chezmoi.hostname "clawdbot" }}
export EDITOR="vim"
export DOCKER_HOST=ssh://admin@truenas.thurstons.house

# API keys
export CLI_PROXY_API_KEY="{{ template "llm-api-key" . }}"
export GIPHY_API_KEY="{{ template "giphy-api-key" . }}"
export GOG_KEYRING_PASSWORD="{{ template "gog-keyring-password" . }}"
export ELEVENLABS_API_KEY="{{ template "elevenlabs-api-key" . }}"
export CLAWDBOT_GATEWAY_PASSWORD="{{ template "clawdbot-gateway-password" . }}"
export KAGI_API_KEY="{{ template "kagi-api-key" . }}"
export PARALLEL_API_KEY="{{ template "parallel-api-key" . }}"
export VENICE_API_KEY="{{ template "venice-api-key" . }}"

# Twitter/X cookies for bird CLI
export AUTH_TOKEN="{{ template "twitter-auth-token" . }}"
export CT0="{{ template "twitter-ct0" . }}"
{{- else }}
export EDITOR="codeEditor --wait"
{{- end }}

# PATH additions (available to all shells including scripts)
{{- if eq .chezmoi.os "darwin" }}
# Note: .local/bin is added in .zprofile after brew shellenv
{{- end }}
typeset -U path
path=(
  "$HOME/.bun/bin"
  "$HOME/.npm-global/bin"
  "$HOME/.opencode/bin"
  "$HOME/.cargo/bin"
  "$HOME/.bun/bin"
  "$HOME/.local/share/pnpm"
  "$HOME/go/bin"
{{- if eq .chezmoi.os "darwin" }}
  "/opt/homebrew/opt/rustup/bin"
{{- end }}
{{- if eq .chezmoi.hostname "clawdbot" }}
  "$HOME/clawd/bin"
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
  "$HOME/.local/bin"
{{- end }}
  $path
)
