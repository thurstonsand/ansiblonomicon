# .zshenv - Loaded for ALL shells (login, interactive, scripts)
# Keep this minimal - avoid side effects that could break scripts

# =============================================================================
# SECTION 1: Runs at EVERY shell level (functions don't inherit)
# =============================================================================

# Cache directory for evalcache
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# Evalcache function - caches slow shell init commands
# Used by .zprofile and .zshrc for lazy initialization
_evalcache() {
  local cmd=$1
  shift
  local cache_file="$ZSH_CACHE_DIR/${cmd##*/}_init.zsh"
  local binary=$(command -v "$cmd" 2>/dev/null)

  if [[ ! -f "$cache_file" ]] || \
     [[ -n "$binary" && "$binary" -nt "$cache_file" ]] || \
     [[ "$cmd $*" != "$(head -1 "$cache_file" 2>/dev/null | sed 's/^# //')" ]]; then
    mkdir -p "$ZSH_CACHE_DIR"
    echo "# $cmd $*" > "$cache_file"
    "$cmd" "$@" >> "$cache_file" 2>/dev/null
    zcompile "$cache_file" 2>/dev/null || true
  fi
  source "$cache_file"
}

# =============================================================================
# SECTION 2: Environment variables, aliases, and PATH
# =============================================================================

# Start tmux from a clean direnv root so the server never inherits a project env.
# Use a function rather than an alias so it also works in non-interactive zsh.
tmux() {
  direnv exec / "$(whence -p tmux)" "$@"
}

# Environment variables
export XDG_CONFIG_HOME="$HOME/.config"

# SSH strips local terminal metadata, but rendering still happens client-side.
# Force icon-capable Pi powerline output when using Nerd Fonts locally.
if [[ -n "${SSH_CONNECTION:-}" ]]; then
  export POWERLINE_NERD_FONTS=1
fi

{{- if .aigEnabled }}
export PARALLEL_API_KEY="{{ template "parallel-api-key" . }}"
export PI_LIBRARIAN_MODELS="openai/{{ .models.openai.gpt_codex_spark.version }}:high"
{{- end }}
{{- if eq .chezmoi.hostname "clawdbot" }}
export EDITOR="vim"
export DOCKER_HOST=ssh://admin@truenas.thurstons.house

# API keys
export CLI_PROXY_API_KEY="{{ template "llm-api-key" . }}"
export GIPHY_API_KEY="{{ template "giphy-api-key" . }}"
export GOG_KEYRING_PASSWORD="{{ template "gog-keyring-password" . }}"
export ELEVENLABS_API_KEY="{{ template "elevenlabs-api-key" . }}"
export PARCEL_API_KEY="{{ template "parcel-api-key" . }}"
# export CLAWDBOT_GATEWAY_PASSWORD="{{ template "clawdbot-gateway-password" . }}"
export KAGI_API_KEY="{{ template "kagi-api-key" . }}"
export VENICE_API_KEY="{{ template "venice-api-key" . }}"
export VOYAGE_API_KEY="{{ template "voyage-api-key" . }}"

# Twitter/X cookies for bird CLI
export TWITTER_AUTH_TOKEN="{{ template "twitter-auth-token" . }}"
export TWITTER_CT0="{{ template "twitter-ct0" . }}"
{{- else if eq .chezmoi.hostname "openclaw" }}
export EDITOR="nvim"
{{- else }}
export EDITOR="codeEditor --wait"
{{- end }}
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}

# 1Password SSH agent
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}

if [[ ${TERM_PROGRAM:-} == "ghostty" && -t 0 ]]; then
  export GHOSTTY_NAV_TTY="$(tty)"
fi

# PATH additions (available to all shells including scripts)
{{- if eq .chezmoi.os "darwin" }}
# Note: .local/bin is added in .zprofile after brew shellenv
{{- end }}
typeset -U path
path=(
  "$HOME/.local/share/mise/shims"
  "$HOME/.bun/bin"
  "$HOME/.npm-global/bin"
{{- if ne .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  "$HOME/.opencode/bin"
{{- end }}
  "$HOME/.cargo/bin"
  "$HOME/.local/share/pnpm"
  "$HOME/go/bin"
{{- if eq .chezmoi.os "darwin" }}
{{- if lookPath "/opt/homebrew/opt/ruby/bin/ruby" }}
  "/opt/homebrew/opt/ruby/bin"
  "/opt/homebrew/lib/ruby/gems/{{ output "/opt/homebrew/opt/ruby/bin/ruby" "-e" "puts RbConfig::CONFIG['ruby_version']" | trim }}/bin"
{{- end }}
{{- if lookPath "/opt/homebrew/opt/rustup/bin/rustup" }}
  "/opt/homebrew/opt/rustup/bin"
{{- end }}
{{- end }}
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  "$HOME/.go/current/bin"
  "$HOME/scripts"
{{- end }}
{{- if eq .chezmoi.hostname "openclaw" }}
  "$HOME/bin"
  "$HOME/.local/share/bob/nvim-bin"
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
  "$HOME/.local/bin"
{{- end }}
  $path
)

# Machine-local overrides
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local
