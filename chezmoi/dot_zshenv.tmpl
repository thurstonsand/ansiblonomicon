# .zshenv - Loaded for ALL shells (login, interactive, scripts)
# Keep this minimal - avoid side effects that could break scripts

# =============================================================================
# SECTION 1: Runs at EVERY shell level (functions don't inherit)
# =============================================================================

# Cache directory for evalcache
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# Evalcache function - caches slow shell init commands
# Used by .zprofile and .zshrc for lazy initialization
_evalcache() {
  local cmd=$1
  shift
  local binary=$(whence -p "$cmd" 2>/dev/null)

  if [[ -z "$binary" ]]; then
    print -u2 "_evalcache: command not found: $cmd"
    return 127
  fi

  # Subcommand belongs in the filename: `mise activate` and `mise completion`
  # otherwise share one cache and overwrite each other every startup.
  local slug="${cmd##*/}${*:+_${(j:_:)@}}"
  local cache_file="$ZSH_CACHE_DIR/${slug//[^A-Za-z0-9_-]/_}_init.zsh"
  local cache_key="$binary $*"

  if [[ ! -f "$cache_file" ]] || \
     [[ "$binary" -nt "$cache_file" ]] || \
     [[ "$cache_key" != "$(head -1 "$cache_file" 2>/dev/null | sed 's/^# //')" ]]; then
    mkdir -p "$ZSH_CACHE_DIR"
    local cache_tmp
    local generation_status
    cache_tmp=$(mktemp "$cache_file.tmp.XXXXXX") || return
    trap "rm -f ${(q)cache_tmp}" EXIT INT TERM HUP

    if {
      echo "# $cache_key"
      "$binary" "$@"
    } > "$cache_tmp" 2>/dev/null; then
      mv "$cache_tmp" "$cache_file"
      rm -f "$cache_file.zwc"
      zcompile "$cache_file" 2>/dev/null || true
    else
      generation_status=$?
      print -u2 "_evalcache: failed to refresh $cache_key (status $generation_status)"
      [[ -f "$cache_file" ]] || return "$generation_status"
    fi
  fi
  source "$cache_file"
}

# =============================================================================
# SECTION 2: Environment variables, aliases, and PATH
# =============================================================================

# Start tmux outside project configuration so its server does not retain project credentials.
tmux() (
  local clean_env
  clean_env="$(mise -C / hook-env -s zsh)" || return
  eval "$clean_env"
  direnv exec / "$(whence -p tmux)" "$@"
)

# Environment variables
export XDG_CONFIG_HOME="$HOME/.config"

# TODO: remove once Homebrew stops denying trust.json.lock inside the build
# sandbox. Its tap-trust check re-runs in the sandbox, can't read the lock, and
# fails every non-official tap build with UntrustedTapError.
export HOMEBREW_NO_REQUIRE_TAP_TRUST=1

# SSH strips local terminal metadata, but rendering still happens client-side.
# Force icon-capable Pi powerline output when using Nerd Fonts locally.
if [[ -n "${SSH_CONNECTION:-}" ]]; then
  export POWERLINE_NERD_FONTS=1
fi

export EDITOR="nvim"
export VISUAL="nvim"
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}

# 1Password SSH agent
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}


# PATH additions (available to all shells including scripts)
{{- if eq .chezmoi.os "darwin" }}
# Keep Homebrew executables available to non-login shells. .zprofile runs
# brew shellenv for the remaining Homebrew environment configuration.
{{- end }}
typeset -U path
path=(
{{- if eq .chezmoi.os "darwin" }}
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"
{{- end }}
  "$HOME/.local/share/mise/shims"
  "$HOME/.bun/bin"
  "$HOME/.npm-global/bin"
{{- if ne .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  "$HOME/.opencode/bin"
{{- end }}
  "$HOME/.cargo/bin"
  "$HOME/.local/share/pnpm"
  "$HOME/go/bin"
{{- if eq .chezmoi.os "darwin" }}
{{- if lookPath "/opt/homebrew/opt/ruby/bin/ruby" }}
  "/opt/homebrew/opt/ruby/bin"
  "/opt/homebrew/lib/ruby/gems/{{ output "/opt/homebrew/opt/ruby/bin/ruby" "-e" "puts RbConfig::CONFIG['ruby_version']" | trim }}/bin"
{{- end }}
{{- if lookPath "/opt/homebrew/opt/rustup/bin/rustup" }}
  "/opt/homebrew/opt/rustup/bin"
{{- end }}
{{- end }}
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  "$HOME/scripts"
{{- end }}
{{- if eq .chezmoi.hostname "openclaw" }}
  "$HOME/bin"
  "$HOME/.local/share/bob/nvim-bin"
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
  "$HOME/.local/bin"
{{- end }}
  $path
)

# Machine-local overrides
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local
