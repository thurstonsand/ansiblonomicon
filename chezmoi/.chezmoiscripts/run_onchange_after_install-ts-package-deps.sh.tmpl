{{- $packageFinder := print .chezmoi.workingTree "/scripts/ts-package-json-paths.sh" -}}
{{- $sourceExtensions := print .chezmoi.sourceDir "/private_dot_pi/agent/extensions" -}}
{{- $sourcePermissions := print .chezmoi.sourceDir "/private_dot_pi/agent/permissions" -}}
{{- $sourcePowerline := print .chezmoi.sourceDir "/private_dot_pi/agent/powerline" -}}
{{- $sourceClaudeScripts := print .chezmoi.sourceDir "/dot_claude/scripts" -}}
{{- $sourceLocalLib := print .chezmoi.sourceDir "/dot_local/lib" -}}
{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
#!/bin/sh
set -eu

PACKAGE_FINDER={{ $packageFinder | quote }}

# Dependency trigger: {{ output $packageFinder "--hash" $sourceExtensions $sourcePermissions $sourcePowerline $sourceClaudeScripts $sourceLocalLib | trim }}

"$PACKAGE_FINDER" "$HOME/.pi/agent/extensions" "$HOME/.pi/agent/permissions" "$HOME/.pi/agent/powerline" "$HOME/.claude/scripts" "$HOME/.local/lib" | while IFS= read -r package_json; do
  package_dir=$(dirname "$package_json")
{{- if $isWork }}
  # Work: the @earendil-works SDK devDeps are not resolvable from artifactory,
  # so a normal install fails. They are type-check-only; pi injects the runtime SDK.
  npm --prefix "$package_dir" install --omit=dev
{{- else }}
  if [ -f "$package_dir/package-lock.json" ]; then
    npm --prefix "$package_dir" ci
  else
    npm --prefix "$package_dir" install
  fi
{{- end }}
done
