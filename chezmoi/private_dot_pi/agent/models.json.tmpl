{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "providers": {
{{- if $isWork }}
    "{{ .work_gateway.anthropic_provider }}": {
      "baseUrl": "{{ .work_gateway.base_url }}",
      "apiKey": "{{ template "work-gateway-token" $ }}",
      "api": "anthropic-messages",
      "authHeader": true,
      "headers": {"anthropic-beta": "context-1m-2025-08-07", "User-Agent": "pi-coding-agent"},
      "models": [
        {
          "id": "{{ trimSuffix "[1m]" .work_models.opus.version }}",
          "name": "{{ .work_models.opus.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": {{ .work_models.opus.cost.input }}, "output": {{ .work_models.opus.cost.output }}, "cacheRead": {{ .work_models.opus.cost.cacheRead }}, "cacheWrite": {{ .work_models.opus.cost.cacheWrite }}},
          "contextWindow": {{ .work_models.opus.context_window }},
          "maxTokens": {{ .work_models.opus.max_output }},
          "thinkingLevelMap": {"xhigh": "xhigh", "max": "max"},
          "compat": {"forceAdaptiveThinking": true, "supportsTemperature": {{ .work_models.opus.supports_temperature }}}
        },
        {
          "id": "{{ trimSuffix "[1m]" .work_models.sonnet.version }}",
          "name": "{{ .work_models.sonnet.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": {{ .work_models.sonnet.cost.input }}, "output": {{ .work_models.sonnet.cost.output }}, "cacheRead": {{ .work_models.sonnet.cost.cacheRead }}, "cacheWrite": {{ .work_models.sonnet.cost.cacheWrite }}},
          "contextWindow": {{ .work_models.sonnet.context_window }},
          "maxTokens": {{ .work_models.sonnet.max_output }},
          "thinkingLevelMap": {"xhigh": "xhigh", "max": "max"},
          "compat": {"forceAdaptiveThinking": true}
        },
        {
          "id": "{{ trimSuffix "[1m]" .work_models.haiku.version }}",
          "name": "{{ .work_models.haiku.display_name }}",
          "reasoning": false,
          "input": ["text", "image"],
          "cost": {"input": {{ .work_models.haiku.cost.input }}, "output": {{ .work_models.haiku.cost.output }}, "cacheRead": {{ .work_models.haiku.cost.cacheRead }}, "cacheWrite": {{ .work_models.haiku.cost.cacheWrite }}},
          "contextWindow": {{ .work_models.haiku.context_window }},
          "maxTokens": {{ .work_models.haiku.max_output }}
        }
      ]
    },
    "{{ .work_gateway.openai_provider }}": {
      "baseUrl": "{{ .work_gateway.base_url }}/v1",
      "apiKey": "{{ template "work-gateway-token" $ }}",
      "api": "openai-responses",
      "headers": {"User-Agent": "pi-coding-agent"},
      "compat": {"supportsStrictMode": true, "supportsOpenAIGrammarTools": true},
      "models": [
        {
          "id": "{{ .work_models.gpt_sol.version }}",
          "name": "{{ .work_models.gpt_sol.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": {{ .work_models.gpt_sol.cost.input }}, "output": {{ .work_models.gpt_sol.cost.output }}, "cacheRead": {{ .work_models.gpt_sol.cost.cacheRead }}, "cacheWrite": {{ .work_models.gpt_sol.cost.cacheWrite }}},
          "contextWindow": {{ .work_models.gpt_sol.context_window }},
          "maxTokens": {{ .work_models.gpt_sol.max_output }},
          "thinkingLevelMap": {"off": "none", "minimal": null, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}
        },
        {
          "id": "{{ .work_models.gpt_terra.version }}",
          "name": "{{ .work_models.gpt_terra.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": {{ .work_models.gpt_terra.cost.input }}, "output": {{ .work_models.gpt_terra.cost.output }}, "cacheRead": {{ .work_models.gpt_terra.cost.cacheRead }}, "cacheWrite": {{ .work_models.gpt_terra.cost.cacheWrite }}},
          "contextWindow": {{ .work_models.gpt_terra.context_window }},
          "maxTokens": {{ .work_models.gpt_terra.max_output }},
          "thinkingLevelMap": {"off": "none", "minimal": null, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}
        },
        {
          "id": "{{ .work_models.gpt_luna.version }}",
          "name": "{{ .work_models.gpt_luna.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": {{ .work_models.gpt_luna.cost.input }}, "output": {{ .work_models.gpt_luna.cost.output }}, "cacheRead": {{ .work_models.gpt_luna.cost.cacheRead }}, "cacheWrite": {{ .work_models.gpt_luna.cost.cacheWrite }}},
          "contextWindow": {{ .work_models.gpt_luna.context_window }},
          "maxTokens": {{ .work_models.gpt_luna.max_output }},
          "thinkingLevelMap": {"off": "none", "minimal": null, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}
        }
      ]
    }
{{- end }}
  }
}
