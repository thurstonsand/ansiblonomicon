{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "providers": {
{{- if $isWork }}
    "genaihub": {
      "baseUrl": "{{ .anthropicBaseUrl }}",
      "apiKey": "{{ .anthropicAuthToken }}",
      "api": "anthropic-messages",
      "authHeader": true,
      "headers": {"anthropic-beta": "context-1m-2025-08-07", "User-Agent": "pi-coding-agent"},
      "models": [
        {
          "id": "{{ trimSuffix "[1m]" .claude_code_models.opus }}",
          "name": "{{ .claude_code_models.opus_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.anthropic.opus.max_input }},
          "maxTokens": {{ .models.anthropic.opus.max_output }},
          "thinkingLevelMap": {"xhigh": "xhigh", "max": "max"},
          "compat": {"forceAdaptiveThinking": true, "supportsTemperature": {{ .models.anthropic.opus.supports_temperature }}}
        },
        {
          "id": "{{ trimSuffix "[1m]" .claude_code_models.sonnet }}",
          "name": "{{ .claude_code_models.sonnet_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.anthropic.sonnet.max_input }},
          "maxTokens": {{ .models.anthropic.sonnet.max_output }},
          "thinkingLevelMap": {"xhigh": "xhigh", "max": "max"},
          "compat": {"forceAdaptiveThinking": true}
        },
        {
          "id": "{{ trimSuffix "[1m]" .claude_code_models.haiku }}",
          "name": "{{ .claude_code_models.haiku_name }}",
          "reasoning": false,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.anthropic.haiku.max_input }},
          "maxTokens": {{ .models.anthropic.haiku.max_output }}
        }
      ]
    }
{{- else }}
    "google": {
      "baseUrl": "https://aig.thurstons.house/v1beta",
      "apiKey": "{{ template "llm-api-key" . }}",
      "authHeader": true,
      "modelOverrides": {
        "{{ .models.google.gemini_flash.version }}": {
          "name": "{{ .models.google.gemini_flash.display_name }}",
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.google.gemini_flash.max_input }},
          "maxTokens": {{ .models.google.gemini_flash.max_output }}
        },
        "{{ .models.google.gemini_pro.version }}": {
          "name": "{{ .models.google.gemini_pro.display_name }}",
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.google.gemini_pro.max_input }},
          "maxTokens": {{ .models.google.gemini_pro.max_output }}
        }
      }
    }
{{- end }}
  }
}
