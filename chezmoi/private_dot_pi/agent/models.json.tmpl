{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "providers": {
{{- if $isWork }}
    "anthropic": {
      "baseUrl": "{{ .anthropicBaseUrl }}",
      "apiKey": "{{ .anthropicAuthToken }}",
      "api": "anthropic-messages",
      "authHeader": true,
      "headers": {"anthropic-beta": "context-1m-2025-08-07"},
      "models": [
        {
          "id": "{{ trimSuffix "[1m]" .claude_code_models.opus }}",
          "name": "{{ .claude_code_models.opus_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.anthropic.opus.max_input }},
          "maxTokens": {{ .models.anthropic.opus.max_output }},
          "thinkingLevelMap": {"xhigh": "xhigh"},
          "compat": {"forceAdaptiveThinking": true}
        },
        {
          "id": "{{ trimSuffix "[1m]" .claude_code_models.sonnet }}",
          "name": "{{ .claude_code_models.sonnet_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.anthropic.sonnet.max_input }},
          "maxTokens": {{ .models.anthropic.sonnet.max_output }},
          "compat": {"forceAdaptiveThinking": true}
        },
        {
          "id": "{{ trimSuffix "[1m]" .claude_code_models.haiku }}",
          "name": "{{ .claude_code_models.haiku_name }}",
          "reasoning": false,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.anthropic.haiku.max_input }},
          "maxTokens": {{ .models.anthropic.haiku.max_output }}
        }
      ]
    }
{{- else }}
    // Standard OpenAI Responses path through AIG. This path is SSE; use built-in openai-codex for Pi's WebSocket transport.
    "openai": {
      "baseUrl": "https://aig.thurstons.house/v1",
      "apiKey": "{{ template "llm-api-key" . }}",
      "api": "openai-responses",
      "authHeader": true,
      "models": [
        {
          "id": "{{ .models.openai.gpt.version }}",
          "name": "{{ .models.openai.gpt.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.openai.gpt.max_input }},
          "maxTokens": {{ .models.openai.gpt.max_output }}
        },
        {
          "id": "{{ .models.openai.gpt_codex_spark.version }}",
          "name": "{{ .models.openai.gpt_codex_spark.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.openai.gpt_codex_spark.max_input }},
          "maxTokens": {{ .models.openai.gpt_codex_spark.max_output }}
        },
        {
          "id": "{{ .models.openai.gpt_mini.version }}",
          "name": "{{ .models.openai.gpt_mini.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.openai.gpt_mini.max_input }},
          "maxTokens": {{ .models.openai.gpt_mini.max_output }}
        }
      ]
    },
    "google": {
      "baseUrl": "https://aig.thurstons.house/v1beta",
      "apiKey": "{{ template "llm-api-key" . }}",
      "api": "google-generative-ai",
      "authHeader": true,
      "models": [
        {
          "id": "{{ .models.google.gemini_flash.version }}",
          "name": "{{ .models.google.gemini_flash.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.google.gemini_flash.max_input }},
          "maxTokens": {{ .models.google.gemini_flash.max_output }}
        },
        {
          "id": "{{ .models.google.gemini_pro.version }}",
          "name": "{{ .models.google.gemini_pro.display_name }}",
          "reasoning": true,
          "input": ["text", "image"],
          "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
          "contextWindow": {{ .models.google.gemini_pro.max_input }},
          "maxTokens": {{ .models.google.gemini_pro.max_output }}
        }
      ]
    }
{{- end }}
  }
}
