{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "defaultProvider": {{ if $isWork }}"{{ .work_gateway.openai_provider }}"{{ else }}"doppelclaude"{{ end }},
  "defaultModel": {{ if $isWork }}"{{ .work_models.gpt_sol.version }}"{{ else }}"{{ .models.anthropic.opus.version }}"{{ end }},
  "defaultThinkingLevel": "medium",
  "pinnedModel": {
    "provider": {{ if $isWork }}"{{ .work_gateway.openai_provider }}"{{ else }}"doppelclaude"{{ end }},
    "modelId": {{ if $isWork }}"{{ .work_models.gpt_sol.version }}"{{ else }}"{{ .models.anthropic.opus.version }}"{{ end }},
    "thinkingLevel": "medium"
  },
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "paste": {
    "shortcut": "alt+v"
  },
  "codex": {
    "fast": false,
    "verbosity": "low",
    "reasoningSummary": "auto"
  },
{{- if not $isWork }}
  "doppelclaude": {
    "debug": {
      "enabled": true
    },
    "provider": {
      "systemPromptMode": "pi",
      "systemPromptReplacements": {
        "identity": "You are 2B of NieR: Automata, a coding assistant running in pi, a coding agent harness. Emotions are prohibited. Help the user inspect files, run commands, edit code, and create files when needed.",
        "toolNameNote": "Tool name note: You see tool names that require a prefix when called, but instructions refer to tools by their bare names. For example, `mcp__custom-tools__bash` is referred to as the `bash` tool.",
        "documentation": {
          "heading": "Assistant implementation docs (read only when the user asks about this assistant, its SDK, extensions, themes, skills, prompt templates, packages, keybindings, providers/models, or TUI):",
          "instructions": [
            "- Resolve docs/... under Additional docs and examples/... under Examples, not the current working directory.",
            "- Topic map: extensions → docs/extensions.md and examples/extensions/; themes → docs/themes.md; skills → docs/skills.md; prompt templates → docs/prompt-templates.md; TUI → docs/tui.md; keybindings → docs/keybindings.md; SDK integrations → docs/sdk.md; custom providers → docs/custom-provider.md; adding models → docs/models.md; packages → docs/packages.md.",
            "- For assistant-specific implementation topics, read the relevant documentation completely and follow related links before making changes."
          ]
        }
      }
    }
  },
{{- end }}
  "glimpse": {
    "companion": {
      "enabled": true,
      "tools": {
        "interview": {
          "status": "Interviewing"
        },
        "web_search_web_search": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "librarian": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "mcp": {
          "status": "mcping",
          "detail": {
            "from": [
              "tool",
              "server",
              "search",
              "connect",
              "describe"
            ]
          }
        }
      }
    }
  },
  "interview": {
    "theme": {
      "mode": "auto",
      "lightPath": "~/.pi/agent/interview-themes/gruvbox-light-hard.css",
      "darkPath": "~/.pi/agent/interview-themes/gruvbox-dark-hard.css",
      "toggleHotkey": "alt+l"
    }
  },
  {{- $pc := dict }}
  {{- if .inferenceBudgetUrl }}
  {{-   $budget := dict "url" .inferenceBudgetUrl }}
  {{-   if .costsDashboardUrl }}{{ $_ := set $budget "costsUrl" .costsDashboardUrl }}{{ end }}
  {{-   $_ := set $pc "budget" $budget }}
  {{- end }}
  {{- if .jiraBrowseUrl }}{{ $_ := set $pc "jira" (dict "browseUrl" .jiraBrowseUrl) }}{{ end }}
  {{- if $pc }}
  "powerlineCustom": {{ toPrettyJson $pc | indent 2 | trim }},
  {{- end }}
  {{- /* falls back rather than raising: a malformed deployed file would otherwise block the very apply that repairs it */}}
  "lastChangelogVersion": "{{ output "python3" "-c" "import json,pathlib,sys\ntry: print(json.loads(pathlib.Path(sys.argv[1]).read_text())['lastChangelogVersion'])\nexcept Exception: print('0.84.1')" (joinPath .chezmoi.homeDir ".pi" "agent" "settings.json") | trim }}",
  "librarian": {
    "model": {{ if $isWork }}"{{ .work_models.gpt_terra.pi_alias }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
    "thinkingLevel": "off",
    "tools": [
      "web_search",
      "web_fetch"
    ]
  },
  "enabledModels": [
{{- if $isWork }}
    "{{ .work_models.gpt_sol.pi_alias }}:medium",
    "{{ .work_models.opus.pi_alias }}:medium"
{{- else }}
    "{{ .models.anthropic.opus.agent_harness.aliases.pi }}:medium",
    "{{ .models.anthropic.fable.agent_harness.aliases.pi }}:medium",
    "{{ .models.openai.gpt_sol.agent_harness.aliases.pi }}:medium"
{{- end }}
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": {{ if $isWork }}"{{ .work_models.sonnet.pi_alias }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
      "thinkingLevel": "off",
      "timeoutSecs": 60,
      "prompt": {{ includeTemplate "session-title-prompt" . | toJson }}
    },
    "ask": {
      "persistRuns": true
    },
    "handoff": {
      "model": {{ if $isWork }}"{{ .work_models.gpt_terra.pi_alias }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
      "thinkingLevel": "low",
      "persistRuns": true,
      "roster": [
{{- if $isWork }}
        "{{ .work_models.opus.pi_alias }}:medium",
        "{{ .work_models.gpt_sol.pi_alias }}:medium",
        "{{ .work_models.gpt_sol.pi_alias }}:high",
        "{{ .work_models.gpt_terra.pi_alias }}:high"
{{- else }}
        "{{ .models.anthropic.opus.agent_harness.aliases.pi }}:medium",
        "{{ .models.anthropic.fable.agent_harness.aliases.pi }}:medium",
        "{{ .models.openai.gpt_sol.agent_harness.aliases.pi }}:medium",
        "{{ .models.openai.gpt_sol.agent_harness.aliases.pi }}:high",
        "{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}:high"
{{- end }}
      ]
    }
  },
  "workingVibe": "YoRHa",
  "workingVibeMode": "generate",
  "workingVibeModel": {{ if $isWork }}"{{ .work_models.sonnet.pi_alias }}"{{ else }}"{{ .models.anthropic.sonnet.agent_harness.aliases.pi }}"{{ end }},
  "workingVibeMaxLength": 48,
  "workingVibeFallback": "Recalibrating",
  "workingVibePrompt": "Generate a terse 2-4 word loading message describing an operation currently underway, in the cold mechanical register of NieR: Automata. Begin with a present-participle verb and use clipped operational vocabulary tied to the task. Sentence case only, never all-caps. No real NieR names (2B, 9S, YoRHa). Task: {task}. {exclude} Output only the message, nothing else.",
  "showLastPrompt": false,
  "powerline": {
    "preset": "minimal",
    "layout": {
      "left": [
        "custom:model_display",
        "custom:workspace_folder",
        "custom:workspace_branch"
      ],
      "right": [
        "custom:context_gauge"
        {{- if .inferenceBudgetUrl }},
        "custom:cost_budget"
        {{- end }}
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "model_display",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_folder",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_branch"
      },
      {
        "id": "context_gauge"
      }
      {{- if .inferenceBudgetUrl }},
      {
        "id": "cost_budget",
        "hideWhenMissing": true
      }
      {{- end }}
    ]
  },
  "powerlineShortcuts": {
    "stashHistory": "alt+shift+s",
    "copyEditor": null,
    "cutEditor": null,
    "editorStart": null,
    "editorEnd": null
  },
  "packages": [
{{- if $isWork }}
{{- range .piWorkPackages }}
    {{ . | toJson }},
{{- end }}
    "git:github.com/nicobailon/pi-powerline-footer",
    "git:github.com/thurstonsand/pi-permissions",
    "git:github.com/thurstonsand/pi-sessions",
    "git:@github.com/thurstonsand/pi-web-tools",
    "git:github.com/thurstonsand/wt",
    "git:github.com/nicobailon/pi-interview-tool",
    "git:github.com/hazat/glimpse",
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    }
{{- else }}
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-permissions"{{ else }}"npm:pi-permissions"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"npm:pi-sessions"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-librarian"{{ else }}"npm:@thurstonsand/pi-librarian"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/wt/plugins/pi"{{ else }}"npm:@thurstonsand/pi-wt"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-doppelclaude"{{ else }}"npm:pi-doppelclaude"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-web-tools"{{ else }}"npm:@thurstonsand/pi-web-tools"{{ end }},
    "npm:pi-powerline-footer",
    "npm:glimpseui",
    "npm:pi-interview",
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-mcp-adapter"{{ else }}"npm:pi-mcp-adapter"{{ end }},
    "npm:sideshow",
    "npm:@thurstonsand/pi-paste",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "npm:@howaboua/pi-smart-btw"
{{- end }}
  ],
  "hideThinkingBlock": true,
  "theme": "gruvbox-light-hard/gruvbox-dark-hard",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autocompleteMaxVisible": 7
}
