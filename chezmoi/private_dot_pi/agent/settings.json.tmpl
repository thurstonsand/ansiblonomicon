{
  "defaultProvider": "anthropic",
  "defaultModel": "{{ .models.anthropic.opus.version }}",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "lastChangelogVersion": "0.50.1",
  "enabledModels": [
    "anthropic/{{ .models.anthropic.opus.version }}",
    "openai/{{ .models.openai.gpt_codex.version }}",
    "google/{{ .models.google.gemini_3_pro.version }}"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "packages": [
    "npm:pi-interactive-shell",
    {
      "source": "npm:shitty-extensions",
      "extensions": [
        "-extensions/cost-tracker.ts",
        "-extensions/flicker-corp.ts",
        "-extensions/funny-working-message.ts",
        "+extensions/handoff.ts",
        "-extensions/loop.ts",
        "-extensions/memory-mode.ts",
        "-extensions/plan-mode.ts",
        "+extensions/oracle.ts",
        "-extensions/speedreading.ts",
        "-extensions/status-widget.ts",
        "-extensions/ultrathink.ts",
        "-extensions/usage-bar.ts"
      ],
      "skills": ["-skills/a-nach-b/SKILL.md"]
    }
  ]
}
