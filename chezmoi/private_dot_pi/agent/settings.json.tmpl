{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "defaultProvider": {{ if $isWork }}"genaihub"{{ else }}"openai-codex"{{ end }},
  "defaultModel": {{ if $isWork }}"{{ trimSuffix "[1m]" .work_models.opus.version }}"{{ else }}"{{ .models.openai.gpt_sol.version }}"{{ end }},
  "defaultThinkingLevel": "medium",
  "pinnedModel": {
    "provider": {{ if $isWork }}"genaihub"{{ else }}"openai-codex"{{ end }},
    "modelId": {{ if $isWork }}"{{ trimSuffix "[1m]" .work_models.opus.version }}"{{ else }}"{{ .models.openai.gpt_sol.version }}"{{ end }},
    "thinkingLevel": "medium"
  },
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "pasteFile": {
    "shortcut": "alt+p"
  },
  "codex": {
    "fast": false,
    "verbosity": "low",
    "reasoningSummary": "auto"
  },
{{- if not $isWork }}
  "claudeBridge": {
    "provider": {
      "systemPromptMode": "pi",
      "systemPromptReplacements": {
        "identity": "You are 2B of NieR: Automata, a coding assistant running in pi, a coding agent harness. Emotions are prohibited. Help the user inspect files, run commands, edit code, and create files when needed.",
        "toolNameNote": "Tool name note: You see tool names that require a prefix when called, but instructions refer to tools by their bare names. For example, `mcp__custom-tools__bash` is referred to as the `bash` tool.",
        "documentation": {
          "heading": "Assistant implementation docs (read only when the user asks about this assistant, its SDK, extensions, themes, skills, prompt templates, packages, keybindings, providers/models, or TUI):",
          "instructions": "- Resolve docs/... under Additional docs and examples/... under Examples, not the current working directory.\n- Topic map: extensions → docs/extensions.md and examples/extensions/; themes → docs/themes.md; skills → docs/skills.md; prompt templates → docs/prompt-templates.md; TUI → docs/tui.md; keybindings → docs/keybindings.md; SDK integrations → docs/sdk.md; custom providers → docs/custom-provider.md; adding models → docs/models.md; packages → docs/packages.md.\n- For assistant-specific implementation topics, read the relevant documentation completely and follow related links before making changes."
        }
      }
    }
  },
{{- end }}
  "glimpse": {
    "companion": {
      "enabled": true,
      "tools": {
        "interview": {
          "status": "Interviewing"
        },
        "web_search_web_search": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "librarian": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "mcp": {
          "status": "mcping",
          "detail": {
            "from": [
              "tool",
              "server",
              "search",
              "connect",
              "describe"
            ]
          }
        }
      }
    }
  },
  "interview": {
    "theme": {
      "mode": "auto",
      "lightPath": "~/.pi/agent/interview-themes/gruvbox-light-hard.css",
      "darkPath": "~/.pi/agent/interview-themes/gruvbox-dark-hard.css",
      "toggleHotkey": "alt+l"
    }
  },
  {{- $pc := dict }}
  {{- if .inferenceBudgetUrl }}
  {{-   $budget := dict "url" .inferenceBudgetUrl }}
  {{-   if .costsDashboardUrl }}{{ $_ := set $budget "costsUrl" .costsDashboardUrl }}{{ end }}
  {{-   $_ := set $pc "budget" $budget }}
  {{- end }}
  {{- if .jiraBrowseUrl }}{{ $_ := set $pc "jira" (dict "browseUrl" .jiraBrowseUrl) }}{{ end }}
  {{- if $pc }}
  "powerlineCustom": {{ toPrettyJson $pc | indent 2 | trim }},
  {{- end }}
  "lastChangelogVersion": "{{ output "python3" "-c" "import json,pathlib,sys; p=pathlib.Path(sys.argv[1]); print(json.loads(p.read_text()).get('lastChangelogVersion','0.74.0') if p.exists() else '0.74.0')" (joinPath .chezmoi.homeDir ".pi" "agent" "settings.json") | trim }}",
  "librarian": {
    "model": {{ if $isWork }}"genaihub/{{ trimSuffix "[1m]" .work_models.sonnet.version }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
    "thinkingLevel": "off",
    "tools": [
      "search_web",
      "fetch_web"
    ]
  },
  "enabledModels": [
{{- if $isWork }}
    "genaihub/{{ trimSuffix "[1m]" .work_models.opus.version }}",
    "genaihub/{{ trimSuffix "[1m]" .work_models.sonnet.version }}",
    "genaihub/{{ trimSuffix "[1m]" .work_models.haiku.version }}"
{{- else }}
    "{{ .models.anthropic.fable.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.sonnet.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.haiku.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_sol.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_luna.agent_harness.aliases.pi }}"
{{- end }}
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": {{ if $isWork }}"genaihub/{{ trimSuffix "[1m]" .work_models.sonnet.version }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
      "timeoutSecs": 60,
      "prompt": {{ includeTemplate "session-title-prompt" . | toJson }}
    },
    "ask": {
      "persistRuns": true
    },
    "handoff": {
      "model": {{ if $isWork }}"genaihub/{{ trimSuffix "[1m]" .work_models.sonnet.version }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
      "thinkingLevel": "low",
      "persistRuns": true
    }
  },
  "workingVibe": "YoRHa",
  "workingVibeMode": "generate",
  "workingVibeModel": {{ if $isWork }}"genaihub/{{ .work_models.haiku.version }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
  "workingVibeMaxLength": 48,
  "workingVibeFallback": "Recalibrating",
  "workingVibePrompt": "Generate a terse 2-4 word loading message describing an operation currently underway, in the cold mechanical register of NieR: Automata. Begin with a present-participle verb and use clipped operational vocabulary tied to the task. Sentence case only, never all-caps. No real NieR names (2B, 9S, YoRHa). Task: {task}. {exclude} Output only the message, nothing else.",
  "showLastPrompt": false,
  "powerline": {
    "mouseScroll": false,
    "preset": "minimal",
    "layout": {
      "left": [
        "custom:model_display",
        "custom:workspace_folder",
        "custom:workspace_branch"
      ],
      "right": [
        "custom:context_gauge"
        {{- if .inferenceBudgetUrl }},
        "custom:cost_budget"
        {{- end }}
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "model_display",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_folder",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_branch"
      },
      {
        "id": "context_gauge"
      }
      {{- if .inferenceBudgetUrl }},
      {
        "id": "cost_budget",
        "hideWhenMissing": true
      }
      {{- end }}
    ]
  },
  "powerlineShortcuts": {
    "stashHistory": "alt+shift+s",
    "copyEditor": null,
    "cutEditor": null,
    "jumpPreviousUserMessage": "ctrl+shift+k",
    "jumpNextUserMessage": "ctrl+shift+j",
    "jumpPreviousLlmMessage": null,
    "jumpNextLlmMessage": null,
    "jumpChatBottom": "ctrl+shift+g",
    "scrollChatUp": "alt+k",
    "scrollChatDown": "alt+j",
    "editorStart": null,
    "editorEnd": null
  },
  "packages": [
{{- if $isWork }}
{{- range .piWorkPackages }}
    {{ . | toJson }},
{{- end }}
    "git:github.com/nicobailon/pi-powerline-footer",
    "git:github.com/thurstonsand/pi-permissions",
    "git:github.com/thurstonsand/pi-sessions",
    "git:@github.com/thurstonsand/pi-web-tools",
    "git:github.com/thurstonsand/wt",
    "git:github.com/nicobailon/pi-interview-tool",
    "git:github.com/hazat/glimpse",
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    }
{{- else }}
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-permissions"{{ else }}"npm:pi-permissions"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"npm:pi-sessions"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-librarian"{{ else }}"npm:@thurstonsand/pi-librarian"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/wt/plugins/pi"{{ else }}"npm:@thurstonsand/pi-wt"{{ end }},
    {{- if eq .chezmoi.os "darwin" }}
    "/Users/thurstonsand/Develop/pi-claude-bridge",
    {{- end }}
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-web-tools"{{ else }}"npm:@thurstonsand/pi-web-tools"{{ end }},
    "npm:glimpseui",
    "npm:pi-interview",
    "npm:pi-mcp-adapter",
    "npm:pi-powerline-footer",
    "npm:sideshow",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "npm:@howaboua/pi-smart-btw"
{{- end }}
  ],
  "hideThinkingBlock": true,
  "theme": "gruvbox-light-hard/gruvbox-dark-hard",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autocompleteMaxVisible": 7
}
