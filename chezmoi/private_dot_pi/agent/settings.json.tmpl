{
  "defaultProvider": "openai-codex",
  "defaultModel": "{{ .models.openai.gpt.version }}",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "pasteFile": {
    "shortcut": "alt+p"
  },
  "lastChangelogVersion": "{{ output "python3" "-c" "import json,pathlib,sys; p=pathlib.Path(sys.argv[1]); print(json.loads(p.read_text()).get('lastChangelogVersion','0.74.0') if p.exists() else '0.74.0')" (joinPath .chezmoi.homeDir ".pi" "agent" "settings.json") | trim }}",
  "enabledModels": [
    "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.haiku.agent_harness.aliases.pi }}",
    "openai-codex/{{ .models.openai.gpt.version }}",
    "openai-codex/{{ .models.openai.gpt_codex_spark.version }}",
    "{{ .models.openai.gpt_mini.agent_harness.aliases.pi }}",
    "{{ .models.google.gemini_pro.agent_harness.aliases.pi }}",
    "{{ .models.google.gemini_flash.agent_harness.aliases.pi }}"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": "{{ .models.google.gemini_flash.agent_harness.aliases.pi }}"
    }
  },
  "showLastPrompt": false,
  "powerline": {
    "preset": "custom",
    "custom": {
      "separator": "slash",
      "leftSegments": [
        "custom:model_display",
        "custom:workspace_folder",
        "custom:workspace_branch"
      ],
      "rightSegments": [
        "custom:context_gauge"
      ],
      "secondarySegments": [],
      "options": {
        "path": {
          "mode": "basename",
          "maxLength": 60
        },
        "git": {
          "showBranch": true,
          "showStaged": false,
          "showUnstaged": false,
          "showUntracked": false
        }
      }
    },
    "customItems": [
      {
        "id": "model_display",
        "position": "left",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_folder",
        "position": "left",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_branch",
        "position": "left"
      },
      {
        "id": "context_gauge",
        "position": "right"
      }
    ]
  },
  "packages": [
    {
      "source": "npm:pi-interactive-shell",
      "skills": [
        "-examples/skills/codex-5-3-prompting/SKILL.md",
        "-examples/skills/codex-cli/SKILL.md",
        "-examples/skills/gpt-5-4-prompting/SKILL.md"
      ],
      "prompts": [
        "-examples/prompts/codex-implement-plan.md",
        "-examples/prompts/codex-review-impl.md",
        "-examples/prompts/codex-review-plan.md"
      ]
    },
    "npm:pi-librarian",
    "npm:pi-verbosity-control",
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-powerline-footer"{{ else }}"npm:@thurstonsand/pi-powerline-footer"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"npm:pi-sessions"{{ end }},
    "git:github.com/davebcn87/pi-autoresearch",
    "npm:pi-interview",
{{- if eq .chezmoi.os "darwin" }}
    "npm:glimpseui",
{{- end }}
    "npm:pi-mcp-adapter",
    "npm:@plannotator/pi-extension",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "npm:@benvargas/pi-openai-fast",
    "git:github.com/earendil-works/pi-review",
    "npm:pi-btw"
  ],
{{- if eq .chezmoi.os "darwin" }}
  "extensions": [
    "{{ output "npm" "root" "-g" | trim }}/glimpseui/examples/companion/index.ts"
  ],
{{- end }}
  "hideThinkingBlock": true,
  "theme": "{{ output "sh" "-c" "if [ \"$(cat ~/.terminal-bg 2>/dev/null || echo dark)\" = light ]; then echo gruvbox-light-hard; else echo gruvbox-dark-hard; fi" | trim }}",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autocompleteMaxVisible": 7
}