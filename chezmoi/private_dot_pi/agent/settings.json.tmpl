{
  "defaultProvider": "openai",
  "defaultModel": "{{ .models.openai.gpt.version }}",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "lastChangelogVersion": "0.70.2",
  "enabledModels": [
    "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.haiku.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_codex_spark.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_mini.agent_harness.aliases.pi }}",
    "{{ .models.google.gemini_pro.agent_harness.aliases.pi }}",
    "{{ .models.google.gemini_flash.agent_harness.aliases.pi }}"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": "{{ .models.google.gemini_flash.agent_harness.aliases.pi }}"
    }
  },
  "powerline": {
    "preset": "custom",
    "showLastPrompt": false,
    "profiles": [
      {
        "model": "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
        "thinking": "medium",
        "label": "smart"
      },
      {
        "model": "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
        "thinking": "high",
        "label": "smart"
      },
      {
        "model": "{{ .models.openai.gpt.agent_harness.aliases.pi }}",
        "thinking": "medium",
        "label": "deep"
      },
      {
        "model": "{{ .models.openai.gpt.agent_harness.aliases.pi }}",
        "thinking": "high",
        "label": "deep"
      },
      {
        "model": "{{ .models.openai.gpt.agent_harness.aliases.pi }}",
        "thinking": "xhigh",
        "label": "deep"
      }
    ],
    "vibe": {
      "theme": "NieR:Automata - 2B",
      "mode": "generate",
      "model": "{{ .models.anthropic.haiku.agent_harness.aliases.pi }}",
      "fallback": "Executing mission",
      "refreshInterval": 30,
      "maxLength": 48
    },
    "custom": {
      "separator": "powerline-thin",
      "leftSegments": [
        "model",
        "path",
        "git"
      ],
      "rightSegments": [
        "context_pct"
      ],
      "secondarySegments": [],
      "options": {
        "model": {
          "showThinkingLevel": false,
          "verbosity": {
            "style": "icon"
          }
        },
        "path": {
          "mode": "basename",
          "maxLength": 60
        },
        "git": {
          "showBranch": true,
          "showStaged": false,
          "showUnstaged": false,
          "showUntracked": false
        },
        "context_pct": {
          "maxTokens": 400000,
          "warnAt": 50,
          "errorAt": 80
        }
      }
    }
  },
  "packages": [
    {
      "source": "npm:pi-interactive-shell",
      "skills": [
        "-examples/skills/codex-5-3-prompting/SKILL.md",
        "-examples/skills/codex-cli/SKILL.md",
        "-examples/skills/gpt-5-4-prompting/SKILL.md"
      ],
      "prompts": [
        "-examples/prompts/codex-implement-plan.md",
        "-examples/prompts/codex-review-impl.md",
        "-examples/prompts/codex-review-plan.md"
      ]
    },
    "npm:pi-librarian",
    "npm:pi-verbosity-control",
    {{ if eq .chezmoi.os "darwin" }}"npm:@thurstonsand/pi-powerline-footer"{{ else }}"npm:@thurstonsand/pi-powerline-footer"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"npm:pi-sessions"{{ end }},
    "git:github.com/davebcn87/pi-autoresearch",
    "npm:pi-interview",
{{- if eq .chezmoi.os "darwin" }}
    "npm:glimpseui",
{{- end }}
    "npm:pi-mcp-adapter",
    "npm:@plannotator/pi-extension",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "npm:@benvargas/pi-openai-fast",
    "git:github.com/earendil-works/pi-review"
  ],
  "extensions": [
{{- if eq .chezmoi.os "darwin" }}
    "{{ output "npm" "root" "-g" | trim }}/glimpseui/examples/companion/index.ts"
{{- end }}
  ],
  "hideThinkingBlock": false,
  "theme": "{{ output "sh" "-c" "if [ \"$(cat ~/.terminal-bg 2>/dev/null || echo dark)\" = light ]; then echo gruvbox-light-hard; else echo gruvbox-dark-hard; fi" | trim }}",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autcompleteMaxVisible": 7
}
