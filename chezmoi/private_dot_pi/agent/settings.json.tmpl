{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "defaultProvider": {{ if $isWork }}"anthropic"{{ else }}"openai-codex"{{ end }},
  "defaultModel": {{ if $isWork }}"{{ trimSuffix "[1m]" .claude_code_models.opus }}"{{ else }}"{{ .models.openai.gpt_sol.version }}"{{ end }},
  "defaultThinkingLevel": "medium",
  "pinnedModel": {
    "provider": {{ if $isWork }}"anthropic"{{ else }}"openai-codex"{{ end }},
    "modelId": {{ if $isWork }}"{{ trimSuffix "[1m]" .claude_code_models.opus }}"{{ else }}"{{ .models.openai.gpt_sol.version }}"{{ end }},
    "thinkingLevel": "medium"
  },
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "pasteFile": {
    "shortcut": "alt+p"
  },
  "codex": {
    "fast": false,
    "verbosity": "low",
    "reasoningSummary": "auto"
  },
  "glimpse": {
    "companion": {
      "enabled": true,
      "tools": {
        "interview": {
          "status": "Interviewing"
        },
        "web_search_web_search": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "librarian": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "mcp": {
          "status": "mcping",
          "detail": {
            "from": [
              "tool",
              "server",
              "search",
              "connect",
              "describe"
            ]
          }
        }
      }
    }
  },
  "interview": {
    "theme": {
      "mode": "auto",
      "lightPath": "~/.pi/agent/interview-themes/gruvbox-light-hard.css",
      "darkPath": "~/.pi/agent/interview-themes/gruvbox-dark-hard.css",
      "toggleHotkey": "alt+l"
    }
  },
  {{- $pc := dict }}
  {{- if .inferenceBudgetUrl }}
  {{-   $budget := dict "url" .inferenceBudgetUrl }}
  {{-   if .costsDashboardUrl }}{{ $_ := set $budget "costsUrl" .costsDashboardUrl }}{{ end }}
  {{-   $_ := set $pc "budget" $budget }}
  {{- end }}
  {{- if .jiraBrowseUrl }}{{ $_ := set $pc "jira" (dict "browseUrl" .jiraBrowseUrl) }}{{ end }}
  {{- if $pc }}
  "powerlineCustom": {{ toPrettyJson $pc | indent 2 | trim }},
  {{- end }}
  "lastChangelogVersion": "{{ output "python3" "-c" "import json,pathlib,sys; p=pathlib.Path(sys.argv[1]); print(json.loads(p.read_text()).get('lastChangelogVersion','0.74.0') if p.exists() else '0.74.0')" (joinPath .chezmoi.homeDir ".pi" "agent" "settings.json") | trim }}",
  "librarian": {
    "model": {{ if $isWork }}"anthropic/{{ trimSuffix "[1m]" .claude_code_models.haiku }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
    "thinkingLevel": "off",
    "tools": [
      "search_web",
      "fetch_web"
    ]
  },
  "enabledModels": [
{{- if $isWork }}
    "anthropic/{{ trimSuffix "[1m]" .claude_code_models.opus }}",
    "anthropic/{{ trimSuffix "[1m]" .claude_code_models.sonnet }}",
    "anthropic/{{ trimSuffix "[1m]" .claude_code_models.haiku }}"
{{- else }}
    "{{ .models.anthropic.fable.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.sonnet.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.haiku.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_sol.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}",
    "{{ .models.openai.gpt_luna.agent_harness.aliases.pi }}"
{{- end }}
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": {{ if $isWork }}"anthropic/{{ trimSuffix "[1m]" .claude_code_models.sonnet }}"{{ else }}"{{ .models.openai.gpt_terra.agent_harness.aliases.pi }}"{{ end }},
      "timeoutSecs": 60,
      "prompt": {{ includeTemplate "session-title-prompt" . | toJson }}
    }
  },
  "showLastPrompt": false,
  "powerline": {
    "preset": "minimal",
    "layout": {
      "left": [
        "custom:model_display",
        "custom:workspace_folder",
        "custom:workspace_branch"
      ],
      "right": [
        "custom:context_gauge"
        {{- if .inferenceBudgetUrl }},
        "custom:cost_budget"
        {{- end }}
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "model_display",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_folder",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_branch"
      },
      {
        "id": "context_gauge"
      }
      {{- if .inferenceBudgetUrl }},
      {
        "id": "cost_budget",
        "hideWhenMissing": true
      }
      {{- end }}
    ]
  },
  "powerlineShortcuts": {
    "stashHistory": "alt+shift+s",
    "copyEditor": null,
    "cutEditor": null,
    "jumpPreviousUserMessage": "ctrl+shift+k",
    "jumpNextUserMessage": "ctrl+shift+j",
    "jumpPreviousLlmMessage": null,
    "jumpNextLlmMessage": null,
    "jumpChatBottom": "ctrl+shift+g",
    "scrollChatUp": "alt+k",
    "scrollChatDown": "alt+j",
    "editorStart": null,
    "editorEnd": null
  },
  "packages": [
{{- if $isWork }}
{{- range .piWorkPackages }}
    {{ . | toJson }},
{{- end }}
    "git:github.com/nicobailon/pi-powerline-footer",
    "git:github.com/thurstonsand/pi-permissions",
    "git:github.com/thurstonsand/pi-sessions",
    "git:@github.com/thurstonsand/pi-web-tools",
    "git:github.com/thurstonsand/wt",
    "git:github.com/nicobailon/pi-interview-tool",
    "git:github.com/hazat/glimpse",
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    }
{{- else }}
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-permissions"{{ else }}"npm:pi-permissions"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"npm:pi-sessions"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-librarian"{{ else }}"npm:@thurstonsand/pi-librarian"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/wt/plugins/pi"{{ else }}"npm:@thurstonsand/pi-wt"{{ end }},
    {{- if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-claude-bridge",{{- end }}
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-web-tools"{{ else }}"npm:@thurstonsand/pi-web-tools"{{ end }},
    "npm:glimpseui",
    "npm:pi-interview",
    "npm:pi-mcp-adapter",
    "npm:pi-powerline-footer",
    "npm:sideshow",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "npm:@howaboua/pi-smart-btw"
{{- end }}
  ],
  "hideThinkingBlock": true,
  "theme": "gruvbox-light-hard/gruvbox-dark-hard",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autocompleteMaxVisible": 7
}
