{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{
  "defaultProvider": {{ if $isWork }}"anthropic"{{ else }}"openai-codex"{{ end }},
  "defaultModel": {{ if $isWork }}"{{ trimSuffix "[1m]" .claude_code_models.opus }}"{{ else }}"{{ .models.openai.gpt.version }}"{{ end }},
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "pasteFile": {
    "shortcut": "alt+p"
  },
  "codex": {
    "fast": true,
    "verbosity": "low",
    "reasoningSummary": "auto"
  },
  "glimpse": {
    "companion": {
      "enabled": true
    }
  },
  {{- $pc := dict }}
  {{- if .inferenceBudgetUrl }}
  {{-   $budget := dict "url" .inferenceBudgetUrl }}
  {{-   if .costsDashboardUrl }}{{ $_ := set $budget "costsUrl" .costsDashboardUrl }}{{ end }}
  {{-   $_ := set $pc "budget" $budget }}
  {{- end }}
  {{- if .jiraBrowseUrl }}{{ $_ := set $pc "jira" (dict "browseUrl" .jiraBrowseUrl) }}{{ end }}
  {{- if $pc }}
  "powerlineCustom": {{ toPrettyJson $pc | indent 2 | trim }},
  {{- end }}
  "lastChangelogVersion": "{{ output "python3" "-c" "import json,pathlib,sys; p=pathlib.Path(sys.argv[1]); print(json.loads(p.read_text()).get('lastChangelogVersion','0.74.0') if p.exists() else '0.74.0')" (joinPath .chezmoi.homeDir ".pi" "agent" "settings.json") | trim }}",
  "enabledModels": [
{{- if $isWork }}
    "anthropic/{{ trimSuffix "[1m]" .claude_code_models.opus }}",
    "anthropic/{{ trimSuffix "[1m]" .claude_code_models.sonnet }}",
    "anthropic/{{ trimSuffix "[1m]" .claude_code_models.haiku }}"
{{- else }}
    "{{ .models.anthropic.opus.agent_harness.aliases.pi }}",
    "{{ .models.anthropic.haiku.agent_harness.aliases.pi }}",
    "openai-codex/{{ .models.openai.gpt.version }}",
    "openai-codex/{{ .models.openai.gpt_codex_spark.version }}",
    "{{ .models.openai.gpt_mini.agent_harness.aliases.pi }}",
    "{{ .models.google.gemini_pro.agent_harness.aliases.pi }}",
    "{{ .models.google.gemini_flash.agent_harness.aliases.pi }}"
{{- end }}
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": {{ if $isWork }}"anthropic/{{ trimSuffix "[1m]" .claude_code_models.sonnet }}"{{ else }}"{{ .models.anthropic.sonnet.agent_harness.aliases.pi }}"{{ end }},
      "prompt": {{ includeTemplate "session-title-prompt" . | toJson }}
    }
  },
  "showLastPrompt": false,
  "powerline": {
    "preset": "custom",
    "custom": {
      "separator": "slash",
      "leftSegments": [
        "custom:model_display",
        "custom:workspace_folder",
        "custom:workspace_branch"
      ],
      "rightSegments": [
        "custom:context_gauge"
        {{- if .inferenceBudgetUrl }},
        "custom:cost_budget"
        {{- end }}
      ],
      "secondarySegments": []
    },
    "customItems": [
      {
        "id": "model_display",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_folder",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_branch"
      },
      {
        "id": "context_gauge"
      }
      {{- if .inferenceBudgetUrl }},
      {
        "id": "cost_budget",
        "hideWhenMissing": true
      }
      {{- end }}
    ]
  },
  "powerlineShortcuts": {
    "stashHistory": "alt+shift+s",
    "copyEditor": "ctrl+alt+shift+9",
    "cutEditor": "ctrl+alt+shift+0",
    "jumpPreviousUserMessage": "ctrl+shift+k",
    "jumpNextUserMessage": "ctrl+shift+j",
    "jumpPreviousLlmMessage": "ctrl+alt+shift+8",
    "jumpNextLlmMessage": "ctrl+alt+shift+7",
    "jumpChatBottom": "ctrl+shift+g",
    "scrollChatUp": "alt+k",
    "scrollChatDown": "alt+j",
    "editorStart": "ctrl+alt+shift+6",
    "editorEnd": "ctrl+alt+shift+5"
  },
  "packages": [
{{- if $isWork }}
{{- range .piWorkPackages }}
    {{ . | toJson }},
{{- end }}
    "git:github.com/thurstonsand/pi-powerline-footer@release",
    "git:github.com/thurstonsand/pi-sessions",
    "git:github.com/nicobailon/pi-interview-tool",
    "git:github.com/hazat/glimpse",
    "{{ .chezmoi.homeDir }}/code/pi-web-fetch",
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    }
{{- else }}
    {
      "source": "npm:pi-interactive-shell",
      "skills": [
        "-examples/skills/codex-5-3-prompting/SKILL.md",
        "-examples/skills/codex-cli/SKILL.md",
        "-examples/skills/gpt-5-4-prompting/SKILL.md"
      ],
      "prompts": [
        "-examples/prompts/codex-implement-plan.md",
        "-examples/prompts/codex-review-impl.md",
        "-examples/prompts/codex-review-plan.md"
      ]
    },
    "npm:pi-librarian",
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-powerline-footer"{{ else }}"npm:@thurstonsand/pi-powerline-footer"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"npm:pi-sessions"{{ end }},
    "npm:pi-interview",
{{- if eq .chezmoi.os "darwin" }}
    "npm:glimpseui",
{{- end }}
    "npm:pi-mcp-adapter",
    "npm:@plannotator/pi-extension",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "git:github.com/earendil-works/pi-review",
    "npm:@howaboua/pi-smart-btw"
{{- end }}
  ],
  "hideThinkingBlock": true,
  "theme": "{{ output "sh" "-c" "if [ \"$(cat ~/.terminal-bg 2>/dev/null || echo dark)\" = light ]; then echo gruvbox-light-hard; else echo gruvbox-dark-hard; fi" | trim }}",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autocompleteMaxVisible": 7
}
