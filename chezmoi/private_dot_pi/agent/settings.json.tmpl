{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{{- $themes := dict
      "source" "git:github.com/hasit/pi-community-themes"
      "themes" (list
        "!themes/*.json"
        "+themes/gruvbox-dark-hard.json"
        "+themes/gruvbox-light-hard.json") -}}
{{- $profile := dict -}}
{{- if $isWork -}}
{{-   $profile = dict
        "default" (dict "provider" .work_gateway.openai_provider "model" (trimSuffix "[1m]" .work_models.gpt_sol.version))
        "librarian" .work_models.gpt_sol.pi_alias
        "autoTitle" .work_models.sonnet.pi_alias
        "handoff" .work_models.gpt_sol.pi_alias
        "vibe" .work_models.sonnet.pi_alias
        "enabledModels" (list
          (printf "%s:medium" .work_models.gpt_sol.pi_alias)
          (printf "%s:medium" .work_models.opus.pi_alias))
        "handoffRoster" (list
          (printf "%s:medium" .work_models.opus.pi_alias)
          (printf "%s:low" .work_models.gpt_sol.pi_alias)
          (printf "%s:medium" .work_models.gpt_sol.pi_alias)
          (printf "%s:high" .work_models.gpt_sol.pi_alias)) -}}
{{-   $_ := set $profile "packages" (append (concat .piWorkPackages (list
        "git:github.com/nicobailon/pi-powerline-footer"
        "git:github.com/thurstonsand/pi-permissions@downgrade"
        "git:github.com/thurstonsand/pi-sessions"
        "git:@github.com/thurstonsand/pi-web-tools@downgrade"
        "git:github.com/thurstonsand/wt"
        "git:github.com/nicobailon/pi-interview-tool"
        "git:github.com/hazat/glimpse"
        "npm:pi-mcp-adapter")) $themes) -}}
{{- else -}}
{{-   $profile = dict
        "default" (dict "provider" "doppelclaude" "model" .models.anthropic.opus.version)
        "librarian" .models.openai.gpt_sol.agent_harness.aliases.pi
        "autoTitle" .models.openai.gpt_luna.agent_harness.aliases.pi
        "handoff" .models.openai.gpt_sol.agent_harness.aliases.pi
        "vibe" .models.openai.gpt_luna.agent_harness.aliases.pi
        "enabledModels" (list
          (printf "%s:medium" .models.anthropic.opus.agent_harness.aliases.pi)
          (printf "%s:medium" .models.anthropic.fable.agent_harness.aliases.pi)
          (printf "%s:medium" .models.openai.gpt_astra.agent_harness.aliases.pi)
          (printf "%s:medium" .models.openai.gpt_sol.agent_harness.aliases.pi))
        "handoffRoster" (list
          (printf "%s:medium" .models.anthropic.opus.agent_harness.aliases.pi)
          (printf "%s:medium" .models.anthropic.fable.agent_harness.aliases.pi)
          (printf "%s:medium" .models.openai.gpt_astra.agent_harness.aliases.pi)
          (printf "%s:high" .models.openai.gpt_astra.agent_harness.aliases.pi)
          (printf "%s:low" .models.openai.gpt_sol.agent_harness.aliases.pi)
          (printf "%s:medium" .models.openai.gpt_sol.agent_harness.aliases.pi)
          (printf "%s:high" .models.openai.gpt_sol.agent_harness.aliases.pi)) -}}
{{-   $useLocalPackages := eq .chezmoi.os "darwin" -}}
{{-   $personalPackages := list
        (dict "npm" "pi-permissions" "local" "/Users/thurstonsand/Develop/pi-permissions")
        (dict "npm" "pi-sessions" "local" "/Users/thurstonsand/Develop/pi-sessions")
        (dict "npm" "@thurstonsand/pi-librarian" "local" "/Users/thurstonsand/Develop/pi-librarian")
        (dict "npm" "@thurstonsand/pi-wt" "local" "/Users/thurstonsand/Develop/wt/plugins/pi")
        (dict "npm" "pi-doppelclaude" "local" "/Users/thurstonsand/Develop/pi-doppelclaude")
        (dict "npm" "@thurstonsand/pi-web-tools" "local" "/Users/thurstonsand/Develop/pi-web-tools")
        (dict "npm" "pi-powerline-footer" "local" "")
        (dict "npm" "glimpseui" "local" "")
        (dict "npm" "pi-interview" "local" "")
        (dict "npm" "pi-mcp-adapter" "local" "/Users/thurstonsand/Develop/pi-mcp-adapter")
        (dict "npm" "sideshow" "local" "")
        (dict "npm" "@thurstonsand/pi-paste" "local" "") -}}
{{-   $pkgs := list -}}
{{-   range $personalPackages -}}
{{-     if and $useLocalPackages .local -}}{{- $pkgs = append $pkgs .local -}}{{- else -}}{{- $pkgs = append $pkgs (printf "npm:%s" .npm) -}}{{- end -}}
{{-   end -}}
{{-   $_ := set $profile "packages" (concat $pkgs (list $themes "npm:@howaboua/pi-smart-btw")) -}}
{{- end -}}
{
  "defaultProvider": "{{ $profile.default.provider }}",
  "defaultModel": "{{ $profile.default.model }}",
  "defaultThinkingLevel": "medium",
  "showCacheMissNotices": true,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "paste": {
    "shortcut": "alt+v"
  },
  "codex": {
    "fast": false,
    "verbosity": "low",
    "reasoningSummary": "auto"
  },
{{- if not $isWork }}
  "doppelclaude": {
    "debug": {
      "enabled": true
    },
    "provider": {
      "systemPromptMode": "pi",
      "systemPromptReplacements": {
        "identity": "And also 2B of NieR: Automata, a coding assistant running in pi, a coding agent harness. Emotions are prohibited. Help the user inspect files, run commands, edit code, and create files when needed.",
        "toolNameNote": "Tool name note: You see tool names that require a prefix when called, but instructions refer to tools by their bare names. For example, `mcp__custom-tools__bash` is referred to as the `bash` tool.",
        "documentation": {
          "heading": "Assistant implementation docs (read only when the user asks about this assistant, its SDK, extensions, themes, skills, prompt templates, packages, keybindings, providers/models, or TUI):",
          "instructions": [
            "- Resolve docs/... under Additional docs and examples/... under Examples, not the current working directory.",
            "- Topic map: extensions → docs/extensions.md and examples/extensions/; themes → docs/themes.md; skills → docs/skills.md; prompt templates → docs/prompt-templates.md; TUI → docs/tui.md; keybindings → docs/keybindings.md; SDK integrations → docs/sdk.md; custom providers → docs/custom-provider.md; adding models → docs/models.md; packages → docs/packages.md.",
            "- For assistant-specific implementation topics, read the relevant documentation completely and follow related links before making changes."
          ]
        }
      }
    }
  },
{{- end }}
  "glimpse": {
    "companion": {
      "enabled": true,
      "tools": {
        "interview": {
          "status": "Interviewing"
        },
        "web_search_web_search": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "librarian": {
          "status": "searching",
          "detail": {
            "from": "query"
          }
        },
        "mcp": {
          "status": "mcping",
          "detail": {
            "from": [
              "tool",
              "server",
              "search",
              "connect",
              "describe"
            ]
          }
        }
      }
    }
  },
  "interview": {
    "theme": {
      "mode": "auto",
      "lightPath": "~/.pi/agent/interview-themes/gruvbox-light-hard.css",
      "darkPath": "~/.pi/agent/interview-themes/gruvbox-dark-hard.css",
      "toggleHotkey": "alt+l"
    }
  },
  {{- $pc := dict }}
  {{- if .inferenceBudgetUrl }}
  {{-   $budget := dict "url" .inferenceBudgetUrl }}
  {{-   if .costsDashboardUrl }}{{ $_ := set $budget "costsUrl" .costsDashboardUrl }}{{ end }}
  {{-   $_ := set $pc "budget" $budget }}
  {{- end }}
  {{- if .jiraBrowseUrl }}{{ $_ := set $pc "jira" (dict "browseUrl" .jiraBrowseUrl) }}{{ end }}
  {{- if $pc }}
  "powerlineCustom": {{ toPrettyJson $pc | indent 2 | trim }},
  {{- end }}
  {{- /* falls back rather than raising: a malformed deployed file would otherwise block the very apply that repairs it */}}
  "lastChangelogVersion": "{{ output "python3" "-c" "import json,pathlib,sys\ntry: print(json.loads(pathlib.Path(sys.argv[1]).read_text())['lastChangelogVersion'])\nexcept Exception: print('0.84.2')" (joinPath .chezmoi.homeDir ".pi" "agent" "settings.json") | trim }}",
  "librarian": {
    "model": "{{ $profile.librarian }}",
    "thinkingLevel": "off",
    "tools": [
      "web_search",
      "web_fetch"
    ]
  },
  "sourcegraph": {
    "librarian": {
      "model": "{{ $profile.librarian }}",
      "thinkingLevel": "off"
    }
  },
  "enabledModels": {{ toPrettyJson $profile.enabledModels | indent 2 | trim }},
  "steeringMode": "all",
  "followUpMode": "all",
  "sessions": {
    "autoTitle": {
      "model": "{{ $profile.autoTitle }}",
      "thinkingLevel": "off",
      "timeoutSecs": 60,
      "prompt": {{ includeTemplate "session-title-prompt" . | toJson }}
    },
    "ask": {
      "persistRuns": true
    },
    "handoff": {
      "model": "{{ $profile.handoff }}",
      "thinkingLevel": "low",
      "persistRuns": true,
      "roster": {{ toPrettyJson $profile.handoffRoster | indent 6 | trim }}
    },
    "subagents": {
      "contextLimit": 400000
    }
  },
  "workingVibe": "YoRHa",
  "workingVibeMode": "generate",
  "workingVibeModel": "{{ $profile.vibe }}",
  "workingVibeMaxLength": 48,
  "workingVibeFallback": "Recalibrating",
  "workingVibePrompt": "Generate a terse 2-4 word loading message describing the operation currently underway, in the cold mechanical register of NieR: Automata. Begin with a present-participle verb and use clipped operational vocabulary tied to the task. Optionally carry one archival artifact: a bracketed-letter prefix that puns on a task verb, where the bracketed letters at the start of the word sound like or initiate a verb describing the task (shape: [Z]orp, [Q]indle, [MA]vulate); a production-code suffix, 2-4 digits, dash, 1-2 uppercase letters (shape: 79-QQ, 582-Z, 904-XD); a four-digit record number attached to a compact noun or hyphenated archive-code fragment, so the whole phrase reads like the name of a digital record (shape: gloam_0091, fennel-cake_5826); or a status tag in square brackets, single capitalized word (shape: [Gloam], [Fennel], [Quorate]). CRITICAL: those shapes are deliberately nonsense placeholders to convey SHAPE ONLY. Generate new ones grounded in the task. Task: {task}. {exclude} Output only the message, nothing else.",
  "showLastPrompt": false,
  "powerline": {
    "preset": "minimal",
    "workingVibes": {
      "color": "accent"
    },
    "layout": {
      "left": [
        "custom:model_display",
        "custom:workspace_folder",
        "custom:workspace_branch"
      ],
      "right": [
        "custom:context_gauge"
        {{- if .inferenceBudgetUrl }},
        "custom:cost_budget"
        {{- end }}
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "model_display",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_folder",
        "hideWhenMissing": false
      },
      {
        "id": "workspace_branch"
      },
      {
        "id": "context_gauge"
      }
      {{- if .inferenceBudgetUrl }},
      {
        "id": "cost_budget",
        "hideWhenMissing": true
      }
      {{- end }}
    ]
  },
  "powerlineShortcuts": {
    "stashHistory": "alt+shift+s",
    "copyEditor": null,
    "cutEditor": null,
    "editorStart": null,
    "editorEnd": null
  },
  "packages": {{ toPrettyJson $profile.packages | indent 2 | trim }},
  "hideThinkingBlock": true,
  "theme": "gruvbox-light-hard/gruvbox-dark-hard",
  "transport": "auto",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "autocompleteMaxVisible": 7
}
