{
  "defaultProvider": "openai",
  "defaultModel": "{{ .models.openai.gpt.version }}",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "lastChangelogVersion": "0.62.0",
  "enabledModels": [
    "anthropic/{{ .models.anthropic.opus.version }}",
    "anthropic/{{ .models.anthropic.haiku.version }}",
    "openai/{{ .models.openai.gpt.version }}",
    "openai/{{ .models.openai.gpt_codex_spark.version }}",
    "google/{{ .models.google.gemini_pro.version }}",
    "google/{{ .models.google.gemini_flash.version }}"
  ],
  "steeringMode": "all",
  "followUpMode": "all",
  "powerline": {
    "preset": "custom",
    "showLastPrompt": false,
    "profiles": [
      {
        "model": "anthropic/{{ .models.anthropic.opus.version }}",
        "thinking": "medium",
        "label": "smart"
      },
      {
        "model": "anthropic/{{ .models.anthropic.opus.version }}",
        "thinking": "high",
        "label": "smart"
      },
      {
        "model": "openai/{{ .models.openai.gpt.version }}",
        "thinking": "medium",
        "label": "deep"
      },
      {
        "model": "openai/{{ .models.openai.gpt.version }}",
        "thinking": "high",
        "label": "deep"
      },
      {
        "model": "openai/{{ .models.openai.gpt.version }}",
        "thinking": "xhigh",
        "label": "deep"
      }
    ],
    "vibe": {
      "theme": "NieR:Automata / YoRHa / 2B",
      "mode": "generate",
      "model": "anthropic/{{ .models.anthropic.haiku.version }}",
      "fallback": "Executing mission",
      "refreshInterval": 30,
      "maxLength": 48
    },
    "custom": {
      "separator": "powerline-thin",
      "leftSegments": ["model", "path", "git"],
      "rightSegments": ["context_pct"],
      "secondarySegments": [],
      "options": {
        "model": {
          "showThinkingLevel": false,
          "verbosity": {
            "style": "icon"
          }
        },
        "path": {
          "mode": "basename",
          "maxLength": 60
        },
        "git": {
          "showBranch": true,
          "showStaged": false,
          "showUnstaged": false,
          "showUntracked": false
        }
      }
    }
  },
  "packages": [
    {
      "source": "npm:pi-interactive-shell",
      "skills": [
        "-examples/skills/codex-5-3-prompting/SKILL.md",
        "-examples/skills/codex-cli/SKILL.md",
        "-examples/skills/gpt-5-4-prompting/SKILL.md"
      ],
      "prompts": [
        "-examples/prompts/codex-implement-plan.md",
        "-examples/prompts/codex-review-impl.md",
        "-examples/prompts/codex-review-plan.md"
      ]
    },
    "npm:pi-librarian",
    "npm:pi-verbosity-control",
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-powerline-footer"{{ else }}"git:github.com/thurstonsand/pi-powerline-footer@custom-preset"{{ end }},
    {{ if eq .chezmoi.os "darwin" }}"/Users/thurstonsand/Develop/pi-sessions"{{ else }}"git:github.com/thurstonsand/pi-sessions"{{ end }},
    "git:github.com/davebcn87/pi-autoresearch",
    "npm:glimpseui",
    "npm:@plannotator/pi-extension",
    {
      "source": "git:github.com/hasit/pi-community-themes",
      "themes": [
        "!themes/*.json",
        "+themes/gruvbox-dark-hard.json",
        "+themes/gruvbox-light-hard.json"
      ]
    },
    "npm:@benvargas/pi-openai-fast",
    {
      "source": "npm:shitty-extensions",
      "extensions": [
        "-extensions/cost-tracker.ts",
        "-extensions/flicker-corp.ts",
        "-extensions/funny-working-message.ts",
        "-extensions/handoff.ts",
        "-extensions/loop.ts",
        "-extensions/memory-mode.ts",
        "-extensions/oracle.ts",
        "-extensions/plan-mode.ts",
        "-extensions/speedreading.ts",
        "-extensions/status-widget.ts",
        "-extensions/resistance.ts",
        "-extensions/teletext.ts",
        "+extensions/usage-bar.ts",
        "-extensions/ultrathink.ts"
      ],
      "skills": [
        "-skills/a-nach-b/SKILL.md"
      ]
    }
  ],
  "hideThinkingBlock": true,
  "theme": "{{ output "sh" "-c" "if [ \"$(cat ~/.terminal-bg 2>/dev/null || echo dark)\" = light ]; then echo gruvbox-light-hard; else echo gruvbox-dark-hard; fi" | trim }}",
  "transport": "websocket",
  "collapseChangelog": false,
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default"
}
