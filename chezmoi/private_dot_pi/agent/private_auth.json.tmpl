{{- $authPath := joinPath .chezmoi.homeDir ".pi" "agent" "auth.json" -}}
{{- $isWork := eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
{{- $mergeAuth := `import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
managed = json.loads(sys.argv[2])
managed_keys = set(sys.argv[3:]) | set(managed)
try:
    existing = json.loads(path.read_text())
except FileNotFoundError:
    existing = {}
except json.JSONDecodeError as exc:
    raise SystemExit(f"{path}: invalid JSON; refusing to overwrite unmanaged auth: {exc}") from exc

if not isinstance(existing, dict):
    raise SystemExit(f"{path}: expected top-level JSON object")

merged = dict(managed)
merged.update({key: value for key, value in existing.items() if key not in managed_keys})
print(json.dumps(merged, indent=2))
` -}}
{{- if $isWork -}}
{{ output "python3" "-c" $mergeAuth $authPath "{}" "anthropic" }}
{{- else -}}
{{ output "python3" "-c" $mergeAuth $authPath "{}" "anthropic" "openai" "google" }}
{{- end -}}
