Include ~/.ssh/1Password/config

Host haos
  ForwardAgent yes
  User root
  ProxyCommand ssh-smart-proxy haos 192.168.1.89 22222 haos-ssh.thurstons.house

Host truenas
  ForwardAgent yes
  User admin
  ProxyCommand ssh-smart-proxy truenas 192.168.1.68 22 truenas-ssh.thurstons.house

Host truenas-dev
  Port 2222
  ForwardAgent yes
  User admin
  HostName 192.168.6.227
  SetEnv TERM="xterm-256color"

Host clawdbot
  ForwardAgent yes
  User thurstonsand
  ProxyCommand ssh-smart-proxy clawdbot 192.168.1.90 22 clawdbot-ssh.thurstons.house

Host udmp
  ForwardAgent yes
  User root
  ProxyCommand ssh-smart-proxy udmp 192.168.1.1 22 udmp-ssh.thurstons.house

Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  AddKeysToAgent no
  HashKnownHosts no
{{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
  IdentityAgent ~/.1password/agent.sock
{{- end }}
