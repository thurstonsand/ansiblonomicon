Include ~/.ssh/1Password/config
Include ~/.ssh/config.d/*.conf

# SSH via Cloudflare Tunnel (hostname-based access)
# Uses ssh-smart-proxy: tries local connection first, falls back to cloudflared access ssh

Host glkvm
  HostName 192.168.1.34
  User root
  IdentityFile ~/.ssh/id_ecdsa_glkvm

Host haos
  ForwardAgent yes
  User root
  HostKeyAlias haos
{{- if eq .chezmoi.hostname "openclaw" }}
  IdentityFile ~/.ssh/id_ed25519_nas
{{- end }}
  ProxyCommand ~/.local/libexec/ssh-smart-proxy haos 192.168.1.89 22222 haos-ssh.thurstons.house

Host truenas
  ForwardAgent yes
  User admin
  HostKeyAlias truenas
{{- if eq .chezmoi.hostname "openclaw" }}
  IdentityFile ~/.ssh/id_ed25519_nas
{{- end }}
  ProxyCommand ~/.local/libexec/ssh-smart-proxy truenas 192.168.1.68 22 truenas-ssh.thurstons.house

Host truenas-dev
  Port 2222
  ForwardAgent yes
  User admin
  HostName 192.168.6.227
  SetEnv TERM="xterm-256color"

{{- if ne .chezmoi.hostname "openclaw" }}

Host openclaw
  ForwardAgent yes
  User thurstonsand
  HostKeyAlias openclaw
{{- if eq .chezmoi.os "darwin" }}
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m
{{- end }}
  ProxyCommand ~/.local/libexec/ssh-smart-proxy openclaw 192.168.1.90 22 openclaw-ssh.thurstons.house

Host openclaw-gty
  ForwardAgent yes
  User thurstonsand
  HostKeyAlias openclaw
  ProxyCommand cloudflared access ssh --hostname openclaw-ssh.thurstons.house

{{- end }}

Host udmp
  ForwardAgent yes
  User root
  HostKeyAlias udmp
  ProxyCommand ~/.local/libexec/ssh-smart-proxy udmp 192.168.1.1 22 udmp-ssh.thurstons.house

Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  AddKeysToAgent no
  HashKnownHosts no
{{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
