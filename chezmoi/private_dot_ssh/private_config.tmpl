Include ~/.ssh/1Password/config
Include ~/.ssh/config.d/*.conf

# SSH via Cloudflare Tunnel (hostname-based access)
# Uses ssh-smart-proxy: tries local connection first, falls back to cloudflared access ssh

Host pod042-kvm
  HostName 10.10.10.34
  User root
  HostKeyAlias pod042-kvm
  IdentityFile ~/.ssh/id_ecdsa_glkvm

Host haos
  ForwardAgent yes
  User root
  HostKeyAlias haos
  ProxyCommand ~/.local/libexec/ssh-smart-proxy haos 192.168.1.89 22222 haos-ssh.thurstons.house

{{- if eq .chezmoi.hostname "pod042" }}
Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes

{{- end }}
{{- if ne .chezmoi.hostname "pod042" }}

Host pod042
  HostName 10.10.10.42
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  RequestTTY yes

Host pod042-remote
  HostName pod042-ssh.thurstons.house
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  ProxyCommand cloudflared access ssh --hostname %h
  RequestTTY yes

Host pod042-ts
  HostName 100.64.249.18
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  RequestTTY yes

Host pod042-kvm-ts
  HostName 100.112.38.64
  User root
  HostKeyAlias pod042-kvm
  IdentityFile ~/.ssh/id_ecdsa_glkvm
  IdentitiesOnly yes

{{- end }}

Host udmp
  HostName 10.10.20.1
  User root
  HostKeyAlias udmp

Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  AddKeysToAgent no
  HashKnownHosts no
{{- if eq .chezmoi.os "darwin" }}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
