# .zshrc - Interactive shell configuration
# Note: _evalcache and PATH are defined in .zshenv

# Completion initialization
# Only regenerate .zcompdump if it's older than 24 hours
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qNmh+24) ]]; then
  compinit
else
  compinit -C  # Skip security check for faster startup
fi

# History settings
HISTSIZE=50000
SAVEHIST=50000
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FCNTL_LOCK
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# Shell options
setopt EXTENDED_GLOB        # treat #, ~, and ^ as part of patterns
setopt INTERACTIVE_COMMENTS # allow comments in interactive shells
setopt NOTIFY               # report background job status immediately
unsetopt LIST_BEEP          # no beep on ambiguous completion

# Emacs-style key bindings
bindkey -e
bindkey "^[[3~" delete-char
bindkey "^U" backward-kill-line
bindkey -r -M emacs '^[a'

{{- if eq .chezmoi.os "darwin" }}
# Autosuggestions (via Homebrew)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null || :
{{- else }}
# Autosuggestions
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null || :
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Syntax highlighting (via Homebrew)
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null || :
{{- else }}
# Syntax highlighting
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null || :
{{- end }}
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern line cursor root)

# eza integration (ls replacement)
if command -v eza &>/dev/null; then
  alias ls='eza --icons=auto --git'
  alias la='eza --icons=auto --git -la'
  alias ll='eza --icons=auto --git -l'
  alias lt='eza --icons=auto --git --tree'
fi

# Initialize tools with caching (interactive only)
if [[ -o interactive ]]; then
  _evalcache fzf --zsh
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  [ -f /opt/homebrew/etc/profile.d/autojump.sh ] && . /opt/homebrew/etc/profile.d/autojump.sh
  # Mirror zoxide's `--cmd cd`: prefer literal dirs, fall through to autojump's `j`.
  cd() {
    if [[ $# -eq 0 ]]; then
      builtin cd ~
    elif [[ $# -eq 1 ]] && { [[ -d "$1" ]] || [[ "$1" = '-' ]] || [[ "$1" =~ ^[-+][0-9]+$ ]]; }; then
      builtin cd "$1"
    elif [[ $# -eq 2 ]] && [[ "$1" = '--' ]]; then
      builtin cd "$2"
    else
      j "$@"
    fi
  }
{{- else }}
  _evalcache zoxide init zsh --cmd cd
{{- end }}
  if [[ $TERM != "dumb" ]]; then
    _evalcache starship init zsh
  fi
fi
_evalcache bun completions
_evalcache sessions shell zsh
_evalcache direnv hook zsh
_evalcache mise activate zsh
{{- if eq .chezmoi.hostname "Thurstons-MacBook-Pro" }}
_evalcache shp completion zsh
{{- end }}
{{- if eq .chezmoi.hostname "clawdbot" }}
_evalcache openclaw completion --shell zsh
{{- end }}

# Aliases
if command -v prettyping &>/dev/null; then
  alias ping='prettyping'
fi
alias top='htop'
alias lg='lazygit'
alias vi='nvim'
alias vim='nvim'

{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
claude() {
  command claude \
    --plugin-dir ~/code/claude-code-plugin-auto-title \
    --plugin-dir ~/code/claude-code-plugin-sourcegraph \
    "$@"
}
{{- else if eq .chezmoi.hostname "openclaw" }}
claude() {
  command claude --dangerously-skip-permissions "$@"
}
{{- else }}
claude() {
  command claude --dangerously-skip-permissions "$@"
}
{{- end }}

source ~/.config/zsh/tmux-theme.zsh 2>/dev/null || :


{{- if eq .chezmoi.hostname "clawdbot" }}
ideoc() {
  local session="openclaw"

  if [[ -n "$TMUX" ]]; then
    if [[ "$(tmux display-message -p '#{session_name}')" == "$session" ]]; then
      echo "Already in session '$session'"
    else
      echo "Already inside tmux session '$(tmux display-message -p '#{session_name}')'. Detach first."
    fi
    return 1
  fi

  if [[ "$1" == "--recreate" ]]; then
    tmux kill-session -t "$session" 2>/dev/null
  fi

  if tmux has-session -t "$session" 2>/dev/null; then
    tmux attach -t "$session"
  else
    local ansi_hash
    ansi_hash=$(printf '%s' "$HOME/code/ansiblonomicon" | shasum | cut -c1-8)
    local home_hash
    home_hash=$(printf '%s' "$HOME" | shasum | cut -c1-8)

    tmux new-session -d -s "$session" -n ansiblonomicon -c ~/code/ansiblonomicon
    tmux new-window -t "$session" -n ansi_agent -c ~/code/ansiblonomicon
    tmux set-option -w -t "$session":ansi_agent @cwd_hash "$ansi_hash"
    tmux new-window -t "$session" -n home -c ~
    tmux new-window -t "$session" -n home_agent -c ~
    tmux set-option -w -t "$session":home_agent @cwd_hash "$home_hash"
    tmux select-window -t "$session":ansiblonomicon
    (sleep 1.0 && \
      pane_cmd=$(tmux list-panes -t "$session":ansiblonomicon -F '#{pane_current_command}' 2>/dev/null) && \
      [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]] && \
      tmux send-keys -t "$session":ansiblonomicon "nvim ." Enter
    ) &!
    (sleep 5.0 && \
      pane_cmd=$(tmux list-panes -t "$session":home -F '#{pane_current_command}' 2>/dev/null) && \
      [[ "$pane_cmd" == "zsh" || "$pane_cmd" == "bash" ]] && \
      tmux send-keys -t "$session":home "nvim ." Enter
    ) &!
    tmux attach -t "$session"
  fi
}

if [[ -n "$SSH_CONNECTION" && -z "$TMUX" && $- == *i* ]]; then
  ideoc
fi
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
alias bd='brew desc'
alias bh='brew home'
{{- end }}

# Machine-local overrides (work integrations, extra aliases)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
{{- if ne .chezmoi.hostname "ML-DFC6YK6VJQ" }}

# Agent CLI integrations
alias opencode='$HOME/.opencode/bin/opencode'

{{- end }}
