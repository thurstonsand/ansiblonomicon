{{- /* Helper template to generate VS Code customOAIModels JSON object */ -}}
{{- /* Usage: {{ template "vscode-models" .models }} */ -}}
{{- /* Iterates models.* where vscode.include is true, plus variants with vscode: true */ -}}
{{- /* Input: the models object containing anthropic, openai, google keys */ -}}
{{- /* Anthropic models */ -}}
{{- range $key, $model := .anthropic -}}
{{- $vscode := index $model "vscode" -}}
{{- if and $vscode $vscode.include }}
    "{{ $model.version }}": {
      "name": "{{ $model.display_name }}",
      "url": "https://aig.thurstons.house/v1",
      "toolCalling": true,
      "vision": {{ $model.vision }},
      "thinking": {{ $vscode.thinking }},
      "maxInputTokens": {{ $model.max_input }},
      "maxOutputTokens": {{ $model.max_output }},
      "requiresAPIKey": true,
    },
{{- end -}}
{{- end -}}
{{- /* OpenAI models */ -}}
{{- range $key, $model := .openai -}}
{{- $vscode := index $model "vscode" -}}
{{- if and $vscode $vscode.include }}
    "{{ $model.version }}": {
      "name": "{{ $model.display_name }}",
      "url": "https://aig.thurstons.house/v1",
      "toolCalling": true,
      "vision": {{ $model.vision }},
      "thinking": {{ $vscode.thinking }},
      "maxInputTokens": {{ $model.max_input }},
      "maxOutputTokens": {{ $model.max_output }},
      "requiresAPIKey": true,
    },
{{- end -}}
{{- /* OpenAI variants */ -}}
{{- $variants := index $model "variants" -}}
{{- if $variants -}}
{{- range $vkey, $variant := $variants -}}
{{- if $variant.vscode }}
    "{{ $variant.id }}": {
      "name": "{{ $variant.display_name }}",
      "url": "https://aig.thurstons.house/v1",
      "toolCalling": true,
      "vision": {{ $model.vision }},
      "thinking": {{ $vscode.thinking }},
      "maxInputTokens": {{ $model.max_input }},
      "maxOutputTokens": {{ $model.max_output }},
      "requiresAPIKey": true,
    },
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- /* Google models */ -}}
{{- range $key, $model := .google -}}
{{- $vscode := index $model "vscode" -}}
{{- if and $vscode $vscode.include }}
    "{{ $model.version }}": {
      "name": "{{ $model.display_name }}",
      "url": "https://aig.thurstons.house/v1",
      "toolCalling": true,
      "vision": {{ $model.vision }},
      "thinking": {{ $vscode.thinking }},
      "maxInputTokens": {{ $model.max_input }},
      "maxOutputTokens": {{ $model.max_output }},
      "requiresAPIKey": true,
    },
{{- end -}}
{{- end -}}
