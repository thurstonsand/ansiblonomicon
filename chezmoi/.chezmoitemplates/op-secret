{{- $envVar := index . 0 -}}
{{- $opRef := index . 1 -}}
{{- $opAccountPrefix := "PQ7X5" -}}
{{- if gt (len .) 2 -}}
{{- $opAccountPrefix = index . 2 -}}
{{- end -}}
{{- $val := env $envVar -}}
{{- if $val -}}
{{- $val -}}
{{- else if env "OP_SERVICE_ACCOUNT_TOKEN" -}}
{{- output "op" "read" "--no-newline" $opRef -}}
{{- else -}}
{{- $accounts := output "op" "account" "list" "--format=json" -}}
{{- $opAccount := output "jq" "-nr" "--argjson" "accounts" $accounts "--arg" "prefix" $opAccountPrefix "$accounts | map(select(.account_uuid | startswith($prefix))) | if length == 1 then .[0].account_uuid else error(\"expected one matching 1Password account\") end" -}}
{{- output "op" "read" "--no-newline" "--account" $opAccount $opRef -}}
{{- end -}}
