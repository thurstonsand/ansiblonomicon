# .zprofile - Login shell configuration
# Loaded once per login shell (before .zshrc)
# Note: _evalcache and PATH are defined in .zshenv

{{- if eq .chezmoi.os "darwin" }}

# Homebrew shell environment
_evalcache /opt/homebrew/bin/brew shellenv

# Ensure local bins and mise shims take precedence over Homebrew formulas.
typeset -U path
path=("$HOME/.local/bin" "$HOME/.local/share/mise/shims" $path)
{{- if ne .chezmoi.hostname "ML-DFC6YK6VJQ" }}

# OrbStack shell integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
{{- end }}
{{- end }}

{{- if eq .chezmoi.hostname "clawdbot" }}

# Regenerate clawdbot MOTD tagline on login (detached from TTY)
( setsid update-motd-tagline &>/dev/null & )
{{- end }}
