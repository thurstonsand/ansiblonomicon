# CLI Proxy models - routes through https://aig.thurstons.house
{{- range $key, $model := .models.anthropic }}
{{- $vscode := index $model "vscode" }}
{{- if and $vscode $vscode.include }}
- model_id: {{ $model.display_name }}
  model_name: {{ $model.version }}
  api_base: https://aig.thurstons.house/v1
  api_key_name: llm-api-key
  headers:
    CF-Access-Client-Id: {{ secret "CF_ACCESS_CLIENT_ID" }}
    CF-Access-Client-Secret: {{ secret "CF_ACCESS_CLIENT_SECRET" }}
{{- end }}
{{- end }}
{{- range $key, $model := .models.openai }}
{{- $vscode := index $model "vscode" }}
{{- if and $vscode $vscode.include }}
- model_id: {{ $model.display_name }}
  model_name: {{ $model.version }}
  api_base: https://aig.thurstons.house/v1
  api_key_name: llm-api-key
  headers:
    CF-Access-Client-Id: {{ secret "CF_ACCESS_CLIENT_ID" }}
    CF-Access-Client-Secret: {{ secret "CF_ACCESS_CLIENT_SECRET" }}
{{- end }}
{{- $variants := index $model "variants" }}
{{- if $variants }}
{{- range $vkey, $variant := $variants }}
{{- if $variant.vscode }}
- model_id: {{ $variant.display_name }}
  model_name: {{ $variant.id }}
  api_base: https://aig.thurstons.house/v1
  api_key_name: llm-api-key
  headers:
    CF-Access-Client-Id: {{ secret "CF_ACCESS_CLIENT_ID" }}
    CF-Access-Client-Secret: {{ secret "CF_ACCESS_CLIENT_SECRET" }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
