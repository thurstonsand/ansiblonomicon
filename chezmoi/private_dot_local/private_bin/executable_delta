#!/bin/bash
# Delta wrapper that auto-detects macOS light/dark mode
# Passes through to the real delta binary with the appropriate theme

# Real delta location (installed via homebrew)
real_delta="/opt/homebrew/bin/delta"

if [ ! -x "$real_delta" ]; then
  echo "Error: delta not found at $real_delta" >&2
  exit 1
fi

# Detect macOS dark mode (AppleInterfaceStyle exists = dark mode)
if defaults read -g AppleInterfaceStyle &>/dev/null; then
  exec "$real_delta" --dark "$@"
else
  exec "$real_delta" --light "$@"
fi
