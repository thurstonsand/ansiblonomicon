#!/usr/bin/env bash
# Git SSH signing wrapper using 1Password CLI
# Mimics op-ssh-sign behavior for Linux systems without 1Password desktop app

set -euo pipefail

KEY_REF="op://Private/Git SSH Key/private key"
TEMP_KEY=$(mktemp)
trap 'rm -f "$TEMP_KEY" "${TEMP_KEY}.pub"' EXIT

# Extract private key from 1Password
op read "$KEY_REF" > "$TEMP_KEY"
chmod 600 "$TEMP_KEY"

# Generate public key (ssh-keygen needs <key>.pub to exist)
ssh-keygen -y -f "$TEMP_KEY" > "${TEMP_KEY}.pub"

# Git calls: op-ssh-sign -Y sign -n git -f <pubkey-file> -U <file-to-sign>
# -U means "use agent" - we need to remove it and use our private key instead
args=()
skip_next=false

for arg in "$@"; do
    if $skip_next; then
        skip_next=false
        continue
    fi

    case "$arg" in
        -f)
            # Replace -f <pubkey> with -f <our-private-key>
            args+=("-f" "$TEMP_KEY")
            skip_next=true
            ;;
        -U)
            # Skip -U (agent mode) - we're using file-based signing
            ;;
        *)
            args+=("$arg")
            ;;
    esac
done

ssh-keygen "${args[@]}"
