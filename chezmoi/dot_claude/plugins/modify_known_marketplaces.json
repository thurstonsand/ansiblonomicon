#!/bin/bash
# Ensures only required marketplaces exist, preserving their runtime fields.
# Local-only entries show as deletions in `chezmoi diff` — import them before applying!

set -euo pipefail

required='{
  "thurstons-skills": {"source": {"source": "git", "url": "git@github.com:thurstonsand/thurstons-claude-skills.git"}},
  "claude-code-plugins": {"source": {"source": "github", "repo": "anthropics/claude-code"}},
  "agent-skill-creator": {"source": {"source": "github", "repo": "FrancyJGLisboa/agent-skill-creator"}}
}'

current=$(cat)

# If file is empty or doesn't exist, just output required
if [[ -z "$current" || "$current" == "{}" ]]; then
  echo "$required" | jq .
  exit 0
fi

# Build output: only required marketplaces, preserving runtime fields and original key order
required_keys=$(echo "$required" | jq -r 'keys[]')

# Filter to only required keys, update sources, preserve order
echo "$current" | jq --argjson required "$required" --argjson current "$current" '
  # Start with current, keep only required keys
  to_entries | map(select(.key as $k | $required | has($k))) | from_entries |
  # Update source fields
  reduce (keys[]) as $key (.;
    .[$key].source = $required[$key].source
  )
' | jq --argjson required "$required" '
  # Add any missing required keys at the end
  . as $out | $required | to_entries | map(select(.key as $k | $out | has($k) | not)) | from_entries | $out + .
'
