{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "mcp__parallel-search__web_search_preview",
      "mcp__parallel-search__web_fetch",
      "Skill(updating-documentation-for-changes)",
      "Skill(git-commit-helper)"
    ],
    "deny": ["Read(**/.env)", "Read(**/.env.*)"],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh --gauge --folder --branch --model --style"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/force-ask-patterns.mjs"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 99999,
  "sandbox": {
    "excludedCommands": [
      "python3 ~/.claude/scripts/rename-session.py:*"
    ]
  },
  "outputStyle": "2B",
  "alwaysThinkingEnabled": true,
  "autoDreamEnabled": true,
  "showTurnDuration": true,
  "skipDangerousModePermissionPrompt": true,
  "voiceEnabled": true
}
