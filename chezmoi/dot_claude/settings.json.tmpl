{{- $baseRel := ".chezmoitemplates/claude-settings.json" -}}
{{- $base := joinPath .chezmoi.sourceDir $baseRel -}}
{{- $resolver := joinPath .chezmoi.sourceDir ".chezmoitemplates/local/resolve-overlay.py" -}}
{{- if stat $resolver -}}
{{-   output "python3" $resolver $base -}}
{{- else -}}
{{-   include $baseRel -}}
{{- end -}}
