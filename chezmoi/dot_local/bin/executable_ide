#!/usr/bin/env bash
set -euo pipefail

# Opens an IDE-style Ghostty split: nvim on the left, optional command on the right.
# Usage: ide [--cwd cwd] [command...]

[[ ${TERM_PROGRAM-} == "ghostty" ]] || {
  echo "ide: Ghostty only." >&2
  exit 1
}

command -v gty >/dev/null 2>&1 || {
  echo "ide: gty is not installed." >&2
  exit 1
}

terminal_count=$(gty tab-terminal-count 2>/dev/null) || exit 1
[[ "$terminal_count" == "1" ]] || {
  echo "ide: expected a fresh tab with exactly one terminal." >&2
  exit 1
}

quote() {
  printf '%q' "$1"
}

wait_for_ready() {
  local label=$1

  if read -r -t 8 _ready <&3; then
    return 0
  fi

  echo "ide: timed out waiting for $label." >&2
  return 1
}

cwd=$(pwd -P)
if [[ ${1:-} == "--cwd" || ${1:-} == "-C" ]]; then
  (($# >= 2)) || {
    echo "ide: ${1} requires a directory." >&2
    exit 1
  }
  cwd=$2
  shift 2
fi
[[ -d $cwd ]] || {
  echo "ide: cwd does not exist: $cwd" >&2
  exit 1
}

ready_fifo=$(mktemp -t ghostty-ide-ready.XXXXXX)
rm -f "$ready_fifo"
mkfifo "$ready_fifo"
exec 3<>"$ready_fifo"
trap 'exec 3>&- 3<&-; rm -f "$ready_fifo"' EXIT

editor_inner="if gty terminal-id >/dev/null; then printf 'ready\\n' > $(quote "$ready_fifo"); else echo 'ide: failed to register Ghostty terminal' >&2; fi; nvim .; exec /bin/zsh -il"
editor_cmd=$(quote "$editor_inner")

gty split left --cwd "$cwd" --command "/bin/zsh -ilc $editor_cmd" --focus new --wait
wait_for_ready "editor terminal registration"
gty resize right --percent 15 --wait
cols=$(tput cols 2>/dev/null || echo 0)
((cols < 200)) && gty zoom --wait

if (($# > 0)); then
  cd "$cwd"
  "$@"
fi
