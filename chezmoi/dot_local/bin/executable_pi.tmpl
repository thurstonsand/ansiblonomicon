#!/usr/bin/env zsh
set -euo pipefail

# Pin node to $HOME's version, independent of any per-directory mise selection.
pi_node="${PI_NODE:-$(mise which -C "$HOME" node)}"

if [[ ! -x "$pi_node" ]]; then
  print -u2 "pi: node is not executable: $pi_node"
  exit 127
fi

# Pi and its extensions may spawn node/npm from PATH. Put $HOME's selected
# node first so repo-specific mise versions cannot break global module lookup.
path=("${pi_node:h}" $path)

{{ if eq .chezmoi.hostname "ML-DFC6YK6VJQ" -}}
# pi is a self-contained bun binary in libexec via the pi_release role.
pi_bin="$HOME/.local/libexec/pi"
pi_command=("$pi_bin")
{{- else -}}
# pi is an npm package installed next to the selected node.
pi_bin="${pi_node:h}/pi"
pi_command=("$pi_node" "$pi_bin")
{{- end }}

if [[ ! -e "$pi_bin" ]]; then
  print -u2 "pi: pi binary not found: $pi_bin"
  exit 127
fi

exec "${pi_command[@]}" "$@"
