#!/usr/bin/env bash
# 1Password CLI wrapper with auto-authentication

set -euo pipefail

OP_PASSWORD_FILE="${OP_PASSWORD_FILE:-$HOME/.op-password}"
OP_REAL_BIN="${OP_REAL_BIN:-/usr/bin/op}"

if [[ -z "$OP_REAL_BIN" || ! -x "$OP_REAL_BIN" ]]; then
    echo "Error: Cannot find real op binary" >&2
    exit 1
fi

# Check for valid session by trying a simple op command
if ! "$OP_REAL_BIN" vault list &>/dev/null; then
    if [[ ! -f "$OP_PASSWORD_FILE" ]]; then
        echo "Error: Password file not found at $OP_PASSWORD_FILE" >&2
        echo "Create it with: echo 'your-password' > $OP_PASSWORD_FILE && chmod 600 $OP_PASSWORD_FILE" >&2
        exit 1
    fi

    signin_output=$(cat "$OP_PASSWORD_FILE" | "$OP_REAL_BIN" signin 2>/dev/null)

    if [[ -z "$signin_output" ]]; then
        echo "Error: Failed to sign in to 1Password" >&2
        exit 1
    fi

    eval "$signin_output"
fi

"$OP_REAL_BIN" "$@"
