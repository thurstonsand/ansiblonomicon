#!/usr/bin/env bash
set -euo pipefail

pi_node="${PI_NODE:-$(mise which -C "$HOME" node)}"
pi_bin="$(dirname "$pi_node")/pi"

if [[ ! -x "$pi_node" ]]; then
  echo "pi: node is not executable: $pi_node" >&2
  exit 127
fi

if [[ ! -e "$pi_bin" ]]; then
  echo "pi: pi is not installed next to selected node: $pi_bin" >&2
  exit 127
fi

exec "$pi_node" "$pi_bin" "$@"
