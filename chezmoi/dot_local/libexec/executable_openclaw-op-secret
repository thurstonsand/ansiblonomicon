#!/usr/bin/env python3
import json
import subprocess
import sys

try:
    request = json.load(sys.stdin)
except Exception as exc:
    print(
        json.dumps(
            {
                "protocolVersion": 1,
                "values": {},
                "errors": {"request": {"message": str(exc)}},
            }
        )
    )
    sys.exit(0)

ids = request.get("ids")
if request.get("protocolVersion") != 1 or not isinstance(ids, list):
    print(
        json.dumps(
            {
                "protocolVersion": 1,
                "values": {},
                "errors": {"request": {"message": "invalid request"}},
            }
        )
    )
    sys.exit(0)

values = {}
errors = {}
for secret_id in ids:
    if not isinstance(secret_id, str) or not secret_id.startswith("op://"):
        errors[str(secret_id)] = {"message": "id must be an op:// reference"}
        continue
    try:
        result = subprocess.run(
            ["/opt/homebrew/bin/op", "read", secret_id],
            check=True,
            capture_output=True,
            text=True,
            timeout=20,
        )
    except Exception as exc:
        errors[secret_id] = {"message": str(exc)}
        continue
    values[secret_id] = result.stdout.rstrip("\r\n")

print(json.dumps({"protocolVersion": 1, "values": values, "errors": errors}))
