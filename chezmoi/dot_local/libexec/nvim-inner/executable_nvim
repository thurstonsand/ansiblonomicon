#!/bin/bash
set -euo pipefail

if [[ -z "${NVIM_OUTER_SERVER:-}" ]]; then
  echo "nvim inner editor: NVIM_OUTER_SERVER is not set" >&2
  exit 2
fi

if [[ -z "${NVIM_REAL_BIN:-}" ]]; then
  echo "nvim inner editor: NVIM_REAL_BIN is not set" >&2
  exit 2
fi

"$NVIM_REAL_BIN" --server "$NVIM_OUTER_SERVER" --remote-send '<C-\\><C-N>q' >/dev/null 2>&1 || true
exec "$NVIM_REAL_BIN" --server "$NVIM_OUTER_SERVER" --remote "$@"
