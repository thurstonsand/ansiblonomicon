#!/bin/bash
# Smart editor wrapper - detects IDE terminal and uses matching editor,
# otherwise falls back to nvim
#
# Bundle IDs:
#   com.microsoft.VSCode         - VS Code
#   com.microsoft.VSCodeInsiders - VS Code Insiders
#   com.todesktop.230313mzl4w4u92 - Cursor
#   com.exafunction.windsurf     - Windsurf
#   com.google.antigravity       - Antigravity
#   dev.zed.Zed                  - Zed

_nvim() {
  local args=()
  for arg in "$@"; do
    [[ "$arg" != "--wait" ]] && args+=("$arg")
  done
  exec nvim "${args[@]}"
}

# __CFBundleIdentifier persists in multiplexers after reattaching from a
# different terminal, causing false matches (e.g. Zed's bundle ID
# sticking around in a tmux session reattached from Ghostty).
case "$TERM_PROGRAM" in
  tmux|screen|zellij) _nvim "$@" ;;
esac

case "$__CFBundleIdentifier" in
  com.microsoft.VSCode)
    exec code "$@" ;;
  com.microsoft.VSCodeInsiders)
    exec code-insiders "$@" ;;
  com.todesktop.*)
    exec cursor "$@" ;;
  com.exafunction.windsurf)
    exec windsurf "$@" ;;
  com.google.antigravity)
    exec antigravity "$@" ;;
  dev.zed.Zed)
    exec zed "$@" ;;
esac

if [[ "$TERM_PROGRAM" == "vscode" ]] || [[ -n "$VSCODE_GIT_ASKPASS_NODE" ]]; then
  exec code "$@"
fi

_nvim "$@"
