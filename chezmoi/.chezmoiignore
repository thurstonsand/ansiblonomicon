# Files to ignore based on platform
# Syntax: Go template conditionals around glob patterns

# Git client configuration is owned by the native mise git-client capability.
.config/git/config
.config/git/personal.inc
.config/git/allowed_signers
.config/git/attributes
.config/git/ignore

# Jujutsu configuration is owned by the native mise jj-client capability.
.config/jj/config.toml

# Shell startup and static tool configuration are owned by native mise.
.zshenv
.zprofile
.zshrc
.config/starship.toml
.config/direnv/direnv.toml
.local/bin/cleanh

# Terminal configuration and helpers are owned by native mise.
.config/tmux/
.config/ghostty/
.config/nvim/
.config/uv/
.config/pip/
.local/bin/delta
.local/bin/ide
.local/bin/ideo

# Shared CLI configuration and helpers are owned by native mise. These guards
# are unconditional so private work sources cannot reclaim the same paths.
.config/gh/config.yml
.config/lazygit/config.yml
.rustup/settings.toml
.sourcekit-lsp/config.json
.vimrc
.markdownlint-cli2.yaml
.local/libexec/tab-title.py
.local/libexec/hunk/nvim
.local/bin/fnox-host
.local/bin/mcp-credentials

# macOS-only scripts - ignore on non-Darwin
{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin/**
.config/linearmouse/
.config/nextdns.conf
.local/bin/btt-paste-image.sh
.mactop/
Library/
{{ end }}

# Linux-only files - ignore on non-Linux
{{ if ne .chezmoi.os "linux" }}
# (none yet)
{{ end }}

