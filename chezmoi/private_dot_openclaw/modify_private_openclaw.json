{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if (.chezmoi.stdin | trim) -}}
{{-   $current = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $overlay := includeTemplate ".chezmoitemplates/openclaw-client-config.json.tmpl" . | fromJson -}}
{{- mergeOverwrite $current $overlay | toPrettyJson }}
