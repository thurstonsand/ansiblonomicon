#     pattern = ["find"],
#     decision = "prompt",
#     justification = "Ask before running find because destructive variants cannot be matched precisely with prefix-only rules.",
#     match = [
#         "find . -delete",
#         "find . -type f -exec rm {} ;",
#         "find . -type f -execdir rm {} ;",
#     ],
# )
