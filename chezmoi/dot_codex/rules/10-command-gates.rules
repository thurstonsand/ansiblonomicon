# Static command gates. Keep `default.rules` available for Codex to append
# one-off allow-prefix approvals that you accept during a session.

# Codex rules match prefixes rather than parsing Git arguments. Commands with
# both read-only and mutating forms are conservatively prompted.
prefix_rule(
    pattern = ["git", [
        "stash",
        "add",
        "commit",
        "push",
        "pull",
        "checkout",
        "switch",
        "restore",
        "reset",
        "clean",
        "rebase",
        "merge",
        "cherry-pick",
        "revert",
        "rm",
        "mv",
        "branch",
        "tag",
    ]],
    decision = "prompt",
    justification = "Ask before mutating git state.",
    match = [
        "git stash push -u",
        "git add .",
        "git commit -m test",
        "git push origin main",
        "git pull --rebase",
        "git checkout main",
        "git switch feature",
        "git restore file.txt",
        "git reset --hard HEAD~1",
        "git clean -fd",
        "git rebase main",
        "git merge feature",
        "git cherry-pick HEAD~1",
        "git revert HEAD",
        "git rm file.txt",
        "git mv old.txt new.txt",
        "git branch feature",
        "git tag v1.0.0",
    ],
    not_match = [
        "git status",
        "git diff --stat",
    ],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "remove", "move", "lock", "unlock", "prune", "repair"]],
    decision = "prompt",
    justification = "Ask before mutating Git worktrees.",
    match = [
        "git worktree add ../feature feature",
        "git worktree remove ../feature",
        "git worktree prune",
    ],
    not_match = ["git worktree list"],
)

prefix_rule(
    pattern = ["git", "submodule", ["add", "absorbgitdirs", "deinit", "foreach", "init", "set-branch", "set-url", "sync", "update"]],
    decision = "prompt",
    justification = "Ask before mutating Git submodules.",
    match = [
        "git submodule add https://example.com/repo.git vendor/repo",
        "git submodule update --init",
        "git submodule deinit vendor/repo",
    ],
    not_match = [
        "git submodule status",
        "git submodule summary",
    ],
)

prefix_rule(
    pattern = ["git", "-C"],
    decision = "prompt",
    justification = "Ask before git commands that target another working tree via -C.",
    match = [
        "git -C /tmp/repo commit -m test",
        "git -C /tmp/repo status",
    ],
)

prefix_rule(
    pattern = ["git", "-c"],
    decision = "prompt",
    justification = "Ask before git commands that override config via -c.",
    match = [
        "git -c core.editor=true commit -m test",
        "git -c color.ui=always status",
    ],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "Ask before recursive forced removal.",
    match = ["rm -rf tmp"],
)

prefix_rule(
    pattern = ["rm", "-fr"],
    decision = "prompt",
    justification = "Ask before recursive forced removal.",
    match = ["rm -fr tmp"],
)

prefix_rule(
    pattern = ["rm", "-r", "-f"],
    decision = "prompt",
    justification = "Ask before recursive forced removal.",
    match = ["rm -r -f tmp"],
)

prefix_rule(
    pattern = ["rm", "-f", "-r"],
    decision = "prompt",
    justification = "Ask before recursive forced removal.",
    match = ["rm -f -r tmp"],
)

prefix_rule(
    pattern = ["rm", "--recursive", "--force"],
    decision = "prompt",
    justification = "Ask before recursive forced removal.",
    match = ["rm --recursive --force tmp"],
)

prefix_rule(
    pattern = ["rm", "--force", "--recursive"],
    decision = "prompt",
    justification = "Ask before recursive forced removal.",
    match = ["rm --force --recursive tmp"],
)

# Execpolicy is prefix-only, so it cannot faithfully express Amp's
# `find *-delete*`, `find *-exec*`, and `find *-execdir*` globs when those
# flags appear later in argv. Prompting on every `find` proved too noisy, so
# this translation is disabled for now.
