# Chezmoi configuration
# This file is a template that generates ~/.config/chezmoi/chezmoi.toml

sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o22

[edit]
  command = "nvim"

[diff]
  pager = "delta"

[secret]
  command = {{ joinPath (dir .chezmoi.sourceDir) "scripts/fnox-host" | quote }}
  args = ["get"]

[data]
  # Machine-specific variables (OS-dependent)
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  developDir = "code"
  aigEnabled = false
{{- else if eq .chezmoi.hostname "Thurstons-MacBook-Pro" }}
  developDir = "Develop"
  aigEnabled = true
{{- else if eq .chezmoi.os "linux" }}
  developDir = "code"
  aigEnabled = true
{{- end }}
