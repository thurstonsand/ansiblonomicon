# Chezmoi configuration
# This file is a template that generates ~/.config/chezmoi/chezmoi.toml

sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o22

[edit]
  command = "code"
  args = ["--wait"]

[diff]
{{- if eq .chezmoi.os "darwin" }}
  pager = "delta"
{{- else }}
  pager = "delta --${TERMINAL_BG:-dark}"
{{- end }}

{{- if or (eq .chezmoi.hostname "clawdbot") (eq .chezmoi.hostname "openclaw") }}
[onepassword]
  command = "/home/thurstonsand/.local/bin/op"
  prompt = false
{{- end }}

[data]
  # Machine-specific variables (OS-dependent)
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  developDir = "code"
  aigEnabled = false
{{- else if eq .chezmoi.hostname "Thurstons-MacBook-Pro" }}
  developDir = "Develop"
  aigEnabled = true
  email = "thurstonsand@gmail.com"
  signingKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF6GpY+hdZp60Fbnk9B03sntiJRx7OgLwutV5vJpV6P+"
{{- else if eq .chezmoi.os "linux" }}
  developDir = "code"
  aigEnabled = true
  email = "thurstonsand@gmail.com"
  signingKey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIF6GpY+hdZp60Fbnk9B03sntiJRx7OgLwutV5vJpV6P+"
{{- end }}
