# Chezmoi configuration
# This file is a template that generates ~/.config/chezmoi/chezmoi.toml

sourceDir = {{ .chezmoi.sourceDir | quote }}
umask = 0o22

[edit]
  command = "code"
  args = ["--wait"]

[diff]
  pager = "delta"

{{- if eq .chezmoi.hostname "openclaw" }}
[onepassword]
  command = "/home/thurstonsand/.local/bin/op"
  prompt = false
  mode = "service"
{{- end }}

[data]
  # Machine-specific variables (OS-dependent)
{{- if eq .chezmoi.hostname "ML-DFC6YK6VJQ" }}
  developDir = "code"
  aigEnabled = false
{{- else if eq .chezmoi.hostname "Thurstons-MacBook-Pro" }}
  developDir = "Develop"
  aigEnabled = true
{{- else if eq .chezmoi.os "linux" }}
  developDir = "code"
  aigEnabled = true
{{- end }}
