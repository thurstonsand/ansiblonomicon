# Homebrew Bundle file (work macOS)
# Run with: brew bundle --file=Brewfile.work

# Local overrides (corporate taps, gitignored)
Dir.glob(File.join(__dir__, "Brewfile.work.*")).sort.each do |f|
  instance_eval(File.read(f))
end

# =============================================================================
# Shell & Terminal
# =============================================================================
brew "autojump"
brew "bat"
brew "direnv"
brew "duti"
brew "fd"
brew "fzf"
brew "htop"
brew "jq"
brew "ripgrep"
brew "starship"
brew "tldr"
brew "tmux"
brew "tree"
brew "unzip"
brew "vim"
brew "zsh-autocomplete"
brew "zsh-syntax-highlighting"

