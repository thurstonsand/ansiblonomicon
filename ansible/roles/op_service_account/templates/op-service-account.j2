#!/bin/sh
set -eu

token_file="${OP_SERVICE_ACCOUNT_TOKEN_FILE:-{{ op_service_account_token_path }}}"
if [ ! -r "$token_file" ]; then
  printf 'op: missing service account token file: %s\n' "$token_file" >&2
  exit 1
fi

OP_SERVICE_ACCOUNT_TOKEN="$(tr -d '\r\n' < "$token_file")"
export OP_SERVICE_ACCOUNT_TOKEN
exec /usr/bin/op "$@"
