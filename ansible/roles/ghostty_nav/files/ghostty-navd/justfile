set shell := ["bash", "-euo", "pipefail", "-c"]

binary := "ghostty-navd"
install_dir := env_var_or_default("HOME", ".") + "/.local/bin"
codesign_identity := "Apple Development: thurstonsand@gmail.com (STSAYQLS39)"
codesign_identifier := "house.thurstons.ghostty-navd"

_default:
    just --list

fmt:
    swiftformat Sources

lint:
    swiftlint lint --strict Sources

check: fmt lint build

build:
    swiftc -O -framework Network -framework AppKit -o {{binary}} Sources/*.swift
    just sign {{binary}}

install:
    mkdir -p {{install_dir}}
    swiftc -O -framework Network -framework AppKit -o {{install_dir}}/{{binary}} Sources/*.swift
    just sign {{install_dir}}/{{binary}}

sign path:
    identity='{{codesign_identity}}'; \
    if ! security find-identity -v -p codesigning | grep -Fq "$identity"; then \
        identity='-'; \
    fi; \
    codesign --force --sign "$identity" --identifier '{{codesign_identifier}}' {{path}}
