[Unit]
Description=Update mise-managed tools
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ system_maintenance_user }}
Environment="HOME={{ system_maintenance_home }}"
Environment="PATH={{ system_maintenance_home }}/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin"
ExecStart={{ system_maintenance_bin_dir }}/update-mise
StandardOutput=journal
StandardError=journal
