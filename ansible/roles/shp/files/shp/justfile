set shell := ["bash", "-euo", "pipefail", "-c"]

binary := "shp"
install_dir := env_var_or_default("HOME", ".") + "/.local/bin"

_default:
    just --list

fmt:
    gofmt -w main.go

lint:
    go tool golangci-lint run ./...

test:
    go test ./...

check: fmt lint test

build:
    go build -o {{binary}} .

install:
    mkdir -p {{install_dir}}
    go build -o {{install_dir}}/{{binary}} .

update-deps:
    go get -u -t ./...
    go get -u -tool github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest
    go mod tidy
