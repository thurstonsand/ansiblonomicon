services:
  arcane:
{% if arcane_override.build_from_source | default(false) %}
    build:
      context: ./source
      dockerfile: docker/Dockerfile
    pull_policy: build
    image: arcane:local-fix
{% else %}
    image: ghcr.io/getarcaneapp/arcane:latest
{% endif %}
    container_name: arcane
    networks:
      personal:
        ipv4_address: {{ lan.personal.arcane.ip }}
    ports:
      - "{{ lan.personal.arcane.ports.web }}:{{ lan.personal.arcane.ports.web }}" # web
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ docker.config_dir }}/arcane/app/data:/app/data
      - /mnt/performance/docker/stacks:/mnt/performance/docker/stacks
    devices:
      - /dev/dri:/dev/dri # Intel iGPU for monitoring
    environment:
      APP_URL: http://{{ lan.personal.arcane.domain }}
      PUID: {{ docker.user.puid }}
      PGID: {{ docker.user.pgid }}
      ENCRYPTION_KEY: "{{ lookup('env', 'ARCANE_ENCRYPTION_KEY') }}"
      JWT_SECRET: "{{ lookup('env', 'ARCANE_JWT_SECRET') }}"
      GPU_MONITORING_ENABLED: "true"
      GPU_TYPE: intel
    restart: unless-stopped

networks:
  personal:
    external: true
