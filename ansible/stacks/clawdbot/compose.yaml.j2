services:
  clawdbot-gateway:
    build:
      context: .
      dockerfile: Dockerfile
    image: clawdbot:local
    container_name: clawdbot-gateway
    restart: unless-stopped
    init: true
    networks:
      personal:
        ipv4_address: {{ lan.personal.clawdbot.ip }}
    ports:
      - "{{ lan.personal.clawdbot.ports.gateway }}:18789" # gateway websocket + webchat
      - "{{ lan.personal.clawdbot.ports.bridge }}:18790" # bridge for mobile nodes
    volumes:
      - {{ docker.config_dir }}/clawdbot-gateway/.clawdbot:/home/node/.clawdbot
      - {{ docker.config_dir }}/clawdbot-gateway/clawd:/home/node/clawd
      - /etc/localtime:/etc/localtime:ro
      # Docker socket for librarian skill (spawning sandbox containers)
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Librarian scripts and Dockerfile
      - {{ docker.config_base }}/stacks/clawdbot/scripts:/opt/clawdbot/scripts:ro
      - {{ docker.config_base }}/stacks/clawdbot/Dockerfile.librarian:/opt/clawdbot/Dockerfile.librarian:ro
      - {{ docker.config_base }}/stacks/clawdbot/skills:/opt/clawdbot/skills:ro
    environment:
      HOME: /home/node
      NODE_ENV: production
      TERM: xterm-256color
      CLAWDBOT_GATEWAY_BIND: lan
      CLAWDBOT_GATEWAY_PORT: "18789"
      CLAWDBOT_BRIDGE_PORT: "18790"
      # Token is loaded from .clawdbot/clawdbot.json after onboarding
      # API keys for agent skills (set in .env file)
      ANTHROPIC_API_KEY: "${ANTHROPIC_API_KEY:-}"
      OPENAI_API_KEY: "${OPENAI_API_KEY:-}"
      GITHUB_TOKEN: "${GITHUB_TOKEN:-}"
      # Librarian config
      LIBRARIAN_IMAGE: clawdbot-librarian:local
      # GOG_KEYRING_PASSWORD for Gmail (set manually if using gog skill)
      XDG_CONFIG_HOME: /home/node/.clawdbot
      # Add librarian to PATH
      PATH: /opt/clawdbot/scripts:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    command:
      - node
      - dist/index.js
      - gateway-daemon
      - --bind
      - lan
      - --port
      - "18789"

networks:
  personal:
    external: true
