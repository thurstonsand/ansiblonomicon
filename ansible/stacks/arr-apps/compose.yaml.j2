services:
  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:latest
    container_name: flaresolverr
    # mac_address: aa:aa:ba:eb:4c:fc
    networks:
      personal:
        ipv4_address: {{ lan.personal.flaresolverr.ip }}
    ports:
      - "{{ lan.personal.flaresolverr.ports.web }}:{{ lan.personal.flaresolverr.ports.web }}" # web
    volumes:
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    # mac_address: aa:bb:ba:ba:8f:f1
    networks:
      personal:
        ipv4_address: {{ lan.personal.prowlarr.ip }}
    ports:
      - "{{ lan.personal.prowlarr.ports.web }}:{{ lan.personal.prowlarr.ports.web }}" # web
    volumes:
      - {{ docker.config_dir }}/prowlarr/config:/config
      - /etc/localtime:/etc/localtime:ro
    environment:
      - PUID={{ docker.user.puid }}
      - PGID={{ docker.user.pgid }}
    restart: unless-stopped

  sonarr:
    image: linuxserver/sonarr:develop
    container_name: sonarr
    # mac_address: aa:88:44:f4:6a:d3
    networks:
      personal:
        ipv4_address: {{ lan.personal.sonarr.ip }}
    ports:
      - "{{ lan.personal.sonarr.ports.web }}:{{ lan.personal.sonarr.ports.web }}" # web
    volumes:
      - /mnt/capacity/watch:/watch
      - {{ docker.config_dir }}/sonarr/config:/config
      - /etc/localtime:/etc/localtime:ro
    environment:
      - PUID={{ docker.user.puid }}
      - PGID={{ docker.user.pgid }}
    restart: unless-stopped

  radarr:
    image: linuxserver/radarr
    container_name: radarr
    # mac_address: aa:fc:67:fd:fb:e8
    networks:
      personal:
        ipv4_address: {{ lan.personal.radarr.ip }}
    ports:
      - "{{ lan.personal.radarr.ports.web }}:{{ lan.personal.radarr.ports.web }}" # web
    volumes:
      - /mnt/capacity/watch:/watch
      - {{ docker.config_dir }}/radarr/config:/config
      - /etc/localtime:/etc/localtime:ro
    environment:
      - PUID={{ docker.user.puid }}
      - PGID={{ docker.user.pgid }}
    restart: unless-stopped

  newtarr:
    image: ghcr.io/elfhosted/newtarr:rolling
    container_name: newtarr
    networks:
      personal:
        ipv4_address: {{ lan.personal.newtarr.ip }}
    ports:
      - "{{ lan.personal.newtarr.ports.web }}:{{ lan.personal.newtarr.ports.web }}" # web
    volumes:
      - {{ docker.config_dir }}/newtarr/config:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped

  swaparr-sonarr:
    image: ghcr.io/thijmengthn/swaparr:latest
    container_name: swaparr-sonarr
    environment:
      - BASEURL=http://{{ lan.personal.sonarr.ip }}:{{ lan.personal.sonarr.ports.web }}
      - APIKEY={{ lookup('env', 'HOMEPAGE_SONARR_API_KEY') }}
      - PLATFORM=sonarr
      - MAX_STRIKES=6
      - SCAN_INTERVAL=30m
      - MAX_DOWNLOAD_TIME=6h
      - IGNORE_ABOVE_SIZE=25GB
      - REMOVE_FROM_CLIENT=true
      - STRIKE_QUEUED=false
      - DRY_RUN=false
    restart: unless-stopped

  swaparr-radarr:
    image: ghcr.io/thijmengthn/swaparr:latest
    container_name: swaparr-radarr
    environment:
      - BASEURL=http://{{ lan.personal.radarr.ip }}:{{ lan.personal.radarr.ports.web }}
      - APIKEY={{ lookup('env', 'HOMEPAGE_RADARR_API_KEY') }}
      - PLATFORM=radarr
      - MAX_STRIKES=6
      - SCAN_INTERVAL=30m
      - MAX_DOWNLOAD_TIME=6h
      - IGNORE_ABOVE_SIZE=25GB
      - REMOVE_FROM_CLIENT=true
      - STRIKE_QUEUED=false
      - DRY_RUN=false
    restart: unless-stopped

  recyclarr:
    image: ghcr.io/recyclarr/recyclarr
    container_name: recyclarr
    user: "{{ docker.user.id }}"
    volumes:
      - {{ docker.config_dir }}/recyclarr/config:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped

  overseerr:
    image: lscr.io/linuxserver/overseerr:latest
    container_name: overseerr
    # mac_address: aa:06:ca:89:9e:df
    networks:
      external:
        ipv4_address: {{ lan.external.overseerr.ip }}
    ports:
      - "{{ lan.external.overseerr.ports.web }}:{{ lan.external.overseerr.ports.web }}" # web
    volumes:
      - {{ docker.config_dir }}/overseerr/config:/config
      - /etc/localtime:/etc/localtime:ro
    environment:
      - PUID={{ docker.user.puid }}
      - PGID={{ docker.user.pgid }}
    restart: unless-stopped

networks:
  personal:
    external: true
  external:
    external: true
