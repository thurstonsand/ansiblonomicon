# yaml-language-server: $schema=https://schemas.recyclarr.dev/v8/config-schema.json
sonarr:
  mainsonarr:
    base_url: http://sonarr.thurstons.house:8989
    api_key: {{ lookup('env', 'SONARR_API_KEY') }}
    delete_old_custom_formats: true
    media_management:
      propers_and_repacks: do_not_prefer
    media_naming:
      season: default
      series: plex-imdb
      episodes:
        rename: true
        standard: default
        daily: default
        anime: default
    quality_definition:
      type: series
      qualities:
        - name: WEBDL-1080p
          min: 5
        - name: WEBRip-1080p
          min: 5
        - name: HDTV-1080p
          min: 5
    quality_profiles:
      - trash_id: d1498e7d189fbe6c7110ceaabb7473e6
        reset_unmatched_scores:
          enabled: true
        upgrade:
          allowed: true
          until_quality: WEB 2160p
          until_score: 10000
        min_format_score: 0
        min_upgrade_format_score: 1
        qualities:
          - name: WEB 2160p
            qualities:
              - WEBDL-2160p
              - WEBRip-2160p
          - name: WEB 1080p
            qualities:
              - WEBDL-1080p
              - WEBRip-1080p
          - name: Bluray-1080p
          - name: HDTV-1080p
