services:
  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    mac_address: aa:be:8f:17:f7:f9
    networks:
      personal:
        ipv4_address: {{ lan.personal.gluetun.ip }}
    ports:
      - "{{ lan.personal.gluetun.ports.control }}:{{ lan.personal.gluetun.ports.control }}/tcp" # control
      - "{{ lan.personal.gluetun.ports.http_proxy }}:{{ lan.personal.gluetun.ports.http_proxy }}/tcp" # http proxy
      - "{{ lan.personal.gluetun.ports.shadowsocks }}:{{ lan.personal.gluetun.ports.shadowsocks }}/tcp" # shadowsocks
      - "{{ lan.personal.gluetun.ports.shadowsocks }}:{{ lan.personal.gluetun.ports.shadowsocks }}/udp" # shadowsocks
      - "{{ lan.personal.gluetun.ports.qbittorrent_web }}:{{ lan.personal.gluetun.ports.qbittorrent_web }}" # qbittorrent web
      - "{{ lan.personal.gluetun.ports.qbittorrent_bt }}:{{ lan.personal.gluetun.ports.qbittorrent_bt }}" # qbittorrent bt
      - "{{ lan.personal.gluetun.ports.qbittorrent_bt }}:{{ lan.personal.gluetun.ports.qbittorrent_bt }}/udp" # qbittorrent bt
    volumes:
      - {{ docker.config_dir }}/gluetun/gluetun:/gluetun
      - /etc/localtime:/etc/localtime:ro
    environment:
      - VPN_TYPE=wireguard
      - VPN_SERVICE_PROVIDER=mullvad
      - WIREGUARD_PRIVATE_KEY={{ lookup('env', 'TORRENT_WIREGUARD_PRIVATE_KEY') }}
      - WIREGUARD_ADDRESSES={{ lookup('env', 'TORRENT_WIREGUARD_ADDRESS') }}
      - SERVER_COUNTRIES=USA
      - SERVER_CITIES=Atlanta GA
      - FIREWALL_OUTBOUND_SUBNETS=192.168.6.0/24
      - UPDATER_PERIOD=24h
      # If gluetun fails to connect with "no server found" after restart, the cached
      # servers.json may be stale. Fix: delete /gluetun/servers.json and restart.
      # To prevent this permanently, uncomment below to disable server caching.
      # Tradeoff: startup then relies on bundled server data in the image, which may
      # be outdated if the gluetun image hasn't been updated recently.
      # - STORAGE_FILEPATH=
      - PUID={{ docker.user.puid }}
      - PGID={{ docker.user.pgid }}
    labels:
      autoheal: "true"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- --timeout=5 https://am.i.mullvad.net/connected | grep -q 'You are connected'"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s
    restart: unless-stopped
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    labels:
      com.getarcaneapp.arcane.depends-on: gluetun
      autoheal: "true"
    user: "{{ docker.user.id }}"
    network_mode: service:gluetun
    volumes:
      - {{ docker.config_dir }}/qbittorrent/config:/config
      - /mnt/capacity/watch:/watch
      - /etc/localtime:/etc/localtime:ro
    environment:
      - WEBUI_PORT={{ lan.personal.gluetun.ports.qbittorrent_web }}
      - PUID={{ docker.user.puid }}
      - PGID={{ docker.user.pgid }}
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q --timeout=5 http://1.1.1.1 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    depends_on:
      - gluetun
    restart: unless-stopped
  mam-updater:
    build:
      context: .
      dockerfile: Dockerfile.mam-updater
    pull_policy: build
    container_name: mam-updater
    labels:
      com.getarcaneapp.arcane.updater: "false"
      com.getarcaneapp.arcane.depends-on: gluetun
    user: "{{ docker.user.id }}"
    network_mode: service:gluetun
    volumes:
      - {{ docker.config_dir }}/mam-updater:/data
      - /etc/localtime:/etc/localtime:ro
    environment:
      - MAM_ID={{ lookup('env', 'TORRENT_MAM_ID') }}
    depends_on:
      - gluetun
    restart: unless-stopped
  autoheal:
    image: willfarrell/autoheal
    container_name: torrent-autoheal
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - AUTOHEAL_CONTAINER_LABEL=autoheal
      - AUTOHEAL_INTERVAL=30
    restart: unless-stopped

networks:
  personal:
    external: true
