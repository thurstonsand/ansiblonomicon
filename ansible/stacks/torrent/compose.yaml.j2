services:
  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    mac_address: aa:be:8f:17:f7:f9
    networks:
      personal:
        ipv4_address: {{ lan.personal.gluetun.ip }}
    ports:
      - "{{ lan.personal.gluetun.ports.control }}:{{ lan.personal.gluetun.ports.control }}/tcp" # control
      - "{{ lan.personal.gluetun.ports.http_proxy }}:{{ lan.personal.gluetun.ports.http_proxy }}/tcp" # http proxy
      - "{{ lan.personal.gluetun.ports.shadowsocks }}:{{ lan.personal.gluetun.ports.shadowsocks }}/tcp" # shadowsocks
      - "{{ lan.personal.gluetun.ports.shadowsocks }}:{{ lan.personal.gluetun.ports.shadowsocks }}/udp" # shadowsocks
      - "{{ lan.personal.gluetun.ports.qbittorrent_web }}:{{ lan.personal.gluetun.ports.qbittorrent_web }}" # qbittorrent web
      - "{{ lan.personal.gluetun.ports.qbittorrent_bt }}:{{ lan.personal.gluetun.ports.qbittorrent_bt }}" # qbittorrent bt
      - "{{ lan.personal.gluetun.ports.qbittorrent_bt }}:{{ lan.personal.gluetun.ports.qbittorrent_bt }}/udp" # qbittorrent bt
    volumes:
      - /mnt/performance/docker/torrent/gluetun/gluetun:/gluetun
      - /etc/localtime:/etc/localtime:ro
    environment:
      - VPN_TYPE=openvpn
      - VPN_SERVICE_PROVIDER=mullvad
      - OPENVPN_USER=${TORRENT_OPENVPN_USER}
      - SERVER_COUNTRIES=USA
      - SERVER_CITIES=Atlanta GA
      - FIREWALL_OUTBOUND_SUBNETS=192.168.6.0/24
      - UPDATER_PERIOD=24h
      - PUID={{ user.puid }}
      - PGID={{ user.pgid }}
    restart: unless-stopped
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    user: "{{ user.id }}"
    network_mode: service:gluetun
    volumes:
      - /mnt/performance/docker/torrent/qbittorrent/config:/config
      - /mnt/capacity/watch:/watch
      - /etc/localtime:/etc/localtime:ro
    environment:
      - WEBUI_PORT={{ lan.personal.gluetun.ports.qbittorrent_web }}
      - PUID={{ user.puid }}
      - PGID={{ user.pgid }}
    depends_on:
      - gluetun
    restart: unless-stopped
  mam-updater:
    build:
      context: .
      dockerfile: Dockerfile.mam-updater
    container_name: mam-updater
    user: "{{ user.id }}"
    network_mode: service:gluetun
    volumes:
      - /mnt/performance/docker/torrent/mam-updater:/data
      - /etc/localtime:/etc/localtime:ro
    environment:
      - MAM_ID=${TORRENT_MAM_ID}
    depends_on:
      - gluetun
    restart: unless-stopped

networks:
  personal:
    external: true
