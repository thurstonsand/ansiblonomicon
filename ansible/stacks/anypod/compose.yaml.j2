services:
  anypod:
    image: ghcr.io/thurstonsand/anypod:nightly
    container_name: anypod
    restart: unless-stopped
    init: true
    networks:
      external:
        ipv4_address: {{ lan.external.anypod.ip }}
    ports:
      - "{{ lan.external.anypod.ports.web }}:{{ lan.external.anypod.ports.web }}" # web
    volumes:
      - /mnt/performance/docker/anypod/config/feeds.yaml:/config/feeds.yaml
      - /mnt/capacity/watch/anypod/data:/data
      - /mnt/performance/docker/anypod/cookies/cookies.txt:/cookies/cookies.txt
      - /etc/localtime:/etc/localtime:ro
    environment:
      # User/Group
      PUID: {{ user.puid }}
      PGID: {{ user.pgid }}
      # Logging configuration
      LOG_FORMAT: json
      LOG_LEVEL: INFO
      LOG_INCLUDE_STACKTRACE: true
      # Server configuration
      SERVER_PORT: {{ lan.external.anypod.ports.web }}
      SINGLE_SERVER_MODE: true
      BASE_URL: https://{{ lan.external.anypod.domain }}
      TRUSTED_PROXIES: '["192.168.1.0/24", "{{ lan.external.cloudflared.ip }}"]'
      COOKIES_PATH: /cookies/cookies.txt
      POT_PROVIDER_URL: http://{{ lan.external.bgutil_pot_provider.ip }}:{{ lan.external.bgutil_pot_provider.ports.api }}
      YT_CHANNEL: nightly
    depends_on:
      - bgutil-pot-provider

  bgutil-pot-provider:
    image: brainicism/bgutil-ytdlp-pot-provider:latest
    container_name: bgutil-pot-provider
    restart: unless-stopped
    networks:
      external:
        ipv4_address: {{ lan.external.bgutil_pot_provider.ip }}
    ports:
      - "{{ lan.external.bgutil_pot_provider.ports.api }}:{{ lan.external.bgutil_pot_provider.ports.api }}" # api

networks:
  external:
    external: true
