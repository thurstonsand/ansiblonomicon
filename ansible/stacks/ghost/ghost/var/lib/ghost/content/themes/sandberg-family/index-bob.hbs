{{!< default}}

<style>
    .section-bob .section-header {
        text-align: center;
        padding: 60px 24px 48px;
        border-bottom: 3px solid #b45309;
    }

    .section-bob .section-header h1 {
        font-size: 2.4rem;
        margin: 0 0 8px;
        letter-spacing: -0.02em;
        color: #b45309;
    }

    .section-bob .section-header p {
        font-size: 1.05rem;
        opacity: 0.6;
        margin: 0 0 20px;
    }

    .section-bob .section-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
    }
</style>

<div class="section-bob" data-section="bob">
    <div class="section-header">
        {{#get "users" filter="slug:bob" limit="1"}}
            {{#foreach .}}
                {{#if profile_image}}
                    <img class="section-avatar" src="{{profile_image}}" alt="{{name}}">
                {{/if}}
            {{/foreach}}
        {{/get}}
        <h1>Bob Sandberg</h1>
        <p>Pedaling the Lewis &amp; Clark Trail from coast to coast.</p>
    </div>

    <main class="gh-main">
        {{> "components/post-list" feed="index" postFeedStyle=@custom.post_feed_style showTitle=false}}
    </main>
</div>
