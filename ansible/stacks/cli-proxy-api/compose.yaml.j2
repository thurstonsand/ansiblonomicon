services:
  cli-proxy-api:
    image: eceasy/cli-proxy-api:latest
    container_name: cli-proxy-api
    restart: unless-stopped
    # pull_policy: always
    user: "{{ docker.user.id }}"
    networks:
      external:
        ipv4_address: {{ lan.external.cli_proxy_api.ip }}
    ports:
      - "{{ lan.external.cli_proxy_api.ports.api }}:{{ lan.external.cli_proxy_api.ports.api }}" # api
      - "{{ lan.external.cli_proxy_api.ports.gemini_oauth }}:{{ lan.external.cli_proxy_api.ports.gemini_oauth }}" # gemini oauth
      - "{{ lan.external.cli_proxy_api.ports.codex_oauth }}:{{ lan.external.cli_proxy_api.ports.codex_oauth }}" # codex oauth
      - "{{ lan.external.cli_proxy_api.ports.claude_oauth }}:{{ lan.external.cli_proxy_api.ports.claude_oauth }}" # claude oauth
      - "{{ lan.external.cli_proxy_api.ports.antigravity_oauth }}:{{ lan.external.cli_proxy_api.ports.antigravity_oauth }}" # antigravity oauth
      - "{{ lan.external.cli_proxy_api.ports.iflow_oauth }}:{{ lan.external.cli_proxy_api.ports.iflow_oauth }}" # iflow oauth
    volumes:
      - {{ docker.config_dir }}/cli-proxy-api/CLIProxyAPI/config.yaml:/CLIProxyAPI/config.yaml
      - {{ docker.config_dir }}/cli-proxy-api/CLIProxyAPI/auths:/CLIProxyAPI/auths
      - {{ docker.config_dir }}/cli-proxy-api/CLIProxyAPI/logs:/CLIProxyAPI/logs
      - {{ docker.config_dir }}/cli-proxy-api/CLIProxyAPI/static:/CLIProxyAPI/static
    environment:
      - MANAGEMENT_STATIC_PATH=/CLIProxyAPI/static

networks:
  external:
    external: true
