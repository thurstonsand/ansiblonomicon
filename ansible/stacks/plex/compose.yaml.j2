services:
  plex:
    image: plexinc/pms-docker:plexpass
    container_name: plex
    restart: unless-stopped
    network_mode: host
{% if plex_hw_transcode %}
    devices:
      - /dev/dri:/dev/dri # Intel UHD 770 QuickSync
{% endif %}
    volumes:
      - /mnt/performance/apps/plex/config:/config
      - /mnt/capacity/watch/media:/data
      - /mnt/capacity/watch/transcode:/transcode
      - /etc/localtime:/etc/localtime:ro
    environment:
      TZ: America/New_York
      # 3001 matches the on-disk ownership; changing it costs a chown of 29G.
      PLEX_UID: 3001
      PLEX_GID: 3001
      UMASK: "002"
    labels:
      # The plexpass tag updates PMS itself at every start.
      com.centurylinklabs.watchtower.enable: "false"
