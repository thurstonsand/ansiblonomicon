services:
  homepage-docker-socket-proxy:
    image: ghcr.io/tecnativa/docker-socket-proxy:latest
    container_name: homepage-docker-socket-proxy
    privileged: true
    # mac_address: aa:5f:e6:ed:91:31
    networks:
      personal:
        ipv4_address: {{ lan.personal.homepage_docker_socket_proxy.ip }}
    ports:
      - "{{ lan.personal.homepage_docker_socket_proxy.ports.docker_api }}:{{ lan.personal.homepage_docker_socket_proxy.ports.docker_api }}" # docker api
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      CONTAINERS: 1
      POST: 0
    restart: unless-stopped

  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    # mac_address: aa:3d:4a:69:04:ca
    networks:
      personal:
        ipv4_address: {{ lan.personal.homepage.ip }}
    ports:
      - "{{ lan.personal.homepage.ports.web }}:{{ lan.personal.homepage.ports.web }}" # web
    volumes:
      - /mnt/performance/docker/homepage/app/config:/app/config
      - /mnt/performance/docker/homepage/app/public/images:/app/public/images
      - /etc/localtime:/etc/localtime:ro
      - /mnt/performance/docker:/apps
      - /mnt/capacity/watch:/watch
    environment:
      PUID: {{ user.puid }}
      PGID: {{ user.pgid }}
      PORT: {{ lan.personal.homepage.ports.web }}
      HOMEPAGE_ALLOWED_HOSTS: {{ lan.personal.homepage.domain }},{{ lan.personal.homepage.domain }}:{{ lan.personal.homepage.ports.web }}
    user: "{{ user.id }}"
    depends_on:
      - homepage-docker-socket-proxy
    restart: unless-stopped
networks:
  personal:
    external: true
