{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 600,
    "suspend": 1800
  },
  "bar": {
    "position": "right",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "alwaysShow": true,
          "items": ["StayAwake"]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "superwhisper.panel"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "tray": [
        {
          "id": "io.github.wouldja.mouse"
        },
        {
          "id": "omarchy.bluetooth"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "io.github.sohanemon.auto-suspend"
    }
  ]
}
