[Unit]
Description=Stop PON monitoring before host networking shuts down
After=docker.service networking.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/bin/docker stop --timeout 10 pon-monitor-pon-monitor-1
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
