#!/bin/sh
# Session failures need an alert: container health only proves the VPN is usable.
set -u

hc_ping() {
  curl -fsS --max-time 10 --retry 3 --retry-delay 2 -o /dev/null \
    "${HEALTHCHECK_PING_URL}$1" ||
    echo "mam-update-run: ping '${1:-/success}' failed" >&2
}

hc_ping /start
mam-update
status=$?
if [ "$status" -eq 0 ]; then
  hc_ping ""
else
  hc_ping "/$status"
fi
exit "$status"
