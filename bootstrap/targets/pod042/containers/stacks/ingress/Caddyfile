{
	acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
}

(local_only) {
	@outside not remote_ip 10.10.10.0/24 10.10.20.0/24 10.10.30.0/24
	respond @outside 403
	reverse_proxy {args[0]}
}

thurstons.house, www.thurstons.house, http://thurstons.house, http://www.thurstons.house {
	file_server
	root * /srv
}

anypod.thurstons.house, http://anypod.thurstons.house {
	reverse_proxy anypod:8024
}

blog.thurstons.house, http://blog.thurstons.house {
	reverse_proxy ghost:2368 {
		header_up X-Forwarded-Proto https
	}
}

cli-proxy-api.thurstons.house, http://cli-proxy-api.thurstons.house {
	reverse_proxy cli-proxy-api:8317
}

seerr.thurstons.house, http://seerr.thurstons.house {
	reverse_proxy seerr:5055
}

# Google Pub/Sub pushes Nest events here; only the secret path reaches Scrypted's public endpoint.
http://nest-events.thurstons.house {
	@push {
		method POST
		path /{$NEST_EVENTS_TOKEN}
	}
	handle @push {
		rewrite * /endpoint/@scrypted/google-device-access/public/
		reverse_proxy 10.10.40.43:11080
	}
	respond 404
}

