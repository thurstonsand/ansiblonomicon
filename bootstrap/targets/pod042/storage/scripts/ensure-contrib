#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
source_file="$script_dir/../files/zfs-contrib.sources"
destination=/etc/apt/sources.list.d/zfs-contrib.sources

if sudo test -f "$destination" && sudo cmp -s "$source_file" "$destination"; then
  exit 0
fi

sudo install -o root -g root -m 0644 "$source_file" "$destination"
sudo apt-get update
