[Unit]
Description=1Password desktop app on a virtual display, unlocking the desktop Chromium's extension
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/thurstonsand
Environment=HOME=/home/thurstonsand
# The runner's compositor restarts with every self-update; Xvfb keeps the app, and its unlock, alive across them.
ExecStart=/usr/bin/xvfb-run --server-num=43 --auth-file=%h/.cache/1password-xvfb/Xauthority --server-args="-screen 0 1280x800x24 -nolisten tcp" /usr/bin/1password
Restart=always
RestartSec=10
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
