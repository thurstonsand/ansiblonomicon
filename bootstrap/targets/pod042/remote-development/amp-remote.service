[Unit]
Description=Amp outbound remote development for pod042
AssertPathExists=%h/.local/share/amp/secrets.json
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/thurstonsand/code
Environment=HOME=/home/thurstonsand
Environment=PATH=/home/thurstonsand/.local/bin:/home/thurstonsand/.amp/bin:/home/thurstonsand/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/thurstonsand/.amp/bin/amp --no-tui --remote-control-terminal --discover-dirs --desktop --runner-id pod042
Restart=always
RestartSec=30
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
