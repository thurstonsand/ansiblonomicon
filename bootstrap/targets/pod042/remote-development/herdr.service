[Unit]
Description=Herdr terminal workspace server for pod042
AssertPathExists=%h/.local/share/mise/shims/herdr
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/thurstonsand
Environment=HOME=/home/thurstonsand
Environment=PATH=/home/thurstonsand/.local/bin:/home/thurstonsand/.amp/bin:/home/thurstonsand/.opencode/bin:/home/thurstonsand/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/thurstonsand/.local/share/mise/shims/herdr server
Restart=always
RestartSec=10
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
