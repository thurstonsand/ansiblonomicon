<?xml version="1.0"?>
<labwc_config>
  <theme>
    <cornerRadius>0</cornerRadius>
    <font name="DejaVu Sans" size="10" />
  </theme>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="desktop-chromium" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
  </keyboard>
  <windowRules>
    <!-- 1Password's prompt waits behind this viewer, and a click into Chromium must not bury it. -->
    <windowRule title="pod042:43 - TigerVNC">
      <action name="ToggleAlwaysOnTop" />
    </windowRule>
  </windowRules>
</labwc_config>
