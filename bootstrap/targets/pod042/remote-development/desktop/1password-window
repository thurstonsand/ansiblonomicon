#!/bin/sh
# Shows 1Password's virtual display on the runner desktop, for unlocking after the app restarts.
set -eu
. "$HOME/.cache/amp/runner-desktop/pod042/environment"
env -u WAYLAND_DISPLAY x11vnc -display :43 -auth "$HOME/.cache/1password-xvfb/Xauthority" -localhost -rfbport 5943 -nopw -once -quiet -bg
exec vncviewer -geometry 1280x800 localhost::5943
