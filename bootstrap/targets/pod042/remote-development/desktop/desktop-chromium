#!/bin/sh
# A dedicated profile, because Chromium refuses remote debugging on its default one.
# The runner tears the compositor down on every restart, so reopen the last tabs without asking.
exec chromium \
  --restore-last-session \
  --hide-crash-restore-bubble \
  --ozone-platform=wayland \
  --user-data-dir="$HOME/.config/chromium-desktop" \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --no-first-run \
  --no-default-browser-check \
  --start-maximized \
  "$@"
