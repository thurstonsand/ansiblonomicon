#!/bin/sh
# Brings the extension's unlock prompt from 1Password's Xvfb display onto the runner desktop, and puts it away once answered.
# labwc's autostart supplies the Wayland environment; the runner rewrites its environment file only after autostart begins.
app() {
  DISPLAY=:43 XAUTHORITY="$HOME/.cache/1password-xvfb/Xauthority" xdotool "$@"
}
prompt() {
  for window in $(app search --onlyvisible --classname '^com\.onepassword\.onepassword$'); do
    if [ "$(app getwindowname "$window")" = 1Password ]; then
      echo "$window"
      return
    fi
  done
}
shown=
while :; do
  window=$(prompt)
  if [ "$window" != "$shown" ]; then
    if [ -n "$window" ]; then
      app windowfocus "$window"
      1password-window >/dev/null 2>&1 &
      timeout 10 wlrctl toplevel waitfor title:"pod042:43 - TigerVNC" &&
        wlrctl toplevel focus title:"pod042:43 - TigerVNC"
    else
      wlrctl toplevel close title:"pod042:43 - TigerVNC"
    fi
    shown=$window
  fi
  sleep 1
done
