#!/usr/bin/env bash
set -euo pipefail
XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_RUNTIME_DIR
state="$XDG_RUNTIME_DIR/pod042-desktop"

case "${1:?start or wait}" in
  start)
    install -d -m 0700 "$state"
    rm -f "$state/environment"
    unset DISPLAY WAYLAND_DISPLAY
    export WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1 WLR_LIBINPUT_NO_DEVICES=1
    export WLR_RENDERER=gles2 WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128 POD042_DESKTOP=1
    export PULSE_SERVER="unix:$XDG_RUNTIME_DIR/pulse/native" PULSE_SINK=pod042-desktop
    exec labwc
    ;;
  wait)
    for _ in {1..200}; do
      if [ -f "$state/environment" ]; then
        set -a
        . "$state/environment"
        set +a
        if wlr-randr >/dev/null 2>&1; then exit 0; fi
      fi
      sleep 0.1
    done
    echo 'Persistent desktop did not become ready within 20 seconds.' >&2
    exit 1
    ;;
  *) exit 2 ;;
esac
