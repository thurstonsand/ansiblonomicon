[aliases]
bottom = ["edit", "roots(::@ & ~::main)"]
preview = ["log", "-r", "::@", "--git"]
stack = ["log", "-r", "::@ & ~::main"]

[git]
auto-local-bookmark = true
private-commits = "description(glob:'wip:*') | description(glob:'private:*')"
sign-on-push = true

[merge-tools.code]
edit-args = ["--wait", "--diff", "$left", "$right"]
merge-args = [
    "--wait",
    "--merge",
    "$left",
    "$right",
    "$base",
    "$output",
]
program = "code"

[signing]
backend = "ssh"
behavior = "drop"
{% if vars.host_profile == "work" %}
key = "{{ vars.vcs_work_signing_key }}"
{% else %}
key = "{{ vars.vcs_personal_public_signing_key }}"
{% endif %}
{% if vars.jj_signing_program != "" %}

[signing.backends.ssh]
program = "{{ vars.jj_signing_program }}"
{% endif %}

[templates]
log_node = "coalesce(\n  if(!self, label(\"elided\", \"~\")),\n  label(if(current_working_copy, \"working_copy\"),\n    if(conflict, label(\"conflict\", \"×\"), \"◉\")\n  ),\n)\n"

[ui]
editor = "nvim"

[ui.graph]
style = "curved"

[ui.movement]
edit = true

[user]
{% if vars.host_profile == "work" %}
email = "{{ vars.vcs_work_email }}"
{% else %}
email = "{{ vars.vcs_personal_email }}"
{% endif %}
name = "Thurston Sandberg"
