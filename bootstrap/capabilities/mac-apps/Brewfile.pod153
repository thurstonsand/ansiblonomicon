# Homebrew Bundle file for pod153, the always-on server Mac.
# Brewfile beside this one is its desktop loadout, kept to restore a personal Mac.

# =============================================================================
# Shell & Terminal
# =============================================================================
brew "ast-grep"
brew "bat"
brew "btop"
brew "direnv"
brew "eza"
brew "fd"
brew "fzf"
tap "thurstonsand/tap", trusted: true
brew "herdr"
brew "jq"
brew "mas"
brew "ripgrep"
brew "rsync"
brew "openai/tools/softnet", trusted: true
brew "shellcheck"
brew "shfmt"
brew "starship"
brew "tmux"
brew "tree"
brew "unzip"
brew "zoxide"

# =============================================================================
# Software Engineering
# =============================================================================
# Git
brew "gh"
brew "git"
brew "git-delta"

# Languages; the runtimes mise can supply live in pod153's global mise config
brew "cmake"
brew "ruby"
brew "rustup"
brew "swiftformat"
brew "swiftlint"

# Infra/Cloud
brew "caddy"
brew "cloudflared"
brew "sshpass"
brew "openai/tools/tart", trusted: true
# The open-source tailscaled, unlike the App Store app, runs before login and serves Tailscale SSH.
brew "tailscale"

# It updates itself, so only a greedy upgrade installs the Python formula its cask switches to.
cask "gcloud-cli", greedy: true
cask "orbstack"

# Editors/Terminals
brew "neovim"
cask "ghostty"
cask "zed"
cask "thurstonsand/tap/wt"

# Apple
mas "TestFlight", id: 899247664
mas "Xcode", id: 497799835

# =============================================================================
# AI
# =============================================================================
cask "chatgpt", greedy: true
cask "claude"
cask "t3-code"

# =============================================================================
# Media
# =============================================================================
brew "ffmpeg"
brew "imagemagick"

# =============================================================================
# Productivity
# =============================================================================
cask "firefox" # headless render backend for trmnlp (TRMNL plugin previews)
cask "google-chrome"
cask "google-drive"

cask "1password"
cask "1password-cli"
cask "beeper" # serves the Beeper Desktop API and MCP to agents
cask "localsend"

mas "Parcel", id: 375589283
mas "Uplock", id: 6469049274

# Fonts
cask "font-blex-mono-nerd-font"
cask "font-fontawesome"
cask "font-mononoki-nerd-font"

# =============================================================================
# Hardware & Drivers
# =============================================================================
brew "smartmontools"
cask "prusaslicer"
# A loopback input for driving dictation apps with `say`: the lid is closed, so there is no mic.
# A fresh install appears only once coreaudiod restarts.
cask "blackhole-2ch"
