#:schema https://developers.openai.com/codex/config-schema.json
model_reasoning_effort = "medium"
model_reasoning_summary = "auto"
{% if not is_work %}
model = "{{ model }}"
{## The app labels exactly this triple as its "Full access" permission mode. ##}
approval_policy = "never"
approvals_reviewer = "user"
sandbox_mode = "danger-full-access"
web_search = "live"
{% endif %}

[features]
prevent_idle_sleep = true
memories = true
default_mode_request_user_input = true
chronicle = {{ "false" if is_work else "true" }}
artifact = {{ "false" if is_work else "true" }}

[tui]
theme = "{{ tui_theme }}"
status_line = [ "context-remaining", "model-with-reasoning", "project-root", "git-branch" ]
{% if not is_work %}

[projects."{{ projects_root }}/nixonomicon"]
trust_level = "trusted"

[projects."{{ projects_root }}/anypod"]
trust_level = "trusted"

[projects."{{ projects_root }}/ansiblonomicon"]
trust_level = "trusted"

[projects."{{ projects_root }}/pi-sessions"]
trust_level = "trusted"

[projects."{{ projects_root }}/mtool"]
trust_level = "trusted"

[projects."/"]
trust_level = "trusted"

[projects."{{ projects_root }}/ghosttykit"]
trust_level = "trusted"

[projects."{{ projects_root }}/flux-keyboard-sdk"]
trust_level = "trusted"
{% endif %}

[desktop]
followUpQueueMode = "steer"
mac-menu-bar-enabled = false
preventSleepWhileRunning = true
hotkey-window-projectless-default-enabled = true
appearanceLightCodeThemeId = "vercel"
appearanceDarkCodeThemeId = "vercel"
usePointerCursors = true
selected-avatar-id = "custom:2b"
open-local-url-in-target-preference = "in-app-browser"
git-always-force-push = true
dock-icon-preference = "app-default"

[desktop.open-in-target-preferences]
global = "zed"
