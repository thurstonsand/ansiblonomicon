# .zshrc - Interactive shell configuration
# Note: _evalcache and PATH are defined in .zshenv

{% if vars.host_profile == "omarchy" %}
# Omarchy owns options, history, completion, syntax highlighting, eza/zoxide aliases, and the
# fzf, zoxide, starship, and mise inits. Sourced from the package so its updates apply as-is.
source /usr/share/omarchy-zsh/shell/zoptions
source /usr/share/omarchy-zsh/shell/all
unalias c cx
{% else %}
# Completion initialization
# Only regenerate .zcompdump if it's older than 24 hours
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qNmh+24) ]]; then
  compinit
else
  compinit -C  # Skip security check for faster startup
fi

# History settings
HISTSIZE=50000
SAVEHIST=50000
HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
setopt HIST_FCNTL_LOCK
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# Shell options
setopt EXTENDED_GLOB        # treat #, ~, and ^ as part of patterns
setopt INTERACTIVE_COMMENTS # allow comments in interactive shells
setopt NOTIFY               # report background job status immediately
unsetopt LIST_BEEP          # no beep on ambiguous completion

bindkey -e
{% endif %}
# Emacs-style key bindings
bindkey "^[[3~" delete-char
bindkey "^[[3;3~" kill-word # alt+fn+delete
bindkey "^U" backward-kill-line
bindkey -r -M emacs '^[a'

{% if vars.host_os == "darwin" %}
# Autosuggestions (via Homebrew)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null || :
{% elif vars.host_profile == "omarchy" %}
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
{% else %}
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
{% endif %}

{% if vars.host_profile != "omarchy" %}
{% if vars.host_os == "darwin" %}
# Syntax highlighting (via Homebrew)
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null || :
{% else %}
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{% endif %}
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets pattern line cursor root)

# eza integration (ls replacement), matching Omarchy's defaults
if command -v eza &>/dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

# Initialize tools (interactive only)
if [[ -o interactive ]]; then
  _evalcache fzf --zsh
{% if vars.host_profile == "work" %}
  [ -f /opt/homebrew/etc/profile.d/autojump.sh ] && . /opt/homebrew/etc/profile.d/autojump.sh
  # Mirror zoxide's `--cmd cd`: prefer literal dirs, fall through to autojump's `j`.
  cd() {
    if [[ $# -eq 0 ]]; then
      builtin cd ~
    elif [[ $# -eq 1 ]] && { [[ -d "$1" ]] || [[ "$1" = '-' ]] || [[ "$1" =~ ^[-+][0-9]+$ ]]; }; then
      builtin cd "$1"
    elif [[ $# -eq 2 ]] && [[ "$1" = '--' ]]; then
      builtin cd "$2"
    else
      j "$@"
    fi
  }
{% else %}
  _evalcache zoxide init zsh
  # Omarchy's `cd`: literal dirs first, then zoxide, printing where it landed.
  alias cd="zd"
  zd() {
    if (( $# == 0 )); then
      builtin cd ~ || return
    elif [[ -d $1 ]]; then
      builtin cd "$1" || return
    else
      if ! z "$@"; then
        echo "Error: Directory not found"
        return 1
      fi

      printf "\U000F17A9 "
      pwd
    fi
  }
{% endif %}
  if [[ $TERM != "dumb" ]]; then
    _evalcache starship init zsh
  fi
fi
{% endif %}
{% if vars.host_os == "darwin" %}
_evalcache bun completions
{% endif %}
{% if vars.host_profile != "omarchy" %}
_evalcache sessions shell zsh
{% endif %}
{% if vars.host_os == "darwin" %}
_evalcache wt shell zsh
{% endif %}
_evalcache direnv hook zsh
{% if vars.host_profile != "omarchy" %}
_evalcache mise activate zsh
{% endif %}
_evalcache mise completion zsh
{% if vars.host_profile == "personal" and vars.host_os == "darwin" %}
_evalcache shp completion zsh
{% endif %}
# Aliases
if command -v prettyping &>/dev/null; then
  alias ping='prettyping'
fi
alias top='btop'
alias lg='lazygit'
alias lzd='lazydocker'
alias vi='nvim'
alias vim='nvim'

{% if vars.host_profile == "work" %}
claude() {
  command claude \
    --plugin-dir ~/code/claude-code-plugin-auto-title \
    --plugin-dir ~/code/claude-code-plugin-sourcegraph \
    "$@"
}
{% else %}
claude() {
  command claude --dangerously-skip-permissions "$@"
}
{% endif %}

{% if vars.host_profile != "omarchy" %}
source ~/.config/zsh/terminal-theme.zsh 2>/dev/null || :
{% endif %}

{% if vars.host_os == "darwin" %}
alias bd='brew desc'
alias bh='brew home'
{% endif %}

# Machine-local overrides (work integrations, extra aliases)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
