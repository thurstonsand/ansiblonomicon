# .zshenv - Loaded for ALL shells (login, interactive, scripts)
# Keep this minimal - avoid side effects that could break scripts

# =============================================================================
# SECTION 1: Runs at EVERY shell level (functions don't inherit)
# =============================================================================

_evalcache() { eval "$("$@")" }

# =============================================================================
# SECTION 2: Environment variables, aliases, and PATH
# =============================================================================

# Start tmux outside project configuration so its server does not retain project credentials.
tmux() (
  local clean_env
  clean_env="$(mise -C / hook-env -s zsh)" || return
  eval "$clean_env"
  direnv exec / "$(whence -p tmux)" "$@"
)

# Environment variables
export XDG_CONFIG_HOME="$HOME/.config"

# SSH strips local terminal metadata, but rendering still happens client-side.
# Force icon-capable Pi powerline output when using Nerd Fonts locally.
if [[ -n "${SSH_CONNECTION:-}" ]]; then
  export POWERLINE_NERD_FONTS=1
fi

export EDITOR="nvim"
export VISUAL="nvim"

{% if vars.host_profile == "work" %}

# 1Password SSH agent
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
export SOURCEGRAPH_TOKEN='{{ get_env(name="SOURCEGRAPH_TOKEN") }}'
export GENAIHUB_API_KEY='{{ get_env(name="ANTHROPIC_AUTH_TOKEN") }}'
{% endif %}


# PATH additions (available to all shells including scripts)
{% if vars.host_os == "darwin" %}
# Keep Homebrew executables available to non-login shells. .zprofile runs
# brew shellenv for the remaining Homebrew environment configuration.
{% endif %}
typeset -U path
path=(
{% if vars.host_os == "linux" and vars.host_profile != "omarchy" %}
  "$HOME/.local/bin"
  "$HOME/.amp/bin"
{% endif %}
{% if vars.host_os == "darwin" %}
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"
{% endif %}
{% if vars.host_profile != "omarchy" %}
  "$HOME/.local/share/mise/shims"
{% endif %}
  "$HOME/.bun/bin"
  "$HOME/.npm-global/bin"
  "$HOME/.cargo/bin"
  "$HOME/.local/share/pnpm"
  "$HOME/go/bin"
{% if vars.host_os == "darwin" %}
{% if "/opt/homebrew/opt/ruby/bin/ruby" is file %}
  "/opt/homebrew/opt/ruby/bin"
  "/opt/homebrew/lib/ruby/gems/{{ exec(command="/opt/homebrew/opt/ruby/bin/ruby -e \"puts RbConfig::CONFIG['ruby_version']\"") | trim }}/bin"
{% endif %}
{% if "/opt/homebrew/opt/rustup/bin/rustup" is file %}
  "/opt/homebrew/opt/rustup/bin"
{% endif %}
{% endif %}
{% if vars.host_profile == "work" %}
  "$HOME/scripts"
{% endif %}
{% if vars.host_os != "darwin" and vars.host_profile != "omarchy" %}
  "$HOME/.local/bin"
{% endif %}
  $path
)

# Machine-local overrides
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local
