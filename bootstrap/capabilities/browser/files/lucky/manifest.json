{
  "manifest_version": 3,
  "name": "Lucky",
  "description": "Address-bar searches go straight to the page an AI picks from Kagi's results.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["https://kagi.com/*", "https://api.openai.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "declarative_net_request": {
    "rule_resources": [{ "id": "address-bar", "enabled": true, "path": "rules.json" }]
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "Kagi",
      "search_url": "https://kagi.com/search?q={searchTerms}",
      "favicon_url": "https://assets.kagi.com/v2/favicon-32x32.png",
      "keyword": "@kagi",
      "is_default": true,
      "suggest_url": "https://kagisuggest.com/api/autosuggest?q={searchTerms}",
      "encoding": "UTF-8"
    }
  },
  "web_accessible_resources": [{ "resources": ["go.html"], "matches": ["<all_urls>"] }],
  "commands": {
    "show-results": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Wrong page: show Kagi's results for the last lucky search in this tab"
    }
  }
}
