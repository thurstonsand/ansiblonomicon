local function apply_highlights()
  vim.api.nvim_set_hl(0, "GitSignsCurrentLineBlame", {
    link = "Comment",
  })
end

vim.api.nvim_create_autocmd("ColorScheme", {
  group = vim.api.nvim_create_augroup("custom_highlights", { clear = true }),
  callback = apply_highlights,
})

apply_highlights()

{% if vars.host_profile == "omarchy" %}
return {}
{% else %}
local terminal_bg_path = vim.fn.expand("~/.terminal-bg")
local function terminal_bg()
  local terminal_bg_file = io.open(terminal_bg_path, "r")
  if not terminal_bg_file then
    return "dark"
  end
  local terminal_bg = vim.trim(terminal_bg_file:read("*l") or "")
  terminal_bg_file:close()
  assert(terminal_bg == "light" or terminal_bg == "dark", terminal_bg_path .. ": expected light or dark, got " .. vim.inspect(terminal_bg))
  return terminal_bg
end

local function apply_city_ruins()
  vim.cmd.colorscheme(terminal_bg() == "light" and "copied-city" or "city-ruins")
end

local terminal_bg_watcher = vim.uv.new_fs_event()
if terminal_bg_watcher then
  local function watch_terminal_bg()
    terminal_bg_watcher:start(terminal_bg_path, {}, function(err)
      if err then
        return
      end
      vim.schedule(function()
        apply_city_ruins()
        terminal_bg_watcher:stop()
        watch_terminal_bg()
      end)
    end)
  end
  watch_terminal_bg()
end

return {
  {
    "ficcdaf/ashen.nvim",
    lazy = false,
    priority = 1000,
  },
  {
    "LazyVim/LazyVim",
    opts = {
      colorscheme = apply_city_ruins,
    },
  },
}
{% endif %}
