#!/usr/bin/env python3
# Maintain the installed mise binary at most once per successful day.
import fcntl
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

INTERVAL = 86400


def usage() -> None:
    print("usage: mise-maintain [--sudo] BINARY STAMP", file=sys.stderr)
    raise SystemExit(2)


def run(command: list[str]) -> None:
    completed = subprocess.run(command, check=False)
    if completed.returncode:
        raise SystemExit(completed.returncode)


arguments = sys.argv[1:]
use_sudo = bool(arguments and arguments[0] == "--sudo")
if use_sudo:
    arguments = arguments[1:]
if len(arguments) != 2:
    usage()

binary, stamp_name = arguments
stamp = Path(stamp_name)

# Initial installation remains the host provisioner's job. Do not turn routine
# maintenance into a second installation path.
if not os.access(binary, os.X_OK):
    raise SystemExit(0)

# Keep the lock outside the stamp directory: --sudo maintenance intentionally
# leaves that directory root-owned. flock locks are released by the kernel on
# exit, so an interrupted run cannot leave a stale lock trap.
lock_key = hashlib.sha256(os.path.abspath(stamp).encode()).hexdigest()
lock_path = Path(tempfile.gettempdir()) / f"mise-maintain-{lock_key}.lock"
open_flags = os.O_CREAT | os.O_RDWR
if hasattr(os, "O_NOFOLLOW"):
    open_flags |= os.O_NOFOLLOW
lock_fd = os.open(lock_path, open_flags, 0o600)
with os.fdopen(lock_fd, "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)

    if stamp.exists() and time.time() - stamp.stat().st_mtime < INTERVAL:
        raise SystemExit(0)

    update = [binary, "self-update", "--yes", "--no-plugins"]
    if use_sudo:
        run(["sudo", "-n", *update])
        run(
            [
                "sudo",
                "-n",
                "install",
                "-d",
                "-o",
                "root",
                "-g",
                "root",
                "-m",
                "0755",
                str(stamp.parent),
            ]
        )
        run(["sudo", "-n", "touch", str(stamp)])
        run(["sudo", "-n", "chmod", "0644", str(stamp)])
    else:
        run(update)
        run(["install", "-d", "-m", "0755", str(stamp.parent)])
        stamp.touch()
        stamp.chmod(0o644)
