{
  "id": "omarchy",
  "label": "Omarchy",
  "base": "github-{{ mode }}-default",
  "background": "{{ background }}",
  "panel": "{{ mix background foreground 6% }}",
  "panelAlt": "{{ mix background foreground 12% }}",
  "border": "{{ mix background foreground 20% }}",
  "accent": "{{ accent }}",
  "accentMuted": "{{ mix accent background 35% }}",
  "text": "{{ foreground }}",
  "muted": "{{ mix foreground background 34% }}",
  "addedBg": "{{ mix background green 10% }}",
  "removedBg": "{{ mix background red 12% }}",
  "contextBg": "{{ mix background foreground 6% }}",
  "addedContentBg": "{{ mix background green 16% }}",
  "removedContentBg": "{{ mix background red 20% }}",
  "contextContentBg": "{{ mix background foreground 12% }}",
  "addedSignColor": "{{ green }}",
  "removedSignColor": "{{ red }}",
  "lineNumberBg": "{{ mix background foreground 6% }}",
  "lineNumberFg": "{{ mix foreground background 52% }}",
  "selectedHunk": "{{ selection }}",
  "badgeAdded": "{{ green }}",
  "badgeRemoved": "{{ red }}",
  "badgeNeutral": "{{ mix foreground background 52% }}",
  "fileNew": "{{ green }}",
  "fileDeleted": "{{ red }}",
  "fileRenamed": "{{ accent }}",
  "fileModified": "{{ orange }}",
  "fileUntracked": "{{ bright_yellow }}",
  "noteBorder": "{{ accent }}",
  "noteBackground": "{{ mix background foreground 12% }}",
  "noteTitleBackground": "{{ selection }}",
  "noteTitleText": "{{ foreground }}",
  "syntaxScopes": {
    "source": "{{ foreground }}",
    "variable": "{{ foreground }}",
    "variable.parameter": "{{ foreground }}",
    "comment": "{{ muted }}",
    "punctuation.definition.comment": "{{ muted }}",
    "string": "{{ green }}",
    "punctuation.definition.string": "{{ green }}",
    "constant.numeric": "{{ orange }}",
    "constant.character": "{{ orange }}",
    "constant.other": "{{ orange }}",
    "constant.language": "{{ cyan }}",
    "keyword": "{{ bright_magenta }}",
    "keyword.control": "{{ bright_magenta }}",
    "storage.modifier": "{{ bright_magenta }}",
    "storage.type.function": "{{ bright_magenta }}",
    "storage.type.class": "{{ bright_magenta }}",
    "keyword.control.import": "{{ blue }}",
    "keyword.control.from": "{{ blue }}",
    "meta.preprocessor": "{{ blue }}",
    "keyword.operator": "{{ bright_blue }}",
    "entity.name.function": "{{ blue }}",
    "support.function": "{{ blue }}",
    "variable.function": "{{ blue }}",
    "meta.function-call": "{{ blue }}",
    "entity.name.type": "{{ yellow }}",
    "entity.name.class": "{{ yellow }}",
    "support.type": "{{ yellow }}",
    "support.class": "{{ yellow }}",
    "storage.type": "{{ yellow }}",
    "variable.other.member": "{{ cyan }}",
    "variable.other.property": "{{ cyan }}",
    "support.variable.property": "{{ cyan }}",
    "entity.other.attribute-name": "{{ cyan }}",
    "support.type.property-name": "{{ cyan }}",
    "entity.name.tag": "{{ yellow }}",
    "punctuation": "{{ dark_foreground }}"
  }
}
