{% if vars.ssh_client_host != "pod153" %}
Include ~/.ssh/1Password/config
{% endif %}
Include ~/.ssh/config.d/*.conf

# OpenSSH owns LAN sockets; Cloudflare is only the unreachable-LAN fallback.

Host pod042-kvm
  HostName 10.10.10.34
  User root
  HostKeyAlias pod042-kvm
  IdentityFile ~/.ssh/id_ecdsa_glkvm

Host pod153-kvm
  HostName 10.10.10.35

Host pod153-kvm-ts
  HostName 100.81.37.67

Host pod153-kvm pod153-kvm-ts
  User root
  HostKeyAlias pod153-kvm
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
{% if vars.ssh_client_host == "pod042" or vars.ssh_client_host == "pod153" %}
  IdentityFile ~/.ssh/id_ed25519_git
{% else %}
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
{% endif %}
  IdentitiesOnly yes

Match originalhost haos !exec "~/.local/libexec/ssh-lan-reachable 192.168.1.89 22222"
  HostName haos-ssh.thurstons.house
  ProxyCommand cloudflared access ssh --hostname %h

Host haos
  HostName 192.168.1.89
  Port 22222
  ForwardAgent yes
  User root
  HostKeyAlias haos

{% if vars.ssh_client_host == "pod042" or vars.ssh_client_host == "pod153" %}
Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
{% endif %}
{% if vars.ssh_client_host == "pod153" %}

Match originalhost pod042 !exec "~/.local/libexec/ssh-lan-reachable 10.10.10.42 22"
  HostName pod042-ssh.thurstons.house
  ProxyCommand cloudflared access ssh --hostname %h

Host pod042
  HostName 10.10.10.42
  User thurstonsand
  HostKeyAlias pod042
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
  RequestTTY yes

Host pod042-ts
  HostName 100.64.249.18
  User thurstonsand
  HostKeyAlias pod042
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
  RequestTTY yes

# The Messages VM; Tart's network reaches it only from pod153.
Host cupertino
  HostName cupertino.local
  User admin
  HostKeyAlias cupertino
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
{% elif vars.ssh_client_host == "pod042" %}

Host pod153
  HostName 10.10.10.53
  User thurstonsand
  HostKeyAlias pod153
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes

Host pod153-ts
  HostName 100.97.62.24
  User thurstonsand
  HostKeyAlias pod153
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
{% else %}

Host pod153
  HostName 10.10.10.53
  User thurstonsand
  HostKeyAlias pod153
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes

Host pod153-ts
  HostName 100.97.62.24
  User thurstonsand
  HostKeyAlias pod153
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts

Match originalhost pod042 !exec "~/.local/libexec/ssh-lan-reachable 10.10.10.42 22"
  HostName pod042-ssh.thurstons.house
  ProxyCommand cloudflared access ssh --hostname %h

Host pod042
  HostName 10.10.10.42
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  RequestTTY yes

Host pod042-remote
  HostName pod042-ssh.thurstons.house
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  ProxyCommand cloudflared access ssh --hostname %h
  RequestTTY yes

Host pod042-ts
  HostName 100.64.249.18
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  RequestTTY yes

Host pod042-kvm-ts
  HostName 100.112.38.64
  User root
  HostKeyAlias pod042-kvm
  IdentityFile ~/.ssh/id_ecdsa_glkvm
  IdentitiesOnly yes
{% endif %}

Host udmp
  HostName 10.10.20.1
  User root
  HostKeyAlias udmp

Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  AddKeysToAgent no
  HashKnownHosts no
{% if vars.host_profile == "omarchy" %}
  IdentityAgent ~/.1password/agent.sock
{% endif %}
