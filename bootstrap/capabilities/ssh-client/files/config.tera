{% if vars.ssh_client_host != "pod153" %}
Include ~/.ssh/1Password/config
{% endif %}
Include ~/.ssh/config.d/*.conf

# SSH via Cloudflare Tunnel (hostname-based access)
# Uses ssh-smart-proxy: tries local connection first, falls back to cloudflared access ssh

Host pod042-kvm
  HostName 10.10.10.34
  User root
  HostKeyAlias pod042-kvm
  IdentityFile ~/.ssh/id_ecdsa_glkvm

Host haos
  ForwardAgent yes
  User root
  HostKeyAlias haos
  ProxyCommand ~/.local/libexec/ssh-smart-proxy haos 192.168.1.89 22222 haos-ssh.thurstons.house

{% if vars.ssh_client_host == "pod042" or vars.ssh_client_host == "pod153" %}
Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
{% endif %}
{% if vars.ssh_client_host == "pod153" %}

Host pod042
  User thurstonsand
  HostKeyAlias pod042
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
  ProxyCommand ~/.local/libexec/ssh-smart-proxy pod042 10.10.10.42 22 pod042-ssh.thurstons.house
  RequestTTY yes

Host pod042-ts
  HostName 100.64.249.18
  User thurstonsand
  HostKeyAlias pod042
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
  RequestTTY yes
{% elif vars.ssh_client_host == "pod042" %}

Host pod153
  HostName 10.10.10.53
  User thurstonsand
  HostKeyAlias pod153
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
  IdentityFile ~/.ssh/id_ed25519_git
  IdentitiesOnly yes
{% else %}

Host pod153
  HostName 10.10.10.53
  User thurstonsand
  HostKeyAlias pod153
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/pod153.known_hosts
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes

Host pod042
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  ProxyCommand ~/.local/libexec/ssh-smart-proxy pod042 10.10.10.42 22 pod042-ssh.thurstons.house
  RequestTTY yes

Host pod042-remote
  HostName pod042-ssh.thurstons.house
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  ProxyCommand cloudflared access ssh --hostname %h
  RequestTTY yes

Host pod042-ts
  HostName 100.64.249.18
  User thurstonsand
  ForwardAgent yes
  HostKeyAlias pod042
  IdentityFile ~/.ssh/1Password/SHA256_xQTTgUrxzVzEf6EIQNWj_5RpVmoVzSa4kfqSLz4RcfQ.pub
  IdentitiesOnly yes
  RequestTTY yes

Host pod042-kvm-ts
  HostName 100.112.38.64
  User root
  HostKeyAlias pod042-kvm
  IdentityFile ~/.ssh/id_ecdsa_glkvm
  IdentitiesOnly yes
{% endif %}

Host udmp
  HostName 10.10.20.1
  User root
  HostKeyAlias udmp

Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  AddKeysToAgent no
  HashKnownHosts no
{% if vars.host_profile == "omarchy" %}
  IdentityAgent ~/.1password/agent.sock
{% endif %}
