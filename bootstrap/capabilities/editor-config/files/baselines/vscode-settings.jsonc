{
  // ============================================================================
  // CORE UI & APPEARANCE
  // ============================================================================
  "update.mode": "default",
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Gruvbox Dark Hard",
  "workbench.preferredLightColorTheme": "Gruvbox Light Hard",
  "workbench.startupEditor": "none",
  "editor.fontFamily": "BerkeleyMono Nerd Font Mono",
  "editor.fontSize": 13,
  "terminal.integrated.fontFamily": "BerkeleyMono Nerd Font Mono",
  "terminal.integrated.fontSize": 13,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.commandPalette.experimental.suggestCommands": true,
  "window.titleSeparator": " // ",
  "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}",

  // ============================================================================
  // AUTO-SAVE & FILE HANDLING
  // ============================================================================
  "files.autoSave": "onFocusChange",
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.autoIndentOnPaste": true,

  // ============================================================================
  // EDITOR BEHAVIOR & INTERACTION
  // ============================================================================
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "workbench.editor.wrapTabs": true,
  "editor.multiCursorModifier": "alt",
  "editor.mouseWheelZoom": true,
  "editor.codeActions.triggerOnFocusChange": true,
  "editor.accessibilitySupport": "on",
  "editor.wordBasedSuggestions": "off",
  "diffEditor.codeLens": true,
  "editor.minimap.enabled": true,
  "editor.minimap.autohide": "scroll",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,

  // ============================================================================
  // EXPLORER & FILE MANAGEMENT
  // ============================================================================
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,

  // ============================================================================
  // TERMINAL & SHELL
  // ============================================================================
  "terminal.integrated.allowChords": false,
  "direnv.watchForChanges": false,

  // ============================================================================
  // GIT & VERSION CONTROL
  // ============================================================================
  "diffEditor.ignoreTrimWhitespace": false,
  "git.allowForcePush": true,
  "git.autofetch": "all",
  "git.autoStash": true,
  "git.branchProtection": ["main", "master"],
  "git.branchProtectionPrompt": "alwaysCommit",
  "git.confirmForcePush": true,
  "git.confirmSync": false,
  "git.terminalAuthentication": false,
  "git.terminalGitEditor": true,
  "git.openRepositoryInParentFolders": "never",
  "git.suggestSmartCommit": false,
  "github.gitProtocol": "ssh",
  "merge-conflict.autoNavigateNextConflict.enabled": true,
  "githubPullRequests.pullBranch": "never",

  // ============================================================================
  // GITLENS
  // ============================================================================
  "gitlens.mode.active": "zen",

  // ============================================================================
  // REMOTE & PORT FORWARDING
  // ============================================================================
  "remote.autoForwardPorts": false,

  // ============================================================================
  // SECURITY & CLOUD
  // ============================================================================
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.experimental.share.enabled": true,
  "workbench.experimental.cloudChanges.autoStore": "onShutdown",
  "workbench.experimental.cloudChanges.partialMatches.enabled": true,

  // ============================================================================
  // LANGUAGE-SPECIFIC SETTINGS
  // ============================================================================

  // --- PYTHON ---
  "python.terminal.activateEnvironment": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "ruff.configurationPreference": "filesystemFirst",
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll": "explicit",
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "gitlens.codeLens.symbolScopes": ["!Module"],
    "editor.formatOnType": true,
    "editor.wordBasedSuggestions": "off",
  },

  // --- PYRIGHT ---
  "basedpyright.analysis.inlayHints.functionReturnTypes": true,
  "basedpyright.analysis.inlayHints.variableTypes": true,
  "basedpyright.analysis.diagnosticMode": "workspace",
  "basedpyright.analysis.inlayHints.callArgumentNames": true,
  "basedpyright.analysis.inlayHints.callArgumentNamesMatching": false,
  "basedpyright.analysis.typeCheckingMode": "strict",

  // --- YAML ---
  "redhat.telemetry.enabled": false,
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "keep",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // --- JSON ---
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "json.schemaDownload.enable": true,

  // --- MARKDOWN ---
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // --- CSV ---
  "rainbow_csv.highlight_rows": true,
  "rainbow_csv.virtual_alignment_mode": "always",
  "rainbow_csv.csv_lint_detect_trailing_spaces": true,
  "rainbow_csv.rbql_with_headers_by_default": true,
  "[csv]": {
    "editor.inlayHints.maximumLength": 0,
  },

  // --- DOCKER & DOCKER COMPOSE ---
  "docker.extension.enableComposeLanguageServer": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },

  // --- GITHUB ACTIONS ---
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },

  // --- NIX ---
  "nix.formatterPath": ["nix", "fmt"],
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nil",
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": ["nix", "fmt", "--", "--"],
      },
    },
  },

  // --- SVELTE ---
  "svelte.enable-ts-plugin": true,

  // --- JAVASCRIPT / TYPESCRIPT ---
  "biome.suggestInstallingGlobally": false,
  "[javascript]": {
    "editor.maxTokenizationLineLength": 2500,
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[typescript]": {
    "editor.maxTokenizationLineLength": 2500,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // --- GO ---
  "go.toolsManagement.autoUpdate": true,
  "go.useLanguageServer": true,
  "go.lintTool": "golangci-lint-v2",
  "go.lintOnSave": "package",
  "go.lintFlags": [
    "--path-mode=abs",
    "--fast",
    "--config=${workspaceFolder}/.golangci.yml",
  ],
  "go.formatTool": "goimports",
  "go.diagnostic.vulncheck": "Imports",
  "go.inlayHints.parameterNames": true,
  "go.inlayHints.rangeVariableTypes": true,
  "gopls": {
    "usePlaceholders": true,
    "staticcheck": false,
    "completeUnimported": true,
    "deepCompletion": true,
    "ui.semanticTokens": true
  },

  // ============================================================================
  // CODERABBIT
  // ============================================================================
  "coderabbit.autoReviewMode": "disabled",

  // ============================================================================
  // Accessibility
  // ============================================================================
  "accessibility.signals.lineHasBreakpoint": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off",
  },
  "accessibility.signals.chatRequestSent": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off",
  },
  "accessibility.signals.chatUserActionRequired": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.clear": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off",
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off",
  },
  "accessibility.signals.onDebugBreak": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.diffLineDeleted": {
    "sound": "off",
  },
  "accessibility.signals.diffLineInserted": {
    "sound": "off",
  },
  "accessibility.signals.diffLineModified": {
    "sound": "off",
  },
  "accessibility.signals.editsKept": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.positionHasError": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.lineHasError": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.lineHasFoldedArea": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off",
  },
  "accessibility.signals.nextEditSuggestion": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.noInlayHints": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.notebookCellCompleted": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.notebookCellFailed": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.progress": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.taskCompleted": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.taskFailed": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.terminalBell": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.terminalCommandFailed": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.terminalCommandSucceeded": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.terminalQuickFix": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.editsUndone": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.voiceRecordingStarted": {
    "sound": "off",
  },
  "accessibility.signals.voiceRecordingStopped": {
    "sound": "off",
  },
  "accessibility.signals.positionHasWarning": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.lineHasWarning": {
    "sound": "off",
    "announcement": "auto",
  },
}

