#!/usr/bin/env bash
set -euo pipefail

quote() {
  printf '%q' "$1"
}

join_command() {
  local out
  printf -v out '%q ' "$@"
  printf '%s' "${out% }"
}

usage() {
  cat >&2 <<'EOF'
usage: ideo [host] <ansiblonomicon|openclaw> [agent-command...]

Examples:
  ideo ansiblonomicon
  ideo openclaw ansiblonomicon
  ideo openclaw openclaw pi

Environment:
  SHPOOL_IDE_HOST  SSH host to use when host is omitted (default: openclaw)
EOF
}

is_project() {
  case "$1" in
    ansiblonomicon | openclaw) return 0 ;;
    *) return 1 ;;
  esac
}

remote_dir_for_project() {
  case "$1" in
    ansiblonomicon)
      printf '%s' "/home/thurstonsand/code/ansiblonomicon"
      ;;
    openclaw)
      printf '%s' "/home/thurstonsand/code/openclaw"
      ;;
    *)
      echo "ideo: unsupported project: $1" >&2
      usage
      return 1
      ;;
  esac
}

parse_target() {
  if (($# >= 2)) && is_project "$2"; then
    IDEO_HOST=$1
    IDEO_PROJECT=$2
    IDEO_AGENT_ARGS=("${@:3}")
    return 0
  fi

  IDEO_HOST=${SHPOOL_IDE_HOST:-openclaw}
  IDEO_PROJECT=$1
  IDEO_AGENT_ARGS=("${@:2}")
}

wrap_interactive_cmd() {
  local cmd
  local zsh_cmd
  cmd=$(join_command "$@")
  zsh_cmd="$cmd; exec /usr/bin/zsh -il"
  printf '/usr/bin/zsh -ilc %s' "$(quote "$zsh_cmd")"
}

run_shp_attach() {
  local host=$1
  local session=$2
  local dir=$3
  shift 3

  if ! command -v shp >/dev/null 2>&1; then
    echo "ideo: shp is not installed." >&2
    exit 1
  fi

  local args=("$host" --force --dir "$dir")
  if (($# > 0)); then
    args+=(--cmd "$(wrap_interactive_cmd "$@")")
  fi
  args+=("$session")

  while true; do
    set +e
    shp "${args[@]}"
    local status=$?
    set -e

    if ((status == 0)); then
      exit 0
    fi

    if [[ ! -t 0 ]]; then
      exit "$status"
    fi

    printf '\nideo: %s on %s disconnected (exit %s). Press Enter to reconnect, q to quit.\n' "$session" "$host" "$status" >&2
    local reply
    IFS= read -rsn1 reply || exit "$status"
    if [[ "$reply" == "q" ]]; then
      printf '\n' >&2
      exit "$status"
    fi
  done
}

attach_session() {
  local host=$1
  local project=$2
  local kind=$3
  shift 3

  local remote_dir
  remote_dir=$(remote_dir_for_project "$project")

  local session="${kind}-${project}"
  if [[ "$kind" == "edit" && $# -eq 0 ]]; then
    run_shp_attach "$host" "$session" "$remote_dir" nvim .
  else
    run_shp_attach "$host" "$session" "$remote_dir" "$@"
  fi
}

self_path() {
  if [[ $0 == */* ]]; then
    printf '%s' "$0"
  else
    command -v -- "$0"
  fi
}

wait_for_ready() {
  local label=$1

  if read -r -t 8 _ready <&3; then
    return 0
  fi

  echo "ideo: timed out waiting for $label." >&2
  return 1
}

if [[ ${1:-} == "--attach" ]]; then
  if (($# < 4)); then
    echo "ideo: --attach requires host, project, and kind." >&2
    exit 1
  fi
  shift
  attach_session "$@"
fi

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  usage
  exit 0
fi

if (($# < 1)); then
  echo "ideo: missing required project." >&2
  usage
  exit 1
fi

if [[ ${TERM_PROGRAM:-} != "ghostty" ]]; then
  echo "ideo: Ghostty only. Open a Ghostty tab and try again." >&2
  exit 1
fi

if ! command -v gty >/dev/null 2>&1; then
  echo "ideo: gty is not installed." >&2
  exit 1
fi

terminal_count=$(gty tab-terminal-count 2>/dev/null)
if [[ "$terminal_count" != "1" ]]; then
  echo "ideo: expected a fresh Ghostty tab with exactly one terminal; open a new tab and try again." >&2
  exit 1
fi

declare IDEO_HOST IDEO_PROJECT
declare -a IDEO_AGENT_ARGS
parse_target "$@"
remote_dir_for_project "$IDEO_PROJECT" >/dev/null

ready_fifo=$(mktemp -t ideo-editor-ready.XXXXXX)
rm -f "$ready_fifo"
mkfifo "$ready_fifo"
exec 3<>"$ready_fifo"
trap 'exec 3>&- 3<&-; rm -f "$ready_fifo"' EXIT

script_path=$(self_path)
editor_attach="exec $(quote "$script_path") --attach $(quote "$IDEO_HOST") $(quote "$IDEO_PROJECT") edit"
editor_local="if gty terminal-id >/dev/null; then printf 'ready\\n' > $(quote "$ready_fifo"); else echo 'ideo: failed to register editor Ghostty terminal' >&2; fi; $editor_attach"

gty split left --command "/bin/zsh -ilc $(quote "$editor_local")" --focus new --wait
wait_for_ready "editor terminal registration"
gty resize right --percent 15 --wait
gty zoom --wait

attach_session "$IDEO_HOST" "$IDEO_PROJECT" agent "${IDEO_AGENT_ARGS[@]}"
