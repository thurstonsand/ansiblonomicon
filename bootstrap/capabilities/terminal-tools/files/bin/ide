#!/usr/bin/env bash
set -euo pipefail

# Opens an IDE-style Ghostty split: nvim on the left, optional command on the right.
# Usage: ide [--cwd cwd] [command...]

[[ ${TERM_PROGRAM-} == "ghostty" ]] || {
  echo "ide: Ghostty only." >&2
  exit 1
}

command -v gty >/dev/null 2>&1 || {
  echo "ide: gty is not installed." >&2
  exit 1
}

# This pane is organic (not daemon-spawned), so a recycled pty can carry a stale
# cached mapping; rebind while this terminal is certainly the focused one.
gty terminal-id --refresh >/dev/null || exit 1

terminal_count=$(gty tab-terminal-count 2>/dev/null) || exit 1
[[ "$terminal_count" == "1" ]] || {
  echo "ide: expected a fresh tab with exactly one terminal." >&2
  exit 1
}

cwd=$(pwd -P)
if [[ ${1:-} == "--cwd" || ${1:-} == "-C" ]]; then
  (($# >= 2)) || {
    echo "ide: ${1} requires a directory." >&2
    exit 1
  }
  cwd=$2
  shift 2
fi
[[ -d $cwd ]] || {
  echo "ide: cwd does not exist: $cwd" >&2
  exit 1
}

# Measure before the split shrinks this pane to 15%.
cols=$(tput cols 2>/dev/null || echo 0)

# The split spawns a claimed interactive login shell and reports its tty; nvim is
# typed into that shell, so quitting it returns to the shell and session restore
# recovers the project directory.
editor_tty=$(gty split left --cwd "$cwd" --focus new --wait)
gty resize right --percent 15 --wait
((cols < 200)) && gty zoom --wait
if [[ -n $editor_tty ]]; then
  gty input --tty "$editor_tty" --submit --wait 'nvim .'
else
  echo "ide: split reported no tty; leaving a plain shell." >&2
fi

if (($# > 0)); then
  cd "$cwd"
  "$@"
fi
