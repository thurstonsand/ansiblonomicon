#!/usr/bin/env bash
set -euo pipefail

case "$(uname -s)" in
  Darwin)
    real_delta="/opt/homebrew/bin/delta"
    ;;
  Linux)
    real_delta="/usr/bin/delta"
    ;;
  *)
    echo "Unsupported platform for delta wrapper: $(uname -s)" >&2
    exit 1
    ;;
esac

if [[ ! -x "$real_delta" ]]; then
  echo "delta not found at $real_delta" >&2
  exit 1
fi

if command -v omarchy-theme-color >/dev/null; then
  # Omarchy's bat theme-set hook caches the active theme as `omarchy`.
  exec "$real_delta" --"$(omarchy-theme-color mode)" --syntax-theme=omarchy "$@"
fi

exec "$real_delta" --"$(cat ~/.terminal-bg 2>/dev/null || echo dark)" "$@"
