#!/usr/bin/env python3
"""Pull and reconcile this host; on failure, hand the log to an Amp agent to fix or escalate."""

import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time

REPO = Path(__file__).resolve().parents[1]
LOG = Path.home() / ".local/state/ansiblonomicon/reconcile.log"
LOCK = "bootstrap/capabilities/neovim/files/lazy-lock.json"
# A step that waits on something nobody will answer, such as a denied privacy check, hangs
# forever; past this it is killed and handed to the agent like any other failure.
TIMEOUT_MINUTES = 30
PROMPT = """The scheduled reconcile on {host} failed with exit status {status} at {when}.
The full log is {log}; its last lines are below.

Other agents share this checkout, so it may hold another thread's unfinished, uncommitted work, and the reconcile deployed that work along with main. The script pulls by fetching, trial-merging the uncommitted work with upstream through `git stash create` and `git merge-tree`, failing on a conflict, and otherwise running `git rebase --autostash`; pull the same way, because a conflicting autostash exits 0 and leaves conflict markers in that work. If a rebase stopped partway, `git rebase --abort` first; it restores the autostashed work.

Before anything else, check whether that work is the cause, including a pull that stopped because incoming commits conflict with it. Find its thread with find_thread by what the changes do; the pull's autostash resets their modification times. Finishing it is not your job: `git stash push --include-untracked` it, pull and reconcile main cleanly, then `git stash pop` it back so it stays in progress, uncommitted, and tell its thread what broke with send_thread_message. If the pop conflicts, git keeps the stash entry, so check that it is still listed, return the conflicted files to main's version, and tell Thurston. An uncommitted {lock} is a leftover from an earlier reconcile, not another thread's work: commit it as below, or discard it when main already has it. Never commit or discard any other changes you did not make.

Otherwise, find the root cause. Then:
- If the fix belongs in this repository, make it, verify it by rerunning the failing capability (and its --check), commit only your own files following the repository's conventions, pull, and push to main.
- If the failure was transient, such as a network or upstream outage, rerun the failing capability to confirm it now passes and change nothing.
- If it needs Thurston, do not guess.

A reconcile syncs Neovim plugins and rewrites {lock}; commit that file alone as `chore(neovim): update lazy-lock`, pull, and push to main.

Send Thurston one push notification with notify_user only when he must act or decide: an expired login, a credential, a physical step, a true conflict, or a behavior change you should not choose alone. Say what happened, what you did, and what he must do. A fix you pushed or a transient failure needs no notification; this thread is the record.

```
{tail}
```
"""


def run_reconcile() -> int:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("w") as log:

        def run(*command: str) -> int:
            log.write(f"$ {' '.join(command)}\n")
            log.flush()
            process = subprocess.Popen(
                command,
                cwd=REPO,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
            try:
                return process.wait(timeout=TIMEOUT_MINUTES * 60)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
                log.write(f"timed out after {TIMEOUT_MINUTES} minutes; killed\n")
                return 124

        # Other agents leave unfinished work in this checkout. The autostash carries it over
        # the rebase, but a conflicting autostash still exits 0 and leaves conflict markers
        # behind, so a trial merge of that work with upstream fails the pull before anything moves.
        def pull() -> int:
            if status := run("git", "fetch"):
                return status
            stash = subprocess.run(
                ["git", "stash", "create"],
                cwd=REPO,
                stdout=subprocess.PIPE,
                stderr=log,
                text=True,
            )
            if stash.returncode:
                return stash.returncode
            work = stash.stdout.strip() or "HEAD"
            if status := run(
                "git", "merge-tree", "--write-tree", "--name-only", work, "@{upstream}"
            ):
                log.write("incoming commits conflict with uncommitted changes\n")
                return status
            return run("git", "rebase", "--autostash")

        status = pull() or run("mise", "run", "reconcile")
        if (
            status
            or not subprocess.run(
                ["git", "diff", "--quiet", "--", LOCK], cwd=REPO
            ).returncode
        ):
            return status
        return (
            run("git", "commit", "-m", "chore(neovim): update lazy-lock", "--", LOCK)
            or pull()
            or run("git", "push")
        )


def main() -> int:
    host = socket.gethostname().split(".", 1)[0]
    when = time.strftime("%Y-%m-%d %H:%M %Z")
    status = run_reconcile()
    prompt = PROMPT.format(
        host=host,
        status=status,
        when=when,
        log=LOG,
        lock=LOCK,
        tail="\n".join(LOG.read_text().splitlines()[-150:]),
    )
    sys.stdout.write(LOG.read_text())
    if not status:
        return 0

    # The host's own runner hosts the thread, so it outlives this process; amp prints its URL and exits.
    thread = subprocess.run(
        [
            "amp",
            "--executor",
            f"runner:{host}",
            "--runner-dir",
            str(REPO),
            "--title",
            f"{host} reconcile failed",
            "--no-archive-after-execute",
            "-x",
            prompt,
        ],
        cwd=REPO,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        text=True,
        check=True,
    ).stdout.strip()
    # A runner thread ignores --label, so the label goes on afterwards.
    subprocess.run(["amp", "threads", "label", thread, "reconcile-failure"], check=True)
    return status


if __name__ == "__main__":
    sys.exit(main())
