#!/usr/bin/env python3
"""Pull and reconcile this host; on failure, hand the log to an Amp agent to fix or escalate."""

import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import time

REPO = Path(__file__).resolve().parents[1]
LOG = Path.home() / ".local/state/ansiblonomicon/reconcile.log"
PROMPT = """The scheduled reconcile on {host} failed with exit status {status} at {when}.
The full log is {log}; its last lines are below.

Find the root cause. Then:
- If the fix belongs in this repository, make it, verify it by rerunning the failing capability (and its --check), commit it following the repository's conventions, pull --rebase, and push to main. Before committing, run `git status`; the tree was clean when the reconcile started. Never commit, stash, or discard changes you did not make.
- If the failure was transient, such as a network or upstream outage, rerun the failing capability to confirm it now passes and change nothing.
- If it needs Thurston, such as an expired login, a credential, a physical step, or a judgment call you should not make alone, do not guess.

Finish every run by sending Thurston one push notification with notify_user: what failed, what you did, and anything he must do.

```
{tail}
```
"""
DIRTY_PROMPT = """The scheduled reconcile on {host} did not run at {when}: its checkout {repo} has uncommitted changes, listed below. Other agents share this checkout, and pulling and reconciling over their unfinished work would deploy it.

Do not commit, stash, discard, or reconcile anything. Work out who left the changes: compare the files with recent Amp threads (find_thread) and the files' modification times. Then send Thurston one push notification with notify_user naming the files, the thread or person that most likely owns them, and that tonight's reconcile was skipped.

```
{status}
```
"""


def run_reconcile() -> int:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("w") as log:
        for command in (
            ["git", "-C", str(REPO), "pull", "--ff-only"],
            ["mise", "-C", str(REPO), "run", "reconcile"],
        ):
            log.write(f"$ {' '.join(command)}\n")
            log.flush()
            status = subprocess.run(
                command,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                # Syncing plugins would rewrite the symlinked lazy-lock.json and leave
                # the tree dirty, which skips the next night's run.
                env={**os.environ, "NEOVIM_MODE": "restore"},
            ).returncode
            if status:
                return status
    return 0


def main() -> int:
    host = socket.gethostname().split(".", 1)[0]
    when = time.strftime("%Y-%m-%d %H:%M %Z")
    dirty = subprocess.run(
        ["git", "-C", str(REPO), "status", "--porcelain"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.rstrip()
    if dirty:
        status = 1
        LOG.parent.mkdir(parents=True, exist_ok=True)
        LOG.write_text(f"skipped: {REPO} has uncommitted changes\n{dirty}\n")
        prompt = DIRTY_PROMPT.format(host=host, when=when, repo=REPO, status=dirty)
    else:
        status = run_reconcile()
        prompt = PROMPT.format(
            host=host,
            status=status,
            when=when,
            log=LOG,
            tail="\n".join(LOG.read_text().splitlines()[-150:]),
        )
    sys.stdout.write(LOG.read_text())
    if not status:
        return 0

    # Nobody answers confirmation prompts here, so this one run allows every command.
    settings_path = Path.home() / ".config/amp/settings.json"
    settings: dict[str, object] = (
        json.loads(settings_path.read_text()) if settings_path.exists() else {}
    )
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as handle:
        json.dump({**settings, "amp.dangerouslyAllowAll": True}, handle)
    try:
        subprocess.run(
            [
                "amp",
                "--settings-file",
                handle.name,
                "--title",
                f"{host} reconcile {'skipped' if dirty else 'failed'}",
                "--label",
                "reconcile-failure",
                "--no-archive-after-execute",
                "-x",
                prompt,
            ],
            cwd=REPO,
            stdin=subprocess.DEVNULL,
            check=False,
        )
    finally:
        os.unlink(handle.name)
    return status


if __name__ == "__main__":
    sys.exit(main())
