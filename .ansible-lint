# Ansible-lint configuration
# https://ansible.readthedocs.io/projects/lint/configuring/

# Strictest profile - requires AAP-certified content standards
profile: production

# Treat warnings as errors
strict: true

# Enable opt-in rules for maximum strictness
enable_list:
  - args                    # Validate module arguments (experimental)
  - empty-string-compare    # Don't compare to empty string
  - galaxy-version-incorrect # Collection version > 1.0.0
  - no-log-password         # Password should not be logged
  - no-prompting            # Disallow prompting
  - no-same-owner           # Don't preserve owner/group across hosts

# Paths to exclude from linting
exclude_paths:
  - .git/

# Skip specific rules if needed
skip_list: []

# Warn list - empty to treat everything as errors
warn_list: []

# Require FQCN for all modules, not just builtins
# (already enforced by production profile)

# Offline mode - don't download missing collections
offline: false

# Show rule IDs in output
verbosity: 1
