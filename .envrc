# Sync dependencies (creates .venv if needed)
uv sync --dev

# Activate venv the direnv way
export VIRTUAL_ENV="$PWD/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"

# Point Ansible to the correct config when running from repo root
export ANSIBLE_CONFIG="$PWD/ansible/ansible.cfg"
export SUDO_ASKPASS="$PWD/ansible/sudo-askpass.sh"

# Override any global core.hooksPath so pre-commit hooks run from .git/hooks
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=core.hooksPath
export GIT_CONFIG_VALUE_0=.git/hooks

if [ -d .git ] && [ ! -f .git/hooks/pre-commit ]; then
  # pre-commit refuses to install when core.hooksPath is set at any scope;
  # temporarily unset the global value, install, then restore it
  # (GIT_CONFIG_COUNT=0 suppresses our own env override during this block)
  _saved_hooks_path=$(GIT_CONFIG_COUNT=0 git config --global core.hooksPath 2>/dev/null)
  GIT_CONFIG_COUNT=0 git config --global --unset core.hooksPath 2>/dev/null
  GIT_CONFIG_COUNT=0 uv run pre-commit install --install-hooks
  if [ -n "$_saved_hooks_path" ]; then
    GIT_CONFIG_COUNT=0 git config --global core.hooksPath "$_saved_hooks_path"
  fi
fi

# Install pi extension dev dependencies (for IDE type checking)
pi_ext_dir="chezmoi/private_dot_pi/agent/extensions"
if [ -f "$pi_ext_dir/package.json" ]; then
  if [ ! -d "$pi_ext_dir/node_modules" ] || [ "$pi_ext_dir/package.json" -nt "$pi_ext_dir/node_modules" ]; then
    echo "Installing pi extension dependencies..."
    (cd "$pi_ext_dir" && npm install --silent)
  fi
fi

# Watch .secrets.jsonc for changes - direnv will reload when it changes
watch_file .secrets.jsonc

# Initialize secrets cache if missing or stale
if [ -f .secrets.jsonc ]; then
  if [ ! -f .env ] || [ .secrets.jsonc -nt .env ]; then
    echo "Secrets cache needs update..."
    uv run scripts/init-secrets.py
  fi
fi

# Source cached secrets if available
if [ -f .env ]; then
  dotenv .env
fi
