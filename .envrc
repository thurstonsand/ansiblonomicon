# Sync dependencies (creates .venv if needed)
uv sync --dev

# Activate venv the direnv way
export VIRTUAL_ENV="$PWD/.venv"
export PATH="$VIRTUAL_ENV/bin:$PATH"

# Install pre-commit hooks (only if not already installed)
if [ -d .git ] && [ ! -f .git/hooks/pre-commit ]; then
  uv run pre-commit install --install-hooks
fi

# Watch .secrets.jsonc for changes - direnv will reload when it changes
watch_file .secrets.jsonc

# Initialize secrets cache if missing or stale
if [ -f .secrets.jsonc ]; then
  if [ ! -f .env.secrets ] || [ .secrets.jsonc -nt .env.secrets ]; then
    echo "Secrets cache needs update..."
    uv run scripts/init-secrets.py
  fi
fi

# Source cached secrets if available
if [ -f .env.secrets ]; then
  dotenv .env.secrets
fi
