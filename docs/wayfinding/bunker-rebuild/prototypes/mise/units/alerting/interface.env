# The alerting contract. Imported with `env._.file` by every unit whose units
# and scripts are written against hc-run, storage-alert and the credential
# paths — the meta/main.yml dependency, minus the ordering.
#
# Dotenv holds strings only. Nothing here can be wrapped in the
# `env.X | default(...)` form that lets a host fact win, so an exported default
# is a fixed default: overriding one means editing this file or exporting the
# variable into the process before mise starts.
ALERTING_BIN_DIR=/usr/local/bin
ALERTING_STATE_DIR=/etc/alerting
ALERTING_HEALTHCHECKS_TIMEZONE=America/New_York
