#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  printf '\n==> %s\n' "$1"
}

step "Install mise"
if ! command -v mise >/dev/null 2>&1; then
  curl -fsSL https://mise.run | sh
fi

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

profile_marker="# ansiblonomicon orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# ansiblonomicon orb toolchain
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
EOF
fi

step "Install toolchains"
mise --no-env use --global --yes \
  python@3.14 \
  node@lts \
  go@1.26 \
  golangci-lint@latest \
  1password-cli@latest \
  hk@latest \
  opentofu@latest \
  stylua@latest \
  uv@latest

python_bin="$(mise --no-env which python)"
node_bin_dir="$(dirname "$(mise --no-env which node)")"
uv_bin="$(mise --no-env which uv)"
export PATH="$node_bin_dir:$PATH"

if ! command -v wrangler >/dev/null 2>&1 || [[ "$(wrangler --version)" != 4.* ]]; then
  "$node_bin_dir/npm" install --global --prefix "$HOME/.local" --no-audit --no-fund wrangler@4
fi

step "Sync Python dependencies"
UV_PYTHON="$python_bin" "$uv_bin" sync --locked --dev

step "Sync TypeScript dependencies"
mapfile -t package_locks < <(
  find \
    chezmoi/private_dot_pi/agent/extensions \
    chezmoi/private_dot_pi/agent/permissions \
    chezmoi/dot_config/private_amp/plugins \
    chezmoi/dot_local/lib/session-recovery \
    -name package-lock.json \
    -not -path '*/node_modules/*' \
    -print | sort
)

for package_lock in "${package_locks[@]}"; do
  package_dir="${package_lock%/package-lock.json}"
  printf '    npm ci: %s\n' "$package_dir"
  "$node_bin_dir/npm" --prefix "$package_dir" ci --no-audit --no-fund --silent
done

step "Install Ansible collections"
"$repo_root/.venv/bin/ansible-galaxy" collection install -r ansible/requirements.yml

mise --no-env trust --quiet
